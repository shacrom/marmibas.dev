---
/**
 * /servicios — services mosaic (ES) — S2, `odd/tasks/services-mosaic.md`.
 *
 * Single page replacing the former services index + its 7 detail-page
 * landings: a 4-column mosaic of the 7 services with a full-width drawer
 * per module (owner-chosen "E4 cajón" interaction). All logic/markup lives
 * in `ServicesMosaic.astro` (español, único idioma publicado — ver
 * `odd/tasks/site-cleanup.md` C2); this file only wires SEO.
 *
 * Title/description kept verbatim from the pre-mosaic index page. JSON-LD:
 * `SeoHead.astro` emits an `ItemList` of `Service` items for this exact
 * pathname (`isServicesIndex`) — the structured-data replacement for the
 * `Service` schema the 7 removed detail pages used to emit individually.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import ServicesMosaic from '../../components/services/ServicesMosaic.astro';

const lang = 'es' as const;
---

<BaseLayout
  title="Servicios — Software a medida para empresas | marmibas.dev"
  description="Tiendas online, sistemas de gestión, apps móviles, automatizaciones, webs corporativas e integraciones a medida. Software pensado para PYMEs y emprendedores."
>
  <ServicesMosaic lang={lang} />
</BaseLayout>
