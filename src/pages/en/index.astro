---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroPane from '../../components/home/HeroPane.astro';
import ServicesPane from '../../components/home/ServicesPane.astro';
import DemoPane from '../../components/home/DemoPane.astro';
import CasesPane from '../../components/home/CasesPane.astro';
import ProcessPane from '../../components/home/ProcessPane.astro';
import AboutPane from '../../components/home/AboutPane.astro';
import FaqPane from '../../components/home/FaqPane.astro';
import { getFaqs } from '../../lib/faqs';

const lang = 'en' as const;

// FAQs feed both the visual accordion (FaqPane) and the Schema.org FAQPage
// JSON-LD in `<head>`. Same source of truth guarantees the two stay aligned.
const faqs = getFaqs(lang).map((faq) => ({
  question: faq.question,
  answer: faq.answer,
}));
---

<BaseLayout
  title="Custom software developer for businesses | marmibas.dev"
  description="Web applications, online stores and custom management systems. I help businesses and entrepreneurs digitize their daily operations."
  noindex
  faqs={faqs}
>
  <HeroPane lang={lang} />
  <ServicesPane lang={lang} />
  <DemoPane lang={lang} />
  <CasesPane lang={lang} />
  <ProcessPane lang={lang} />
  <AboutPane lang={lang} />
  <FaqPane lang={lang} />
</BaseLayout>
