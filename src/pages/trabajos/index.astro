---
/**
 * /trabajos — índice de trabajos (ES) — T-34.
 *
 * Lista TODOS los case studies + projects (mezclados) ordenados por status
 * priority desc, year desc, order asc. Filtros por status con progressive
 * enhancement (form GET + JS client-side, sin recarga).
 *
 * Toda la lógica vive en `WorkIndex.astro` para compartir 1:1 con la versión
 * EN bajo `/en/work` (mismo componente, distinto `lang`).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkIndex from '../../components/work/WorkIndex.astro';

const lang = 'es' as const;
---

<BaseLayout
  title="Proyectos de software a medida para empresas | marmibas.dev"
  description="Casos de éxito y proyectos en desarrollo: SaaS, e-commerce, herramientas internas. Software hecho para hacer crecer negocios reales."
>
  <WorkIndex lang={lang} />
</BaseLayout>
