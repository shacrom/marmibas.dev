---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroPane from '../components/home/HeroPane.astro';
import ServicesPane from '../components/home/ServicesPane.astro';
import DemoPane from '../components/home/DemoPane.astro';
import CasesPane from '../components/home/CasesPane.astro';
import ProcessPane from '../components/home/ProcessPane.astro';
import AboutPane from '../components/home/AboutPane.astro';
import FaqPane from '../components/home/FaqPane.astro';
import { getFaqs } from '../lib/faqs';

const lang = 'es' as const;

// Las FAQs se duplican intencionalmente: FaqPane las renderiza para el
// usuario y el layout las pasa a `<SeoHead>` para inyectar el Schema FAQPage
// en `<head>`. Compartir la fuente de verdad evita drift entre ambos.
const faqs = getFaqs(lang).map((faq) => ({
  question: faq.question,
  answer: faq.answer,
}));
---

<BaseLayout
  title="Desarrollador de software a medida para empresas | marmibas.dev"
  description="Diseño y desarrollo de aplicaciones web, tiendas online y sistemas de gestión a medida. Ayudo a empresas y emprendedores a digitalizar su trabajo."
  faqs={faqs}
>
  <HeroPane lang={lang} />
  <ServicesPane lang={lang} />
  <DemoPane lang={lang} />
  <CasesPane lang={lang} />
  <ProcessPane lang={lang} />
  <AboutPane lang={lang} />
  <FaqPane lang={lang} />
</BaseLayout>
