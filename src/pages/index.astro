---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import FeaturedProjects from '../components/home/FeaturedProjects.astro';
import AboutSection from '../components/home/AboutSection.astro';
import ServicesSection from '../components/home/ServicesSection.astro';
import ShowcaseSection from '../components/home/ShowcaseSection.astro';
import ProcessSection from '../components/home/ProcessSection.astro';
import FAQSection from '../components/home/FAQSection.astro';
import MidCta from '../components/home/MidCta.astro';
import DecorativeLine from '../components/ui/DecorativeLine.astro';
import { getFaqs } from '../lib/faqs';
import { getRoutePath } from '../i18n/helpers';

const lang = 'es' as const;

// Las FAQs se duplican intencionalmente: el componente las renderiza para el
// usuario y el layout las pasa a `<SeoHead>` para inyectar el Schema FAQPage
// en `<head>`. Compartir la fuente de verdad evita drift entre ambos.
const faqs = getFaqs(lang).map((faq) => ({
  question: faq.question,
  answer: faq.answer,
}));

// MidCta único tras los servicios: un solo recordatorio de contacto entre
// secciones; el hero (arriba) ya concentra la conversión primaria.
// Showcase va justo después de Services porque demuestra los servicios:
// orden narrativo "qué hago → así se ve → contacta → pruebas reales".
const contactHref = getRoutePath('contact', lang);
const midCtaText = '¿Tienes una idea o un problema que quieres resolver?';
const midCtaLink = 'Escríbeme';
---

<BaseLayout
  title="Desarrollador de software a medida para empresas | marmibas.dev"
  description="Diseño y desarrollo de aplicaciones web, tiendas online y sistemas de gestión a medida. Ayudo a empresas y emprendedores a digitalizar su trabajo."
  noindex
  faqs={faqs}
>
  <Hero lang={lang} />
  <DecorativeLine />
  <ServicesSection lang={lang} />
  <ShowcaseSection lang={lang} />
  <MidCta text={midCtaText} cta={midCtaLink} href={contactHref} lang={lang} />
  <FeaturedProjects lang={lang} />
  <ProcessSection lang={lang} />
  <AboutSection lang={lang} />
  <DecorativeLine />
  <FAQSection lang={lang} />
</BaseLayout>
