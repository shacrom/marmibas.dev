---
/**
 * /experiencia — timeline cronológico de experiencia profesional (ES) — T-35.
 *
 * Carga `getCollection('experience', e => e.data.lang === 'es')`, ordena por
 * `order` ascendente (1 = más reciente) y renderiza cada entrada como una card
 * compacta: stack como TechBadges arriba, período, título (company · role) y
 * body MD renderizado dentro de Prose. Cada entry entra con
 * `motion-reveal-on-scroll` (via `<Reveal as="li">`) con un stagger corto
 * (60ms por índice, tope 240ms) para que el timeline se sienta dinámico sin
 * romper el presupuesto de motion de DESIGN.md §7.
 *
 * Sección de educación al final, hardcoded en `ui.ts` (no es content
 * collection): Grado en Ingeniería Informática · ETSE Universidad de Valencia
 * · 2018 — 2023.
 *
 * Visual:
 *   - Desktop ≥768px: línea vertical (border-left 1px sólido) que conecta los
 *     entries del timeline. Cada card tiene un dot absolute en el border-left.
 *   - Mobile <768px: sin línea ni dot — cards apiladas con gap normal.
 *
 * Source of truth:
 *   - TASKS.md T-35 (la spec del timeline + paridad parcial EN).
 *   - DESIGN.md §5 (rhythm) + §9 (container widths).
 *   - content.config.ts → `experience` schema.
 */

import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechBadge from '../../components/ui/TechBadge.astro';
import Prose from '../../components/ui/Prose.astro';
import Reveal from '../../components/ui/Reveal.astro';
import { useTranslations, getRoutePath } from '../../i18n/helpers';

type ExperienceEntry = CollectionEntry<'experience'>;

const lang = 'es' as const;
const t = useTranslations(lang);
const contactHref = getRoutePath('contact', lang);

// Carga + orden por `order` ascendente (1 = más reciente). Las entries sin
// `order` definido caen al final (Number.POSITIVE_INFINITY como fallback).
const entries = await getCollection(
  'experience',
  (entry: ExperienceEntry) => entry.data.lang === lang,
);

const sorted = [...entries].sort(
  (a, b) =>
    (a.data.order ?? Number.POSITIVE_INFINITY) -
    (b.data.order ?? Number.POSITIVE_INFINITY),
);

// Pre-renderiza los bodies MD para iterarlos en el template.
const items = await Promise.all(
  sorted.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  }),
);
---

<BaseLayout
  title="Experiencia profesional — Ingeniero informático | marmibas.dev"
  description="5 años desarrollando software para grandes empresas y consultoras. Capgemini, Cleverpy, Devoltec. Hoy trabajo de forma independiente."
  noindex
>
  <section class="experience" aria-labelledby="experience-title">
    <header class="experience__header">
      <p class="experience__eyebrow font-mono">{t('nav.experience')}</p>
      <h1 id="experience-title" class="experience__title font-display">
        {t('experience.heading')}
      </h1>
      <p class="experience__tagline">{t('experience.tagline')}</p>
    </header>

    <ol class="timeline" role="list">
      {
        items.map(({ entry, Content }, index) => (
          <Reveal as="li" class="timeline__item" delay={Math.min(index * 60, 240)}>
            <span class="timeline__dot" aria-hidden="true" />
            <a
              class="timeline__card"
              href={entry.data.companyUrl}
              target="_blank"
              rel="noreferrer"
              aria-label={`Abrir web oficial de ${entry.data.company}`}
            >
              {entry.data.stack && entry.data.stack.length > 0 && (
                <ul class="timeline__stack" role="list">
                  {entry.data.stack.map((tech: string) => (
                    <li>
                      <TechBadge label={tech} variant="subtle" />
                    </li>
                  ))}
                </ul>
              )}

              <div class="timeline__head">
                {entry.data.logo && (
                  <span class="timeline__logos">
                    <img
                      class:list={[
                        'timeline__logo',
                        // The Marmibas wordmark is near-white: it needs the dark
                        // wide pill instead of the light square one.
                        entry.data.logo === '/marmibas-logo.png' && 'timeline__logo--wordmark',
                      ]}
                      src={entry.data.logo}
                      alt={`Logo de ${entry.data.company}`}
                      width="48"
                      height="48"
                      loading="lazy"
                    />
                    {entry.data.partnerLogo && (
                      <>
                        <span class="timeline__logo-x" aria-hidden="true">
                          ×
                        </span>
                        <img
                          class="timeline__logo timeline__logo--wide"
                          src={entry.data.partnerLogo}
                          alt="Logo del socio tecnológico"
                          width="48"
                          height="48"
                          loading="lazy"
                        />
                      </>
                    )}
                  </span>
                )}
                <div class="timeline__head-text">
                  <p class="timeline__period font-mono">{entry.data.period}</p>

                  <h2 class="timeline__heading font-display">
                    {
                      /* The wordmark logo already reads "Marmibas" — repeating
                         the company name next to it would be redundant. */
                      entry.data.logo !== '/marmibas-logo.png' && (
                        <>
                          <span class="timeline__company">{entry.data.company}</span>
                          <span class="timeline__separator" aria-hidden="true">
                            ·
                          </span>
                        </>
                      )
                    }
                    <span class="timeline__role">{entry.data.role}</span>
                  </h2>
                </div>
              </div>

              <Prose class="timeline__body">
                <Content />
              </Prose>
            </a>
          </Reveal>
        ))
      }
    </ol>

    <section class="education" aria-labelledby="education-title">
      <h2 id="education-title" class="education__title font-display">
        {t('experience.education.heading')}
      </h2>
      <div class="education__card">
        <p class="education__degree">{t('experience.education.degree')}</p>
        <p class="education__school">{t('experience.education.school')}</p>
        <p class="education__years font-mono">{t('experience.education.years')}</p>
      </div>
    </section>

    <aside class="experience__cta" aria-label="Contacto">
      <p class="experience__cta-text font-display">
        ¿Tu empresa busca alguien con experiencia en estos sectores?
        <a class="experience__cta-link" href={contactHref}>Hablemos <span aria-hidden="true">→</span></a>
      </p>
    </aside>
  </section>
</BaseLayout>

<style>
  /* --- Hero / header ----------------------------------------------------- */
  .experience {
    position: relative;
    max-width: 1080px;
    margin-inline: auto;
    padding-block: clamp(48px, 8vw, 96px);
    padding-inline: clamp(20px, 5vw, 48px);
    isolation: isolate;
  }

  .experience__header {
    max-width: 720px;
    margin-inline: auto;
    text-align: center;
    margin-bottom: 32px;
  }

  .experience__eyebrow {
    color: var(--accent-400);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    margin-bottom: 12px;
  }

  .experience__title {
    font-size: clamp(2rem, 5vw + 1rem, 3.25rem);
    line-height: 1.05;
    color: var(--text-0);
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }

  .experience__tagline {
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--text-2);
    text-wrap: pretty;
    margin: 0;
  }

  /* --- Timeline ---------------------------------------------------------- */
  .timeline {
    list-style: none;
    margin: 0 0 64px;
    padding: 0;
    max-width: 760px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .timeline__item {
    position: relative;
  }

  /* Dot + línea vertical: solo en ≥768px (desktop / tablet ancho). En mobile
     omitimos para no robar espacio horizontal a la prosa. */
  @media (min-width: 768px) {
    .timeline {
      padding-left: 32px;
      border-left: 1px solid var(--color-border);
      gap: 40px;
    }

    .timeline__item {
      padding-left: 8px;
    }

    .timeline__dot {
      position: absolute;
      left: -38px;
      top: 28px;
      width: 12px;
      height: 12px;
      border-radius: var(--radius-full);
      background: var(--bg-0);
      border: 2px solid var(--color-accent-400);
      box-shadow: 0 0 0 4px var(--bg-0);
    }
  }

  /* En mobile el dot vive en el DOM pero no es visible. */
  @media (max-width: 767.98px) {
    .timeline__dot {
      display: none;
    }
  }

  /* --- Card -------------------------------------------------------------- */
  .timeline__card {
    color: inherit;
    text-decoration: none;
    background: var(--bg-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: clamp(16px, 2.4vw, 22px);
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition:
      border-color var(--motion-fast) var(--motion-ease-out),
      transform var(--motion-base) var(--motion-ease-out),
      box-shadow var(--motion-base) var(--motion-ease-out);
  }

  .timeline__card:hover,
  .timeline__card:focus-visible,
  .timeline__card:focus-within {
    border-color: var(--accent-400);
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
  }

  .timeline__card:focus-visible {
    outline: 2px solid var(--accent-400);
    outline-offset: 4px;
  }

  .timeline__head {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .timeline__head-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  /* Los logos oficiales (azul Capgemini, rosa Cleverpy) están pensados para
     fondos claros; la pastilla clara preserva sus colores de marca sobre el
     tema oscuro sin recolorearlos (DESIGN.md: assets de marca intactos). */
  .timeline__logo {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    object-fit: contain;
    padding: 6px;
    border-radius: var(--radius-sm);
    background: var(--text-0);
    border: 1px solid var(--color-border);
  }

  /* White wordmark (Marmibas): dark wide pill so it stays visible. */
  .timeline__logo--wordmark {
    width: auto;
    max-width: 140px;
    padding: 12px 14px;
    background: var(--bg-0);
  }

  /* Wide partner wordmark on the standard light pill. */
  .timeline__logo--wide {
    width: auto;
    max-width: 140px;
    padding: 8px 12px;
  }

  .timeline__logos {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .timeline__logo-x {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .timeline__period {
    font-size: var(--text-xs);
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    margin: 0;
  }

  .timeline__heading {
    font-size: clamp(1.25rem, 2vw + 0.75rem, 1.5rem);
    line-height: 1.2;
    color: var(--text-0);
    margin: 0;
    font-weight: 600;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
  }

  .timeline__company {
    color: var(--text-0);
  }

  .timeline__separator {
    color: var(--text-3);
    font-weight: 400;
  }

  .timeline__role {
    color: var(--text-2);
    font-weight: 500;
  }

  .timeline__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* La prosa interna del MDX/MD: el wrapper Prose ya aplica `.prose`.
     Aquí solo ajustamos el ritmo vertical contra los bloques superiores. */
  .timeline__body {
    margin-top: 4px;
  }

  /* --- Education --------------------------------------------------------- */
  .education {
    max-width: 760px;
    margin-inline: auto;
    padding-top: 48px;
    border-top: 1px solid var(--color-border);
  }

  .education__title {
    font-size: clamp(1.25rem, 2vw + 0.75rem, 1.625rem);
    color: var(--text-0);
    margin: 0 0 20px;
    font-weight: 600;
  }

  .education__card {
    background: var(--bg-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .education__degree {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--text-0);
    margin: 0;
  }

  .education__school {
    font-size: var(--text-base);
    color: var(--text-2);
    margin: 0;
  }

  .education__years {
    font-size: var(--text-xs);
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    margin-top: 4px;
  }

  /* --- CTA al cierre del timeline --------------------------------------- */
  /* Cierra la página invitando a contacto sin recurrir a un panel pleno
     tipo LeadCTA — en /experiencia el visitante ya está leyendo prosa,
     un pasaje fino con link inline mantiene el ritmo editorial. */
  .experience__cta {
    max-width: 720px;
    margin-inline: auto;
    margin-top: 64px;
    padding-block: clamp(2.5rem, 5vw, 4rem);
    padding-inline: 0;
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .experience__cta-text {
    margin: 0;
    color: var(--text-1);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: var(--leading-snug);
    text-wrap: balance;
  }

  @media (min-width: 768px) {
    .experience__cta-text {
      font-size: var(--text-2xl);
    }
  }

  .experience__cta-link {
    color: var(--accent-400);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition:
      color var(--motion-fast) var(--motion-ease-out),
      border-color var(--motion-fast) var(--motion-ease-out);
  }

  .experience__cta-link:hover,
  .experience__cta-link:focus-visible {
    color: var(--accent-300);
    border-bottom-color: var(--accent-400);
  }
</style>
