---
/**
 * /experiencia — trayectoria profesional (ES) — T-35.
 *
 * Apertura de página (owner request, 2026-09-25): dos lock-up panes justo
 * después del header — `<FactorySoftwarePane>`
 * (`src/components/work/FactorySoftwarePane.astro`, "Software para
 * fábricas", Marmibas × Plazasys) seguida de `<VoxyePane>`
 * (`src/components/work/VoxyePane.astro`, "Software a medida": solo el
 * logo de Marmibas, con Voxye como fila de proyecto).
 *
 * Roles pasados (P5, owner follow-up 2026-09-25): cada entry de la
 * `experience` collection (Devoltec, Capgemini, Cleverpy) se renderiza como
 * su propio terminal pane en vez de una card de timeline — mismo componente
 * `LockupPane.astro` que las dos panes de arriba, con su logo de empresa
 * (enlazando a `companyUrl`) en vez del de Marmibas, `role` como subheading,
 * `stack` como badges y el body MD (párrafo + checklist) en el slot por
 * defecto. El antiguo entry "Marmibas" del timeline
 * (`src/content/experience/es/marmibas.md`) ya se había eliminado en P2: su
 * copy vive en `VoxyePane`, así que estas tres panes son toda la
 * `experience` collection restante.
 *
 * Carga `getCollection('experience', e => e.data.lang === 'es')`, ordena por
 * `order` ascendente (1 = más reciente) y pre-renderiza cada body MD una vez
 * (`items`) para iterarlo en el template. El `path`/`promptCommand`/
 * `headingId` de cada pane se derivan del `company` (primera palabra en
 * minúsculas, p. ej. "Cleverpy Machine Learning" → `cleverpy`) — ver el
 * `.map()` más abajo.
 *
 * Sección de educación al final, hardcoded en `ui.ts` (no es content
 * collection): Grado en Ingeniería Informática · ETSE Universidad de Valencia
 * · 2018 — 2023.
 *
 * Source of truth:
 *   - TASKS.md T-35 (la spec original del timeline + paridad parcial EN).
 *   - DESIGN.md §5 (rhythm) + §9 (container widths).
 *   - content.config.ts → `experience` schema.
 */

import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LockupPane from '../../components/work/LockupPane.astro';
import VoxyePane from '../../components/work/VoxyePane.astro';
import FactorySoftwarePane from '../../components/work/FactorySoftwarePane.astro';
import { useTranslations, getRoutePath } from '../../i18n/helpers';

type ExperienceEntry = CollectionEntry<'experience'>;

const lang = 'es' as const;
const t = useTranslations(lang);
const contactHref = getRoutePath('contact', lang);

// Carga + orden por `order` ascendente (1 = más reciente). Las entries sin
// `order` definido caen al final (Number.POSITIVE_INFINITY como fallback).
const entries = await getCollection(
  'experience',
  (entry: ExperienceEntry) => entry.data.lang === lang
);

const sorted = [...entries].sort(
  (a, b) => (a.data.order ?? Number.POSITIVE_INFINITY) - (b.data.order ?? Number.POSITIVE_INFINITY)
);

// Pre-renderiza los bodies MD para iterarlos en el template.
const items = await Promise.all(
  sorted.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);
---

<BaseLayout
  title="Experiencia profesional — Ingeniero informático | marmibas.dev"
  description="5 años desarrollando software para grandes empresas y consultoras. Capgemini, Cleverpy, Devoltec. Hoy trabajo de forma independiente."
>
  <section class="experience" aria-labelledby="experience-title">
    <header class="experience__header">
      <p class="experience__eyebrow font-mono">{t('nav.experience')}</p>
      <h1 id="experience-title" class="experience__title font-display">
        {t('experience.heading')}
      </h1>
      <p class="experience__tagline">{t('experience.tagline')}</p>
    </header>

    <FactorySoftwarePane lang={lang} />
    <VoxyePane lang={lang} delayOffset={300} topSpacingDesktop={48} topSpacingMobile={32} />

    {
      items.map(({ entry, Content }) => {
        const { company, companyUrl, role, period, stack, logo } = entry.data;

        // Deterministic per-company slug for the pane bar path/prompt/
        // heading id — first word lowercased, so a multi-word company name
        // ("Cleverpy Machine Learning") still gets a short, readable slug
        // ("cleverpy"). `?? company` only satisfies `noUncheckedIndexedAccess`
        // (`split(' ')` on a non-empty `company` always yields a first word).
        const slug = (company.split(' ')[0] ?? company).toLowerCase();

        const logoProp = logo
          ? { src: logo, alt: `Logo de ${company}`, variant: 'square' as const, href: companyUrl }
          : undefined;

        return (
          <LockupPane
            path={slug}
            promptCommand={`ls ${slug}/`}
            headingId={`exp-${slug}-heading`}
            eyebrow={period}
            heading={company}
            subheading={role}
            logo={logoProp}
            tags={stack}
            topSpacingDesktop={48}
            topSpacingMobile={32}
          >
            <Content />
          </LockupPane>
        );
      })
    }

    <section class="education" aria-labelledby="education-title">
      <h2 id="education-title" class="education__title font-display">
        {t('experience.education.heading')}
      </h2>
      <div class="education__card">
        <p class="education__degree">{t('experience.education.degree')}</p>
        <p class="education__school">{t('experience.education.school')}</p>
        <p class="education__years font-mono">{t('experience.education.years')}</p>
      </div>
    </section>

    <aside class="experience__cta" aria-label="Contacto">
      <p class="experience__cta-text font-display">
        ¿Tu empresa busca alguien con experiencia en estos sectores?
        <a class="experience__cta-link" href={contactHref}
          >Hablemos <span aria-hidden="true">→</span></a
        >
      </p>
    </aside>
  </section>
</BaseLayout>

<style>
  /* --- Hero / header ----------------------------------------------------- */
  .experience {
    position: relative;
    max-width: 1080px;
    margin-inline: auto;
    padding-block: clamp(48px, 8vw, 96px);
    padding-inline: clamp(20px, 5vw, 48px);
    isolation: isolate;
  }

  .experience__header {
    max-width: 720px;
    margin-inline: auto;
    text-align: center;
    margin-bottom: 32px;
  }

  .experience__eyebrow {
    color: var(--accent-400);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    margin-bottom: 12px;
  }

  .experience__title {
    font-size: clamp(2rem, 5vw + 1rem, 3.25rem);
    line-height: 1.05;
    color: var(--text-0);
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }

  .experience__tagline {
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--text-2);
    text-wrap: pretty;
    margin: 0;
  }

  /* --- Education --------------------------------------------------------- */
  .education {
    max-width: 760px;
    margin-inline: auto;
    padding-top: 48px;
    border-top: 1px solid var(--color-border);
  }

  .education__title {
    font-size: clamp(1.25rem, 2vw + 0.75rem, 1.625rem);
    color: var(--text-0);
    margin: 0 0 20px;
    font-weight: 600;
  }

  .education__card {
    background: var(--bg-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .education__degree {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--text-0);
    margin: 0;
  }

  .education__school {
    font-size: var(--text-base);
    color: var(--text-2);
    margin: 0;
  }

  .education__years {
    font-size: var(--text-xs);
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    margin-top: 4px;
  }

  /* --- CTA de cierre ------------------------------------------------------ */
  /* Cierra la página invitando a contacto sin recurrir a un panel pleno
     tipo LeadCTA — en /experiencia el visitante ya está leyendo prosa,
     un pasaje fino con link inline mantiene el ritmo editorial. */
  .experience__cta {
    max-width: 720px;
    margin-inline: auto;
    margin-top: 64px;
    padding-block: clamp(2.5rem, 5vw, 4rem);
    padding-inline: 0;
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .experience__cta-text {
    margin: 0;
    color: var(--text-1);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: var(--leading-snug);
    text-wrap: balance;
  }

  @media (min-width: 768px) {
    .experience__cta-text {
      font-size: var(--text-2xl);
    }
  }

  .experience__cta-link {
    color: var(--accent-400);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition:
      color var(--motion-fast) var(--motion-ease-out),
      border-color var(--motion-fast) var(--motion-ease-out);
  }

  .experience__cta-link:hover,
  .experience__cta-link:focus-visible {
    color: var(--accent-300);
    border-bottom-color: var(--accent-400);
  }
</style>
