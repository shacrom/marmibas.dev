---
/**
 * CaseStudyLayout.astro — page-level layout for `case-studies/**` MDX, in
 * the "B3 · Terminal" language (W2 terminal redesign —
 * `odd/tasks/work-terminal.md`).
 *
 * Rendered as the wrapper `src/pages/case-studies/[slug].astro` builds
 * around each case study's rendered MDX. Composition tree:
 *
 *   <BaseLayout title description ogImage type="article">
 *     <div class="case-study">
 *       breadcrumb ("← cd ../" back to /trabajos)
 *       <CaseStudyHero ... />                 ← W2, TerminalPane [1/2]
 *       <TerminalPane index="2/2">            ← body: the MDX content
 *         <Prompt />
 *         <div class="case-body"><slot /></div>
 *       </TerminalPane>
 *       <TerminalPane> CTA pane </TerminalPane>
 *       <nav> "cd ../" + "cd ../<next-slug>" cards </nav>
 *     </div>
 *   </BaseLayout>
 *
 * Body pane — single pane vs. per-`##`-section panes (documented tradeoff,
 * see the task report): the approved mockup draws FOUR separate panes
 * (hero, "el problema", "la solución", "resultados"), each with its own
 * pane bar and `cat <file>.md` prompt. Splitting `<slot />`'s rendered MDX
 * output by heading would need either a remark/rehype plugin (new build
 * dependency + astro.config surface, unproven against three real files) or
 * restructuring case study content out of MDX into per-section frontmatter
 * strings (loses inline-markdown links in the prose, touches every .mdx
 * file's data shape). Both add real risk for a purely visual grouping.
 * Chosen instead: ONE `~/trabajos/<slug>/README.md` body pane holding the
 * whole rendered `<Content />` (the task brief's own explicitly "acceptable"
 * fallback) with `##`-derived `<h2>`s styled to still read as
 * "## Section title" via a CSS `::before` (`.case-body :global(h2)`) —
 * `## ` is decorative, not real DOM text, so a screen reader never hears
 * it announced as a heading number. This keeps the MDX content the single
 * source of truth (task constraint) with zero new parsing/build risk.
 * `<BeforeAfter>` (already MDX-embedded per file) renders inside this same
 * pane, restyled to the mockup's own "diff antes.txt despues.txt" block —
 * see that component's own docblock.
 *
 * TOC removed — the mockup has no anchor sidebar for a single-pane body,
 * so `TableOfContents.astro` usage (and the `headings` prop it needed) is
 * dropped here; the file itself is left in the tree since deleting it
 * wasn't asked for (same call as `ProjectCard.astro` in W1 — see that
 * task's report).
 *
 * `next` sibling — see `src/pages/case-studies/[slug].astro`'s own
 * docblock for why this is now `order`-based "next in /trabajos" instead
 * of the old year-based prev/next pair. The LEFT "cd ../" card is constant
 * (always back to `/trabajos`) and needs no data.
 *
 * CTA pane copy — the task brief asks for "the case's closing call to
 * action if it exists in content, else the generic 'Hablemos' CTA already
 * used on the site". The real content's own closing sentence is prose
 * embedded in the last MDX paragraph (no structured field to lift it from
 * without fragile text-parsing), so this renders the SITE'S established
 * generic CTA instead — the exact copy `Footer.astro` already uses
 * (`capture.heading`/`capture.sub`/`t('cta.contact')`), duplicated here the
 * same way `WorkIndex.astro` (W1) duplicated `CasesPane.astro`'s own CTA
 * copy: no shared copy module exists for this, every terminal pane owns
 * its local copy per the established convention.
 *
 * Source of truth:
 *   - `odd/tasks/work-terminal.md` W2.
 *   - `CasoVoxye.dc.html` (drawn for Voxye, built to work for all three).
 *   - content.config.ts → `case-studies` schema (frontmatter shape).
 *
 * `ImageMetadata` import — trivial fix for this file's own pre-existing
 * `no-undef` lint error (the global ambient type `astro check`/`tsc`
 * already resolve, but ESLint's parser does not without an explicit
 * import); `ProjectDetailLayout.astro` has the identical baseline issue
 * but is untouched by this task, so it's left as-is there.
 */

import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import CaseStudyHero from '../components/ui/CaseStudyHero.astro';
import TerminalPane from '../components/terminal/TerminalPane.astro';
import Prompt from '../components/terminal/Prompt.astro';
import TerminalButton from '../components/terminal/TerminalButton.astro';
import { getLangFromUrl, getRoutePath, useTranslations } from '../i18n/helpers';
import type { Language } from '../i18n/ui';

/**
 * Frontmatter slice this layout reads. Mirrors the `case-studies` schema in
 * `src/content.config.ts`. Optional fields stay optional so MDX validation
 * is the single source of truth.
 */
interface CaseStudyFrontmatter {
  title: string;
  description: string;
  tagline: string;
  client: string;
  attribution?: string;
  logo?: string;
  externalUrl?: string;
  year: number;
  role: string;
  stack: string[];
  status: 'success';
  ogImage?: ImageMetadata;
  heroImage?: ImageMetadata;
}

interface SiblingRef {
  url: string;
  title: string;
}

interface Props {
  /** Frontmatter from the rendered MDX (Astro injects it). */
  frontmatter: CaseStudyFrontmatter;
  /** File-basename slug (`voxye`) — drives the hero/body pane paths+prompts. */
  slug: string;
  /** Active language. Optional — falls back to URL detection. */
  lang?: Language;
  /** Next case study in /trabajos's own display order. Null on the last one. */
  next?: SiblingRef | null;
}

const { frontmatter, slug, lang: langProp, next = null } = Astro.props;

// Derive language from URL if the page didn't pass an explicit prop
// (always resolves to 'es' — the only published locale, see
// `odd/tasks/site-cleanup.md` C2).
const lang: Language = langProp ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Convert ImageMetadata → string URL for SeoHead's ogImage prop. SeoHead
// expects a string (absolute or root-relative path); ImageMetadata exposes
// `.src` once Astro processes the asset. Untouched by the terminal redesign
// — SEO/JSON-LD stay exactly as they were.
const ogImageUrl: string | undefined = frontmatter.ogImage?.src ?? frontmatter.heroImage?.src;

const workHref = getRoutePath('work', lang);
const contactHref = getRoutePath('contact', lang);

const bodyPromptCommand = `less ${slug}/README.md`;

// CTA copy, duplicated verbatim from Footer.astro's own `capture` object —
// see docblock above.
const ctaCopy = {
  eyebrow: '# ¿Empezamos?',
  heading: 'Cuéntame qué necesitas',
  sub: 'La primera llamada es gratis y sin compromiso.',
};
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  ogImage={ogImageUrl}
  type="article"
>
  <div class="case-study">
    <p class="case-study__breadcrumb">
      <a href={workHref}>← cd ../</a>
      &nbsp;trabajos / {slug}
    </p>

    <CaseStudyHero
      slug={slug}
      title={frontmatter.title}
      tagline={frontmatter.tagline}
      client={frontmatter.client}
      year={frontmatter.year}
      role={frontmatter.role}
      attribution={frontmatter.attribution}
      logo={frontmatter.logo}
      externalUrl={frontmatter.externalUrl}
      stack={frontmatter.stack}
      lang={lang}
      class="t-pane-gutter"
    />

    {
      /* No `labelledby` — unlike the hero/CTA panes, this pane has no
         single short heading of its own (its body holds several `<h2>`
         subsections); `TerminalPane` doesn't forward arbitrary ARIA
         attributes (its `Props` type is a closed list, no passthrough), so
         this follows `Footer.astro`'s own precedent of omitting
         `labelledby` entirely rather than mislabelling the section. */
    }
    <TerminalPane path={`trabajos/${slug}/README.md`} index="2/2" class="t-pane-gutter">
      <div class="case-body">
        <Prompt command={bodyPromptCommand} />
        <div class="case-body__content">
          <slot />
        </div>
      </div>
    </TerminalPane>

    <TerminalPane path="contacto" scan={false} labelledby="case-cta-heading" class="t-pane-gutter">
      <div class="case-cta">
        <Prompt command="./hablemos" />
        <p class="t-comment case-cta__eyebrow">{ctaCopy.eyebrow}</p>
        <h2 id="case-cta-heading" class="case-cta__heading font-display">{ctaCopy.heading}</h2>
        <p class="case-cta__sub">{ctaCopy.sub}</p>
        <TerminalButton href={contactHref} primary class="case-cta__button">
          [ {t('cta.contact')} ]
        </TerminalButton>
      </div>
    </TerminalPane>

    <nav
      class="case-siblings"
      aria-label="Más trabajos"
      style={`grid-template-columns: repeat(${next ? 2 : 1}, minmax(0, 1fr));`}
    >
      <a class="case-siblings__card" href={workHref}>
        <span class="case-siblings__cmd">cd ../</span>
        <span class="case-siblings__label">← Todos los trabajos</span>
      </a>
      {
        next && (
          <a class="case-siblings__card case-siblings__card--next" href={next.url}>
            <span class="case-siblings__cmd">{`cd ../${next.url.split('/').pop()}`}</span>
            <span class="case-siblings__label">{next.title} →</span>
          </a>
        )
      }
    </nav>
  </div>
</BaseLayout>

<style>
  .case-study {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(4rem, 8vw, 8rem);
  }

  .case-study__breadcrumb {
    margin: 0 40px 24px;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  @media (max-width: 640px) {
    .case-study__breadcrumb {
      margin: 0 10px 16px;
    }
  }

  .case-study__breadcrumb a {
    color: var(--accent-300);
    text-decoration: none;
  }

  .case-study__breadcrumb a:hover,
  .case-study__breadcrumb a:focus-visible {
    color: var(--text-0);
  }

  /* ----------------------------------------------------------------------- */
  /* Body pane — slotted MDX content styled as terminal prose.               */
  /* Selectors are `:global()` because slotted Markdown output carries no    */
  /* classes of its own (same technique LockupPane.astro uses for its own    */
  /* slotted role-pane body).                                                */
  /* ----------------------------------------------------------------------- */

  .case-body {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .case-body__content {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .case-body__content :global(h2) {
    margin: 0;
    color: var(--text-0);
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 700;
    line-height: 1.2;
  }

  .case-body__content :global(h2)::before {
    content: '## ';
    color: var(--text-3);
    font-weight: 400;
  }

  .case-body__content :global(p) {
    margin: 0;
    max-width: 760px;
    color: var(--text-1);
    font-size: var(--text-base);
    line-height: 1.75;
  }

  .case-body__content :global(a) {
    color: var(--accent-300);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .case-body__content :global(a:hover),
  .case-body__content :global(a:focus-visible) {
    color: var(--text-0);
  }

  /* ----------------------------------------------------------------------- */
  /* CTA pane                                                                 */
  /* ----------------------------------------------------------------------- */

  .case-cta {
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 15px;
  }

  .case-cta__eyebrow {
    margin: 0;
    font-size: var(--text-xs);
  }

  .case-cta__heading {
    margin: 0;
    max-width: 1000px;
    color: var(--text-0);
    font-size: clamp(1.5rem, 3vw + 1rem, 2rem);
    font-weight: 700;
    line-height: 1.3;
  }

  .case-cta__sub {
    margin: 0;
    color: var(--text-2);
    font-size: var(--text-lg);
    line-height: 1.6;
  }

  .case-cta__button {
    align-self: flex-start;
    margin-top: 8px;
  }

  @media (max-width: 640px) {
    .case-cta__button {
      width: 100%;
    }
  }

  /* ----------------------------------------------------------------------- */
  /* Prev/next siblings                                                       */
  /* ----------------------------------------------------------------------- */

  .case-siblings {
    display: grid;
    gap: 16px;
    margin: 0 40px;
  }

  @media (max-width: 640px) {
    .case-siblings {
      margin: 0 10px;
      grid-template-columns: 1fr !important;
    }
  }

  .case-siblings__card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-1);
    color: var(--text-0);
    text-decoration: none;
    transition:
      border-color var(--motion-fast) var(--motion-ease-out),
      transform var(--motion-fast) var(--motion-ease-out);
  }

  .case-siblings__card:hover,
  .case-siblings__card:focus-visible {
    border-color: var(--accent-400);
    transform: translateY(-2px);
  }

  .case-siblings__card--next {
    align-items: flex-end;
    text-align: right;
  }

  .case-siblings__cmd {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .case-siblings__label {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
  }
</style>
