---
/**
 * WorkIndex.astro — sección principal del índice de trabajos (T-34).
 *
 * Renderiza el listado completo de:
 *   - Case studies (`getCollection('case-studies')`).
 *   - Projects (`getCollection('projects')`).
 *
 * Filtrado por `status` con progressive enhancement:
 *   - Sin JS: el `<form method="GET">` recarga la página con `?status=...`.
 *     El servidor (build estático) no filtra: serializa TODOS los entries
 *     dentro del HTML y deja el filtrado al cliente. Cuando JS está apagado,
 *     `<noscript>` hace visibles todas las cards y los filtros vuelven a
 *     funcionar como un select normal de form GET (que solo cambia la URL).
 *   - Con JS: un script vanilla (~50 líneas) lee el `value` del select,
 *     actualiza la URL via `history.replaceState`, y muestra/oculta las
 *     cards según el atributo `data-status` de cada artículo. No hay
 *     fetch ni recarga.
 *
 * Estados de filtro:
 *   - `all` (default)            → todo visible
 *   - `success`                  → status === 'success' (case studies)
 *   - `in-development`           → status === 'in-development'
 *   - `side-project`             → status ∈ {'side-project', 'paused'}
 *
 * Orden:
 *   1. status priority desc: success > in-development > side-project > paused.
 *   2. year desc (entries con year explícito primero).
 *   3. order asc (frontmatter custom).
 *
 * Layout:
 *   - 2 columnas desktop (≥768px), 1 columna mobile.
 *   - Featured case studies ocupan 2 columnas en desktop (full width row).
 *
 * Tokens DESIGN.md:
 *   §2 → --bg-0/1, --text-0/1/2, --accent-400, --border
 *   §4 → --font-display (h1), --font-sans, --font-mono (filter)
 *   §5 → padding 96-128px, gap 32px
 *   §6 → --motion-fast, --motion-ease-out
 */
import { getCollection, type CollectionEntry } from 'astro:content';

import CaseStudyCard from '../ui/CaseStudyCard.astro';
import ProjectCard from '../ui/ProjectCard.astro';
import Reveal from '../ui/Reveal.astro';
import { useTranslations } from '../../i18n/helpers';
import type { Language } from '../../i18n/ui';

export interface Props {
  /** Idioma activo. Filtra entries por `lang` y propaga a las cards. */
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// ---------------------------------------------------------------------------
// Carga + normalización de entries.
// ---------------------------------------------------------------------------
//
// Mezclamos case studies + projects en un solo array `items` con shape
// uniforme (`kind`, `entry`, `status`) para poder ordenarlos juntos. Cada
// item guarda su `kind` así el render decide qué card usar.

type CaseStudyEntry = CollectionEntry<'case-studies'>;
type ProjectEntry = CollectionEntry<'projects'>;

type WorkItem =
  | { kind: 'case-study'; entry: CaseStudyEntry; status: 'success' }
  | {
      kind: 'project';
      entry: ProjectEntry;
      status: 'in-development' | 'side-project' | 'paused';
    };

const isProd = import.meta.env.PROD;

const caseStudies = await getCollection(
  'case-studies',
  (entry: CaseStudyEntry) => {
    if (entry.data.lang !== lang) return false;
    if (isProd && entry.data.draft) return false;
    return true;
  },
);

const projects = await getCollection(
  'projects',
  (entry: ProjectEntry) => {
    if (entry.data.lang !== lang) return false;
    if (isProd && entry.data.draft) return false;
    return true;
  },
);

const items: WorkItem[] = [
  ...caseStudies.map(
    (entry: CaseStudyEntry): WorkItem => ({
      kind: 'case-study',
      entry,
      status: 'success',
    }),
  ),
  ...projects.map(
    (entry: ProjectEntry): WorkItem => ({
      kind: 'project',
      entry,
      status: entry.data.status,
    }),
  ),
];

// Status priority — success arriba, paused abajo. Se aplica como primer
// criterio de sort. Year desc y order asc desempatan después.
const STATUS_PRIORITY: Record<WorkItem['status'], number> = {
  success: 4,
  'in-development': 3,
  'side-project': 2,
  paused: 1,
};

items.sort((a, b) => {
  const priorityDelta = STATUS_PRIORITY[b.status] - STATUS_PRIORITY[a.status];
  if (priorityDelta !== 0) return priorityDelta;

  // year desc: entries sin year quedan al final del bucket de su status.
  const aYear = (a.entry.data as { year?: number }).year ?? -Infinity;
  const bYear = (b.entry.data as { year?: number }).year ?? -Infinity;
  if (bYear !== aYear) return bYear - aYear;

  // order asc: frontmatter custom para fijar orden manual dentro del bucket.
  const aOrder = a.entry.data.order ?? Number.MAX_SAFE_INTEGER;
  const bOrder = b.entry.data.order ?? Number.MAX_SAFE_INTEGER;
  return aOrder - bOrder;
});

// ---------------------------------------------------------------------------
// Helpers de render.
// ---------------------------------------------------------------------------

/**
 * Construye la ruta del detalle del item según colección + idioma.
 * Case studies viven en `/case-studies/<slug>` (ES) / `/en/case-studies/<slug>`.
 * Projects viven en `/proyectos/<slug>` (ES) / `/en/projects/<slug>`.
 */
function getHref(item: WorkItem): string {
  const slug = item.entry.id.split('/').pop() ?? item.entry.id;
  if (item.kind === 'case-study') {
    return lang === 'es' ? `/case-studies/${slug}` : `/en/case-studies/${slug}`;
  }
  return lang === 'es' ? `/proyectos/${slug}` : `/en/projects/${slug}`;
}

/**
 * Mapea status semántico → bucket del filtro UI. Side-project y paused
 * comparten bucket porque conceptualmente son "side projects" en el filtro.
 */
function getFilterBucket(status: WorkItem['status']): string {
  if (status === 'success') return 'success';
  if (status === 'in-development') return 'in-development';
  return 'side-project';
}

---

<section class="work-index" aria-labelledby="work-heading">
  <Reveal as="header" class="work-index__hero">
    <h1 id="work-heading" class="work-index__title font-display">
      {t('work.heading')}
    </h1>
    <p class="work-index__tagline">{t('work.tagline')}</p>
  </Reveal>

  <Reveal as="div" class="work-index__grid-wrapper">
    {
      items.length === 0 ? (
        <p class="work-index__empty" data-work-empty>
          {t('work.empty')}
        </p>
      ) : (
        <ul class="work-index__grid" role="list" data-work-grid>
          {items.map((item) => {
            const href = getHref(item);
            const bucket = getFilterBucket(item.status);
            const itemClasses = 'work-index__item';
            return (
              <li
                class={itemClasses}
                data-work-item
                data-status={item.status}
                data-bucket={bucket}
              >
                {item.kind === 'case-study' ? (
                  <CaseStudyCard
                    title={item.entry.data.title}
                    tagline={item.entry.data.tagline}
                    client={item.entry.data.client}
                    attribution={item.entry.data.attribution}
                    logo={item.entry.data.logo}
                    clientLogo={item.entry.data.clientLogo}
                    year={item.entry.data.year}
                    stack={item.entry.data.stack}
                    lang={lang}
                    href={href}
                    heroImage={item.entry.data.heroImage}
                    featured={item.entry.data.featured ?? false}
                  />
                ) : (
                  <ProjectCard
                    title={item.entry.data.title}
                    description={item.entry.data.description}
                    pitch={item.entry.data.pitch}
                    stack={item.entry.data.stack}
                    status={item.entry.data.status}
                    logo={item.entry.data.logo}
                    year={item.entry.data.year}
                    lang={lang}
                    href={href}
                    repo={item.entry.data.repo}
                    liveUrl={item.entry.data.liveUrl}
                  />
                )}
              </li>
            );
          })}
        </ul>
      )
    }

  </Reveal>
</section>

<style>
  /* ---------------------------------------------------------------------- */
  /* Section wrapper                                                         */
  /* ---------------------------------------------------------------------- */

  .work-index {
    padding-block: clamp(64px, 10vw, 128px);
    padding-inline: clamp(16px, 4vw, 32px);
    max-width: 1200px;
    margin-inline: auto;
    display: grid;
    row-gap: 48px;
  }

  /* ---------------------------------------------------------------------- */
  /* Hero                                                                    */
  /* ---------------------------------------------------------------------- */

  .work-index__hero {
    display: grid;
    gap: 12px;
    max-width: 720px;
  }

  .work-index__title {
    margin: 0;
    color: var(--text-0);
    /* Hero pequeño — h1 más contenido que en home: 39-56px clamp. */
    font-size: clamp(2.25rem, 5vw + 0.5rem, 3.5rem);
    font-weight: 600;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tighter);
  }

  .work-index__tagline {
    margin: 0;
    color: var(--text-2);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    text-wrap: pretty;
  }

  /* ---------------------------------------------------------------------- */
  /* Grid                                                                    */
  /* ---------------------------------------------------------------------- */

  .work-index__grid-wrapper {
    /* Container del grid + empty state. Permite que el mensaje "no hay…" se
       posicione cuando JS oculta todas las cards del filtro. */
    position: relative;
  }

  .work-index__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 768px) {
    .work-index__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .work-index__item {
    display: flex;
  }

  .work-index__item :global(.case-study-card),
  .work-index__item :global(.project-card) {
    width: 100%;
  }

  /* Cuando JS esconde un item del filtro, se quita del flow del grid
     completamente para que el grid se reconfigure sin huecos. */
  .work-index__item[hidden] {
    display: none;
  }

  /* ---------------------------------------------------------------------- */
  /* Empty state                                                             */
  /* ---------------------------------------------------------------------- */

  .work-index__empty {
    margin: 0;
    padding: 64px 24px;
    text-align: center;
    color: var(--text-3);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    background: var(--bg-1);
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
  }
</style>
