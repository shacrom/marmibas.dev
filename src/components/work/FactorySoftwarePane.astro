---
/**
 * FactorySoftwarePane.astro — "Software para fábricas" pane for
 * `/experiencia` (owner requests from screenshot reviews, 2026-09-25).
 *
 * Context: the timeline's top entry
 * (`src/content/experience/es/marmibas.md`) used to show BOTH the Marmibas
 * logo and the Plazasys `partnerLogo`, plus two bullets about the industrial
 * work done with Plazasys and the case studies born from it. The owner asked
 * to split that: the timeline entry now reads as Marmibas' own step as a
 * freelancer (Marmibas logo only, Voxye bullet only), and this pane gives the
 * industrial work its own section. The owner does not want it framed as an
 * "alianza" — keep the wording to "junto a Plazasys".
 *
 * Copy comes from the two bullets removed from the MDX body, with "en alianza
 * con" reworded to "junto a" at the owner's request — no new facts, dates or
 * numbers:
 *   - `intro` = the "Para proyectos industriales..." bullet.
 *   - `rows[].desc` = the parenthetical descriptions from the
 *     "Recetas Novatex (...) y Visomo's (...)" bullet.
 * `eyebrow`/`heading`/`fruitsIntro`/the prompt command are decorative framing,
 * same convention every other pane documents. "en producción" mirrors the
 * case studies' own `status: "success"` (`content.config.ts`).
 *
 * This component is data-only: it holds the ES copy, the project rows, and
 * this provenance note, and renders the shared `LockupPane.astro`
 * (`src/components/work/LockupPane.astro`) for markup, styles and motion —
 * the same component `VoxyePane.astro` renders for the Marmibas × Voxye
 * pane. Where this pane lands on the page (and its spacing relative to
 * neighbouring sections) is the page's own concern, not this component's —
 * see `experience/index.astro`.
 */

import LockupPane from './LockupPane.astro';
import type { Language } from '../../i18n/ui';

export interface Props {
  /** Active language. Drives copy (ES-only today, see DESIGN.md §13). */
  lang: Language;
}

const { lang } = Astro.props as Props;

const panePath = 'fabricas';
const promptCommand = 'ls fabricas/';
const headingId = 'factory-heading';

// Copy reused verbatim from the two bullets removed from
// `src/content/experience/es/marmibas.md` (see docblock above).
const copy = {
  es: {
    eyebrow: 'Proyectos industriales',
    heading: 'Software para fábricas',
    intro:
      'Para proyectos industriales trabajo junto a Plazasys, mi socio tecnológico y cliente principal, que me conecta con fábricas que necesitan digitalizarse.',
    fruitsIntro: 'Recetas Novatex y Visomo’s están en producción:',
    statusLabel: 'en producción',
  },
} as const;

const content = copy[lang];

// Industrial projects in production — same case studies + logo assets `CasesPane.astro`
// renders on the home page; descriptions copied verbatim (see docblock).
const rows = [
  {
    slug: 'recetas-novatex',
    title: 'Recetas Novatex',
    desc: 'la libreta digital de ajustes de máquina',
    logo: '/logos/novatex.jpg',
    href: '/case-studies/recetas-novatex',
  },
  {
    slug: 'visomos',
    title: "Visomo's",
    desc: 'el panel de control de una fábrica en tiempo real',
    logo: '/logos/visomos.svg',
    href: '/case-studies/visomos',
  },
] as const;

// Plazasys is a wide logotype (viewBox 4662×1428, ~3.3:1) — needs the wide
// wordmark tile treatment, same as the Marmibas tile.
const partnerLogo = {
  src: '/logos/plazasys-logo.svg',
  alt: 'Logo de Plazasys',
  wide: true,
};
---

<LockupPane
  path={panePath}
  promptCommand={promptCommand}
  headingId={headingId}
  eyebrow={content.eyebrow}
  heading={content.heading}
  partnerLogo={partnerLogo}
  intro={content.intro}
  fruitsIntro={content.fruitsIntro}
  statusLabel={content.statusLabel}
  rows={rows}
/>
