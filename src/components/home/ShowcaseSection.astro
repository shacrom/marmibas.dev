---
/**
 * ShowcaseSection.astro — "Ejemplos reales" / "Real examples" section for the home page.
 *
 * Three INTERACTIVE demo panels that look and behave like real software
 * (plazasys.com-style fake app windows) rather than abstract illustrations.
 * Pure HTML/CSS + one minimal vanilla `<script>` — no images, no libraries.
 *
 * Panels:
 *   1. machines   — shop-floor monitor. Start/stop toggle per machine; the
 *                   production summary recalculates from the running set.
 *   2. management — quote document. Include/exclude line items (total
 *                   recalculates, locale-formatted) + fake "Generate PDF"
 *                   button with a busy → done → idle sequence.
 *   3. data       — spreadsheet-to-app. Segmented "Before · Excel / Now · App"
 *                   toggle (cramped spreadsheet mock vs clean table) and a
 *                   real search input that live-filters the table rows
 *                   (case/accent-insensitive).
 *
 * Visual anchors (DESIGN.md):
 * - §8 "Showcase demo panels": extends `.case-study-card__visual` fake-window
 *   language (3-dot topbar over `--bg-2`).
 * - §7 animation #3 (Reveal on scroll) for section + staggered per-panel
 *   entrance, plus the standard card hover elevation. View switching in panel 3
 *   is an opacity-only CSS transition on `--motion-base`. No idle animation,
 *   no new keyframes, no local reduced-motion block (motion.css is the single
 *   source of truth).
 *
 * Accessibility: the mocks are NO LONGER fully decorative — they contain real
 * native controls (`<button>`, `<input>`) with proper semantics: `aria-pressed`
 * on toggles, a visually-hidden `<label>` for the search input, and
 * `aria-live="polite"` regions for the recalculated values (production summary,
 * quote total). Purely illustrative bits that never convey information (window
 * topbar dots, status dot, progress bar, the "Before · Excel" chaos grid) stay
 * `aria-hidden`.
 *
 * Progressive enhancement: server renders the complete initial state (running
 * machines, all quote lines included, "Now · App" view, correct totals). Without
 * JS everything is visible and static — controls simply do not respond.
 */

import type { Language } from '../../i18n/ui';
import Reveal from '../ui/Reveal.astro';

export interface Props {
  /** Active language. Drives heading + subheading + panel copy. */
  lang: Language;
}

const { lang } = Astro.props;

const locale = lang === 'es' ? 'es-ES' : 'en-US';
const nf = new Intl.NumberFormat(locale);
const fmtMeters = (n: number): string => `${nf.format(n)} m`;
const fmtCurrency = (n: number): string =>
  lang === 'es' ? `${nf.format(n)} €` : `€${nf.format(n)}`;

/** Normalize for accent/case-insensitive search (same logic as the client script). */
const normalize = (s: string): string =>
  s
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase();

