const content = copy[lang];

/**
 * Panel 1 demo data. Each machine contributes `meters` to today's production
 * while running (precalculated per state — no time simulation). Summary =
 * base (earlier shifts) + running contributions.
 * Initial state: 2 running + 1 stopped → 1.262 + 1.240 + 980 = 3.482 m, 2 stops.
 */
const MACHINE_METERS = [1240, 980, 415] as const;
const MACHINE_RUNNING = [true, true, false] as const;
const BASE_PRODUCTION = 1262;
const BASE_STOPS = 1;

const initialProduction =
  BASE_PRODUCTION + MACHINE_METERS.reduce((sum, m, i) => (MACHINE_RUNNING[i] ? sum + m : sum), 0);
const initialStops = BASE_STOPS + MACHINE_RUNNING.filter((r) => !r).length;

const initialTotal = content.management.lines.reduce((sum, l) => sum + l.amount, 0);
const dataDateOptions = Array.from(new Set(content.data.rows.map((row) => row.date)));
---

<Reveal
  as="section"
  class="showcase"
  aria-labelledby="showcase-heading"
  data-showcase
  data-lang={lang}
  data-base-production={String(BASE_PRODUCTION)}
  data-base-stops={String(BASE_STOPS)}
>
  <div class="showcase__inner">
    <header class="showcase__header">
      <p class="showcase__eyebrow">{content.eyebrow}</p>
      <h2 id="showcase-heading" class="showcase__heading font-display">{content.heading}</h2>
      <p class="showcase__sub">{content.sub}</p>
    </header>

    <div class="showcase__grid">
      {/* Panel 1 — machines */}
      <Reveal
        as="article"
        class="showcase__panel"
        delay={0}
        aria-labelledby="showcase-machines-title"
      >
        <div class="showcase__window">
          <div class="showcase__topbar" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <ul class="showcase__machines">
            {
              content.machines.names.map((name, i) => (
                <li
                  class="showcase__machine"
                  data-machine
                  data-state={MACHINE_RUNNING[i] ? 'running' : 'stopped'}
                  data-meters={String(MACHINE_METERS[i])}
                >
                  <span class="showcase__machine-head">
                    <span class="showcase__dot" aria-hidden="true" />
                    <span class="showcase__machine-name">{name}</span>
                  </span>
                  <span class="showcase__machine-counter" data-machine-counter>
                    {fmtMeters(MACHINE_RUNNING[i] ? MACHINE_METERS[i] : 0)}
                  </span>
                  <button
                    type="button"
                    class="showcase__machine-toggle"
                    data-machine-toggle
                    aria-pressed={MACHINE_RUNNING[i] ? 'true' : 'false'}
                    data-label-stop={content.machines.stop}
                    data-label-start={content.machines.start}
                  >
                    {MACHINE_RUNNING[i] ? content.machines.stop : content.machines.start}
                  </button>
                  <span class="showcase__bar" aria-hidden="true">
                    <span class="showcase__bar-fill" />
                  </span>
                </li>
              ))
            }
          </ul>
          <p class="showcase__machines-summary" aria-live="polite">
            <span>
              {content.machines.summaryProduction} · <span data-summary-production
                >{nf.format(initialProduction)}</span
              > m
            </span>
            <span>
              {content.machines.summaryStops} · <span data-summary-stops>{initialStops}</span>
            </span>
          </p>
        </div>

        <div class="showcase__panel-body">
          <h3 id="showcase-machines-title" class="showcase__panel-title font-display">
            {content.panels[0].title}
          </h3>
          <p class="showcase__panel-desc">{content.panels[0].desc}</p>
        </div>
      </Reveal>

      {/* Panel 2 — document management */}
      <Reveal
        as="article"
        class="showcase__panel"
        delay={80}
        aria-labelledby="showcase-management-title"
      >
        <div class="showcase__window">
          <div class="showcase__topbar" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="showcase__doc">
            <div class="showcase__doc-head">
              <span class="showcase__doc-title">{content.management.docTitle}</span>
              <span class="showcase__badge">{content.management.status}</span>
            </div>
            <ul class="showcase__doc-lines">
              {
                content.management.lines.map((line) => (
                  <li>
                    <label
                      class="showcase__doc-line"
                      data-doc-line
                      data-amount={String(line.amount)}
                    >
                      <input
                        type="checkbox"
                        checked
                        aria-label={`${content.management.includeLine}: ${line.label}`}
                      />
                      <span class="showcase__doc-label">{line.label}</span>
                      <span class="showcase__doc-amount">{fmtCurrency(line.amount)}</span>
                    </label>
                  </li>
                ))
              }
            </ul>
            <div class="showcase__doc-total" aria-live="polite">
              <span>{content.management.totalLabel}</span>
              <span data-doc-total>{fmtCurrency(initialTotal)}</span>
            </div>
            <button
              type="button"
              class="showcase__pdf-button"
              data-pdf-button
              aria-live="polite"
              data-label-idle={content.management.pdfIdle}
              data-label-busy={content.management.pdfBusy}
              data-label-done={content.management.pdfDone}
            >
              {content.management.pdfIdle}
            </button>
          </div>
        </div>

        <div class="showcase__panel-body">
          <h3 id="showcase-management-title" class="showcase__panel-title font-display">
            {content.panels[1].title}
          </h3>
          <p class="showcase__panel-desc">{content.panels[1].desc}</p>
        </div>
      </Reveal>

      {
        /* Panel 3 — from spreadsheet to app. Full-width bento row on desktop:
          simulator window left (~60%), title + description right, centered. */
      }
      <Reveal
        as="article"
        class="showcase__panel showcase__panel--wide"
        delay={160}
        aria-labelledby="showcase-data-title"
      >
        <div class="showcase__window">
          <div class="showcase__topbar" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="showcase__data">
            <div class="showcase__segment" role="group">
              <button type="button" data-view-toggle="before" aria-pressed="false">
                {content.data.viewBefore}
              </button>
              <button type="button" data-view-toggle="after" aria-pressed="true">
                {content.data.viewAfter}
              </button>
            </div>

            <div class="showcase__views">
              {
                /* "Before" — deliberately cramped spreadsheet mock. Purely
                  illustrative (conveys chaos, not data) → stays aria-hidden. */
              }
              <div class="showcase__view" data-view="before" aria-hidden="true">
                <div class="showcase__excel">
                  {
                    content.data.excel.map((cell) => (
                      <span class={cell.startsWith('#') ? 'is-error' : undefined}>{cell}</span>
                    ))
                  }
                </div>
              </div>

              {/* "Now" — searchable dashboard. Real controls, real content. */}
              <div class="showcase__view is-active" data-view="after" aria-hidden="false">
                <div class="showcase__dashboard">
                  <div class="showcase__controls">
                    <label class="showcase__control">
                      <span>{content.data.searchLabel}</span>
                      <input
                        class="showcase__input"
                        type="search"
                        autocomplete="off"
                        placeholder={content.data.searchPlaceholder}
                        data-table-search
                      />
                    </label>
                    <label class="showcase__control">
                      <span>{content.data.dateFilterLabel}</span>
                      <select class="showcase__input" data-date-filter>
                        <option value="">{content.data.dateFilterAll}</option>
                        {dataDateOptions.map((date) => <option value={date}>{date}</option>)}
                      </select>
                    </label>
                    <label class="showcase__control">
                      <span>{content.data.sortLabel}</span>
                      <select class="showcase__input" data-sort-amount>
                        <option value="desc">{content.data.sortHighToLow}</option>
                        <option value="asc">{content.data.sortLowToHigh}</option>
                      </select>
                    </label>
                  </div>

                  <div class="showcase__stats" role="list" aria-label={content.data.statsLabel}>
                    {
                      content.data.stats.map((stat) => (
                        <div class="showcase__stat" role="listitem">
                          <span>{stat.label}</span>
                          <strong>{stat.value}</strong>
                        </div>
                      ))
                    }
                  </div>

                  <div class="showcase__chart">
                    <p class="showcase__chart-title">{content.data.chartTitle}</p>
                    <div class="showcase__bars">
                      {
                        content.data.chart.map((value, i) => (
                          <span style={`--bar-value: ${value}%`}>
                            <span class="showcase__sr-only">{`${content.data.chartTitle} ${i + 1}: ${value}%`}</span>
                          </span>
                        ))
                      }
                    </div>
                  </div>

                  <table class="showcase__table" data-demo-table>
                    <thead>
                      <tr>
                        {content.data.headers.map((h) => <th>{h}</th>)}
                      </tr>
                    </thead>
                    <tbody data-table-body>
                      {
                        content.data.rows.map((row, i) => (
                          <tr
                            class={i === 0 ? 'is-highlighted' : undefined}
                            data-table-row
                            data-search={normalize(`${row.client} ${row.product}`)}
                            data-date={row.date}
                            data-amount={String(row.amount)}
                          >
                            <td data-label={content.data.headers[0]}>{row.client}</td>
                            <td data-label={content.data.headers[1]}>{row.product}</td>
                            <td data-label={content.data.headers[2]}>{row.date}</td>
                            <td data-label={content.data.headers[3]}>{fmtCurrency(row.amount)}</td>
                            <td data-label={content.data.headers[4]}>
                              <span class="showcase__status">{row.status}</span>
                            </td>
                          </tr>
                        ))
                      }
                      <tr class="showcase__table-empty" data-table-empty hidden>
                        <td colspan="5">{content.data.noResults}</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="showcase__panel-body">
          <h3 id="showcase-data-title" class="showcase__panel-title font-display">
            {content.panels[2].title}
          </h3>
          <p class="showcase__panel-desc">{content.panels[2].desc}</p>
        </div>
      </Reveal>
    </div>
  </div>
</Reveal>

<script>
  /**
   * Interactive demo panels driver. Progressive enhancement over a complete
   * server-rendered initial state. Re-runs on astro:page-load (View
   * Transitions) with a per-section init guard — same pattern as Reveal.astro.
   */
  function setupShowcase() {
    document.querySelectorAll<HTMLElement>('[data-showcase]').forEach((section) => {
      if (section.dataset.showcaseInit === 'true') return;
      section.dataset.showcaseInit = 'true';

      const lang = section.dataset.lang === 'en' ? 'en' : 'es';
      const nf = new Intl.NumberFormat(lang === 'es' ? 'es-ES' : 'en-US');
      const fmtCurrency = (n: number) => (lang === 'es' ? `${nf.format(n)} €` : `€${nf.format(n)}`);

      /* ------------------------------------------------------------------ */
      /* Panel 1 — machines                                                  */
      /* ------------------------------------------------------------------ */
      const baseProduction = Number(section.dataset.baseProduction) || 0;
      const baseStops = Number(section.dataset.baseStops) || 0;
      const machines = Array.from(section.querySelectorAll<HTMLElement>('[data-machine]'));
      const productionEl = section.querySelector<HTMLElement>('[data-summary-production]');
      const stopsEl = section.querySelector<HTMLElement>('[data-summary-stops]');

      function recalcMachines() {
        let production = baseProduction;
        let stops = baseStops;
        for (const machine of machines) {
          if (machine.dataset.state === 'running') {
            production += Number(machine.dataset.meters) || 0;
          } else {
            stops += 1;
          }
        }
        if (productionEl) productionEl.textContent = nf.format(production);
        if (stopsEl) stopsEl.textContent = String(stops);
      }

      for (const machine of machines) {
        const toggle = machine.querySelector<HTMLButtonElement>('[data-machine-toggle]');
        const counter = machine.querySelector<HTMLElement>('[data-machine-counter]');
        toggle?.addEventListener('click', () => {
          const nowRunning = machine.dataset.state !== 'running';
          machine.dataset.state = nowRunning ? 'running' : 'stopped';
          toggle.setAttribute('aria-pressed', String(nowRunning));
          toggle.textContent = nowRunning
            ? (toggle.dataset.labelStop ?? '')
            : (toggle.dataset.labelStart ?? '');
          if (counter) {
            const meters = nowRunning ? Number(machine.dataset.meters) || 0 : 0;
            counter.textContent = `${nf.format(meters)} m`;
          }
          recalcMachines();
        });
      }

      /* ------------------------------------------------------------------ */
      /* Panel 2 — quote document                                            */
      /* ------------------------------------------------------------------ */
      const docLines = Array.from(section.querySelectorAll<HTMLElement>('[data-doc-line]'));
      const totalEl = section.querySelector<HTMLElement>('[data-doc-total]');

      function recalcTotal() {
        let total = 0;
        for (const line of docLines) {
          const checkbox = line.querySelector<HTMLInputElement>('input[type="checkbox"]');
          if (checkbox?.checked) total += Number(line.dataset.amount) || 0;
        }
        if (totalEl) totalEl.textContent = fmtCurrency(total);
      }

      for (const line of docLines) {
        const checkbox = line.querySelector<HTMLInputElement>('input[type="checkbox"]');
        checkbox?.addEventListener('change', () => {
          line.classList.toggle('is-excluded', !checkbox.checked);
          recalcTotal();
        });
      }

      const pdfButton = section.querySelector<HTMLButtonElement>('[data-pdf-button]');
      pdfButton?.addEventListener('click', () => {
        if (pdfButton.disabled) return;
        pdfButton.disabled = true;
        pdfButton.textContent = pdfButton.dataset.labelBusy ?? '';
        window.setTimeout(() => {
          pdfButton.textContent = pdfButton.dataset.labelDone ?? '';
          window.setTimeout(() => {
            pdfButton.textContent = pdfButton.dataset.labelIdle ?? '';
            pdfButton.disabled = false;
          }, 2000);
        }, 800);
      });

      /* ------------------------------------------------------------------ */
      /* Panel 3 — before/after views + live table filter                    */
      /* ------------------------------------------------------------------ */
      const viewToggles = Array.from(
        section.querySelectorAll<HTMLButtonElement>('[data-view-toggle]')
      );
      const views = Array.from(section.querySelectorAll<HTMLElement>('[data-view]'));

      for (const toggle of viewToggles) {
        toggle.addEventListener('click', () => {
          const target = toggle.dataset.viewToggle;
          for (const other of viewToggles) {
            other.setAttribute('aria-pressed', String(other === toggle));
          }
          for (const view of views) {
            const isActive = view.dataset.view === target;
            view.classList.toggle('is-active', isActive);
            view.setAttribute('aria-hidden', String(!isActive));
          }
        });
      }

      const normalize = (s: string) =>
        s
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .toLowerCase();

      const searchInput = section.querySelector<HTMLInputElement>('[data-table-search]');
      const dateFilter = section.querySelector<HTMLSelectElement>('[data-date-filter]');
      const amountSort = section.querySelector<HTMLSelectElement>('[data-sort-amount]');
      const table = section.querySelector<HTMLElement>('[data-demo-table]');
      const tableBody = section.querySelector<HTMLElement>('[data-table-body]');
      const rows = Array.from(section.querySelectorAll<HTMLElement>('[data-table-row]'));
      const emptyRow = section.querySelector<HTMLElement>('[data-table-empty]');

      function updateDashboardTable() {
        const query = normalize(searchInput?.value.trim() ?? '');
        const selectedDate = dateFilter?.value ?? '';
        const sortDirection = amountSort?.value === 'asc' ? 'asc' : 'desc';
        const sortedRows = [...rows].sort((a, b) => {
          const amountA = Number(a.dataset.amount) || 0;
          const amountB = Number(b.dataset.amount) || 0;
          return sortDirection === 'asc' ? amountA - amountB : amountB - amountA;
        });
        let visible = 0;
        for (const row of sortedRows) {
          tableBody?.insertBefore(row, emptyRow ?? null);
          const matchesSearch = query === '' || (row.dataset.search ?? '').includes(query);
          const matchesDate = selectedDate === '' || row.dataset.date === selectedDate;
          const match = matchesSearch && matchesDate;
          row.hidden = !match;
          if (match) visible += 1;
        }
        if (emptyRow) emptyRow.hidden = visible > 0;
        // The accent-highlighted row only stands out when no filter/sort is active.
        table?.classList.toggle(
          'is-filtering',
          query !== '' || selectedDate !== '' || sortDirection !== 'desc'
        );
      }

      searchInput?.addEventListener('input', updateDashboardTable);
      dateFilter?.addEventListener('change', updateDashboardTable);
      amountSort?.addEventListener('change', updateDashboardTable);
      updateDashboardTable();
    });
  }

  setupShowcase();
  document.addEventListener('astro:page-load', setupShowcase);
</script>

