---
/**
 * FeaturedProjects.astro — sección "Casos de éxito" del home (T-30).
 *
 * Lista los case studies destacados (2-3) en una grid responsive y los
 * presenta con `CaseStudyCard.astro` (T-22). Implementa RF-04/RF-05 del
 * spec original (TASKS.md T-31 "FeaturedWork") con el naming acordado
 * para esta iteración: el componente vive como `FeaturedProjects` y la
 * sección se titula "Casos de éxito" / "Success stories".
 *
 * Estado actual (T-30): los datos están HARDCODED dentro del componente
 * porque las collections de case-studies (T-44/T-45) todavía no existen.
 * Cuando aterricen, esta sección leerá de la collection vía
 * `getCaseStudies(lang)` y filtrará por `featured: true`. La firma pública
 * (props) seguirá siendo la misma.
 *
 * Estructura:
 *   <Reveal>
 *     <section class="featured-projects">
 *       <header>
 *         <h2 class="font-display">{t('featured.heading')}</h2>
 *         <p>{t('featured.sub')}</p>
 *       </header>
 *       <ul class="featured-projects__grid">
 *         {featuredCases.map((c) => <li><CaseStudyCard ... featured /></li>)}
 *       </ul>
 *       <a class="featured-projects__view-all" href="/trabajos">
 *         {t('featured.viewAll')}
 *       </a>
 *     </section>
 *   </Reveal>
 *
 * Layout:
 *   - Padding vertical 96-128px (DESIGN.md §5: secciones separan 96-128px).
 *   - Grid 1 columna mobile, 2 columnas desktop (≥1024px). Gap 32px.
 *   - Container max-width 1080px (DESIGN.md §9: home/grid).
 *
 * Tokens DESIGN.md usados:
 *   §2 (paleta)      → --bg-0, --text-0, --text-2, --accent-400
 *   §3 (gradients)   → indirecto via CaseStudyCard (conic en featured)
 *   §4 (tipografía)  → --font-display (h2), --font-sans (subhead), --font-mono (CTA)
 *   §5 (spacing)     → padding-block 96-128px, gap 32px
 *   §6 (motion)      → --motion-fast, --motion-ease-out (hover CTA arrow)
 *
 * Spec: TASKS.md T-30 (renombrado) + DESIGN.md §8 ("Featured project card")
 * + §9 ("Spacing vertical entre secciones").
 */

import CaseStudyCard from '../ui/CaseStudyCard.astro';
import Reveal from '../ui/Reveal.astro';
import { useTranslations } from '../../i18n/helpers';
import type { Language } from '../../i18n/ui';

export interface Props {
  /** Idioma activo. Propaga a CaseStudyCard y resuelve el data set localizado. */
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const proofNotes = [
  lang === 'es' ? 'Productos reales, no demos' : 'Real products, not demos',
  lang === 'es' ? 'Problemas de negocio concretos' : 'Concrete business problems',
  lang === 'es' ? 'Pensado para equipos no técnicos' : 'Built for non-technical teams',
] as const;

// ---------------------------------------------------------------------------
// Featured case studies — hardcoded hasta que existan T-44/T-45.
// ---------------------------------------------------------------------------
//
// Cuando las MDX collections aterricen, este array se reemplaza por:
//   const featuredCases = (await getCaseStudies(lang))
//     .filter((c) => c.data.featured)
//     .slice(0, 3);
//
// Mientras tanto, mantenemos el shape compatible con CaseStudyCard.Props
// (title, tagline, client, year, stack, lang, href, featured).

const featuredCases = [
  {
    slug: 'voxye',
    title: 'Voxye',
    tagline:
      lang === 'es'
        ? 'La aplicación que reemplaza Word y Excel para hacer presupuestos y facturas en empresas de reformas. Menos errores, más tiempo, y todo con la imagen de tu marca.'
        : 'The application that replaces Word and Excel for quotes and invoices in renovation companies. Fewer errors, more time, all branded with your identity.',
    client: lang === 'es' ? 'Empresas de reformas' : 'Renovation companies',
    logo: '/logos/voxye.svg',
    year: 2026,
    stack:
      lang === 'es'
        ? ['Presupuestos', 'Facturas', 'Gestión de clientes', 'Emails automáticos']
        : ['Quotes', 'Invoices', 'Client management', 'Automated emails'],
    href: lang === 'es' ? '/case-studies/voxye' : '/en/case-studies/voxye',
    externalUrl: 'https://voxye.com',
    externalLabel: lang === 'es' ? 'Ir al proyecto' : 'Open project',
  },
  {
    slug: 'recetas-novatex',
    title: 'Recetas Novatex',
    tagline:
      lang === 'es'
        ? 'Una libreta digital que sustituye los cuadernos de papel donde se apuntan los ajustes de las máquinas. El conocimiento de tus mejores empleados, guardado para siempre.'
        : 'A digital notebook that replaces paper logs where machine settings are written down. The know-how of your best employees, preserved forever.',
    client: lang === 'es' ? 'Industria textil' : 'Textile industry',
    logo: '/logos/recetas-novatex.png',
    clientLogo: '/logos/novatex.jpg',
    year: 2025,
    stack:
      lang === 'es'
        ? ['Industria textil', 'Móvil', 'Búsqueda rápida', 'Multi-empresa']
        : ['Textile industry', 'Mobile', 'Fast search', 'Multi-company'],
    href: lang === 'es' ? '/case-studies/recetas-novatex' : '/en/case-studies/recetas-novatex',
  },
];

const viewAllHref = lang === 'es' ? '/trabajos' : '/en/work';
---

<Reveal as="section" class="featured-projects" aria-labelledby="featured-heading">
  <div class="featured-projects__inner">
    <header class="featured-projects__header">
      <div class="featured-projects__copy">
        <p class="featured-projects__eyebrow">{lang === 'es' ? 'Prueba real' : 'Real proof'}</p>
        <h2 id="featured-heading" class="featured-projects__heading font-display">
          {t('featured.heading')}
        </h2>
        <p class="featured-projects__sub">{t('featured.sub')}</p>
      </div>

      <ul
        class="featured-projects__proof"
        role="list"
        aria-label={lang === 'es' ? 'Señales de confianza' : 'Trust signals'}
      >
        {proofNotes.map((note) => <li>{note}</li>)}
      </ul>
    </header>

    <ul class="featured-projects__grid" role="list">
      {
        featuredCases.map((caseStudy) => (
          <li class="featured-projects__item">
            <CaseStudyCard
              title={caseStudy.title}
              tagline={caseStudy.tagline}
              client={caseStudy.client}
              logo={caseStudy.logo}
              clientLogo={caseStudy.clientLogo}
              year={caseStudy.year}
              stack={caseStudy.stack}
              lang={lang}
              href={caseStudy.href}
              featured={true}
            />
            {'externalUrl' in caseStudy && caseStudy.externalUrl && (
              <a
                class="featured-projects__external"
                href={caseStudy.externalUrl}
                target="_blank"
                rel="noreferrer"
              >
                {caseStudy.externalLabel}
                <span aria-hidden="true">↗</span>
              </a>
            )}
          </li>
        ))
      }
    </ul>

    <a class="featured-projects__view-all" href={viewAllHref}>
      {t('featured.viewAll')}
    </a>
  </div>
</Reveal>

<style>
  /* ---------------------------------------------------------------------- */
  /* Section wrapper                                                         */
  /* ---------------------------------------------------------------------- */

  .featured-projects {
    /* DESIGN.md §5/§9: secciones separan 96-128px en desktop, 48-64px en
       mobile. Padding lateral fluido para acompañar el container interno. */
    position: relative;
    padding-block: clamp(64px, 10vw, 128px);
    padding-inline: clamp(16px, 4vw, 32px);
    overflow: hidden;
  }

  .featured-projects::before {
    content: '';
    position: absolute;
    inset: clamp(32px, 6vw, 72px) clamp(16px, 5vw, 48px);
    border: 1px solid color-mix(in oklch, var(--border) 58%, transparent);
    border-radius: var(--radius-2xl);
    pointer-events: none;
    opacity: 0.7;
  }

  .featured-projects__inner {
    /* DESIGN.md §9: home/grid usa max-width 1080px. */
    max-width: 1080px;
    margin-inline: auto;
    display: grid;
    /* gap entre header y grid (48px) y entre grid y view-all (32px) lo
       gestionamos a nivel de filas para no romper el ritmo vertical. */
    row-gap: 48px;
    position: relative;
    z-index: 1;
  }

  /* ---------------------------------------------------------------------- */
  /* Header                                                                  */
  /* ---------------------------------------------------------------------- */

  .featured-projects__header {
    display: grid;
    gap: 24px;
    align-items: end;
    /* Limita el ancho del header para que el subhead no se estire en
       desktop (mejor lectura). */
  }

  @media (min-width: 900px) {
    .featured-projects__header {
      grid-template-columns: minmax(0, 1fr) minmax(260px, 360px);
    }
  }

  .featured-projects__copy {
    max-width: 720px;
  }

  .featured-projects__eyebrow {
    margin: 0 0 12px;
    color: var(--accent-400);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .featured-projects__heading {
    margin: 0;
    color: var(--text-0);
    /* DESIGN.md §4: H2 = --text-3xl (39px). Fluido para escalar mobile. */
    font-size: clamp(2rem, 4vw + 0.5rem, 2.4375rem);
    font-weight: 600;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tighter);
  }

  .featured-projects__sub {
    margin: 0;
    color: var(--text-2);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }

  .featured-projects__proof {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .featured-projects__proof li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text-2);
    font-size: var(--text-sm);
  }

  .featured-projects__proof li::before {
    content: '';
    width: 6px;
    height: 6px;
    flex: 0 0 auto;
    border-radius: var(--radius-full);
    background: var(--accent-400);
    box-shadow: 0 0 0 5px var(--accent-glow);
  }

  /* ---------------------------------------------------------------------- */
  /* Grid                                                                    */
  /* ---------------------------------------------------------------------- */

  .featured-projects__grid {
    display: grid;
    /* 1 columna mobile, 2 columnas desktop (≥1024px). Gap 32px. */
    grid-template-columns: 1fr;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 1024px) {
    .featured-projects__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .featured-projects__item {
    display: grid;
    gap: 12px;
    align-content: start;
    /* Keeps any external project CTA outside the wrapping CaseStudyCard anchor. */
  }

  .featured-projects__item :global(.case-study-card) {
    width: 100%;
  }

  .featured-projects__external {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.55rem 0.85rem;
    color: var(--accent-300);
    background: color-mix(in oklch, var(--accent-400) 12%, transparent);
    border: 1px solid color-mix(in oklch, var(--accent-400) 34%, transparent);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition:
      color var(--motion-fast) var(--motion-ease-out),
      border-color var(--motion-fast) var(--motion-ease-out),
      background var(--motion-fast) var(--motion-ease-out),
      transform var(--motion-fast) var(--motion-ease-out);
  }

  .featured-projects__external:hover,
  .featured-projects__external:focus-visible {
    color: var(--accent-100);
    background: color-mix(in oklch, var(--accent-400) 18%, transparent);
    border-color: color-mix(in oklch, var(--accent-400) 58%, transparent);
    transform: translateY(-1px);
  }

  /* ---------------------------------------------------------------------- */
  /* View all                                                                */
  /* ---------------------------------------------------------------------- */

  .featured-projects__view-all {
    /* JetBrains Mono accent — coherente con CTAs de cards (DESIGN.md §8). */
    justify-self: start;
    color: var(--accent-400);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: color var(--motion-fast) var(--motion-ease-out);
  }

  .featured-projects__view-all:hover,
  .featured-projects__view-all:focus-visible {
    color: var(--accent-300);
  }
</style>
