---
/**
 * Hero.astro — Home hero section (T-29).
 *
 * Compose the home hero anchor: ambient gradient + HeroIntro cascade +
 * supporting tagline + dual CTAs. This is the visual anchor described in
 * DESIGN.md §8 ("Hero") and §3 (radial gradient ambient).
 *
 * Layout (top → bottom):
 *   1. <div class="hero__ambient">         ← radial gradient ambient (§3)
 *   2. <HeroIntro eyebrow lines>           ← T-28, Fraunces cascade (§7 #2)
 *   3. <p class="hero__tagline">           ← Inter, --text-2, max-width 620
 *   4. <div class="hero__ctas">            ← primary + secondary buttons (§8)
 *   5. <aside class="hero__panel">         ← client-facing diagnosis card
 *
 * Motion strategy (DESIGN.md §6/§7):
 *   - HeroIntro already animates the cascade (3-4 lines × 120ms + 100ms).
 *   - Tagline + CTAs fade up after the cascade lands. We use the
 *     `.motion-reveal-on-scroll` utility from `motion.css` (T-09) but apply
 *     `.is-visible` SERVER-SIDE, since the hero is above the fold and we
 *     want the transition to start immediately on load. We add a custom
 *     `transition-delay` per element so the staggered reveal is preserved
 *     even with the IntersectionObserver bypass.
 *   - Reduced-motion is neutralised by `motion.css` (single source).
 *
 * CTAs:
 *   - Primary: localized "Hablemos" / "Let's talk" → /contacto | /en/contact.
 *     Uses `--gradient-cta` background, `--shadow-glow` on focus, gradient
 *     shift on hover (DESIGN.md §3 + §8).
 *   - Secondary: localized "Ver mi trabajo" / "See my work" → /trabajos | /en/work.
 *     Outline 1px `--border`, transparent bg. Hover lifts to `--accent-400`.
 *
 * i18n:
 *   - Lines, eyebrow, tagline and CTA labels all live as constants below for
 *     scoping reasons (the lines are an array — heavier than a single string,
 *     not a great fit for the flat `ui.ts` dictionary).
 *   - CTA labels reuse the existing `cta.contact` and `cta.viewWork` keys
 *     from `src/i18n/ui.ts` (no duplication).
 *
 * Tokens (DESIGN.md):
 *   §2 palette       → --text-0..3, --border, --accent-300..600
 *   §3 gradients     → --gradient-hero-ambient, --gradient-cta, --gradient-cta-hover
 *   §4 typography    → --font-display, --font-sans, --font-mono, --text-lg
 *   §5 spacing       → 96px / 128px vertical rhythm, 12/16/24/32/40
 *   §6 motion        → --motion-duration-base/fast, --motion-ease-out
 *   §8 hero          → eyebrow, gradient ambient, primary CTA shadow glow
 */

import HeroIntro from './HeroIntro.astro';
import { useTranslations, getRoutePath } from '../../i18n/helpers';
import type { Language } from '../../i18n/ui';

export interface Props {
  /** Active language. Drives copy + CTA hrefs. */
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// --- Hero copy (per-locale) ------------------------------------------------
// Tone: ES neutro de España, tuteo (audiencia PYMEs y emprendedores sin
// conocimientos técnicos). EN equivalente profesional internacional.
// 3 lines for a tighter cascade — lands ~460ms total, snappier than 4.
const heroLines: Record<Language, string[]> = {
  es: ['Software a medida', 'para negocios', 'que quieren crecer.'],
  en: ['Custom software', 'for businesses', 'ready to grow.'],
};

const tagline: Record<Language, string> = {
  es: 'Diseño y construyo webs, apps y sistemas internos para captar clientes, ahorrar horas y ordenar el trabajo diario. Sin jerga técnica: problema, solución y próximos pasos claros.',
  en: 'I design and build websites, apps and internal systems to win clients, save hours and organize daily work. No technical jargon: clear problem, solution and next steps.',
};

const eyebrow: Record<Language, string> = {
  es: 'marmibas · software a medida',
  en: 'marmibas · custom software',
};

const proofPoints = [
  {
    value: lang === 'es' ? '5+ años' : '5+ years',
    label: lang === 'es' ? 'creando productos reales' : 'building real products',
  },
  {
    value: '2+',
    label: lang === 'es' ? 'soluciones en producción' : 'live production systems',
  },
  {
    value: '24-48h',
    label: lang === 'es' ? 'para recibir respuesta' : 'typical response time',
  },
] as const;

const diagnosis = {
  label: lang === 'es' ? 'Primera llamada gratuita' : 'Free first call',
  title:
    lang === 'es'
      ? 'Convierte una idea suelta en un plan claro.'
      : 'Turn a rough idea into a clear plan.',
  description:
    lang === 'es'
      ? 'En una conversación rápida aterrizamos qué construir, qué evitar y por dónde empezar para que el software tenga impacto real.'
      : 'In one short conversation we define what to build, what to avoid and where to start so the software has real impact.',
  items:
    lang === 'es'
      ? ['Prioridad del negocio', 'MVP posible', 'Coste y tiempos orientativos']
      : ['Business priority', 'Possible MVP', 'Indicative cost and timeline'],
  cta: lang === 'es' ? 'Pedir diagnóstico' : 'Request a diagnosis',
};

const lines = heroLines[lang];
const subhead = tagline[lang];

// CTA hrefs via canonical i18n route helper (T-13).
const contactHref = getRoutePath('contact', lang);
const workHref = getRoutePath('work', lang);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__ambient" aria-hidden="true"></div>
  <div class="hero__stars" aria-hidden="true"></div>

  <div class="hero__content">
    <div class="hero__copy">
      <HeroIntro eyebrow={eyebrow[lang]} lines={lines} />

      <p class="hero__tagline motion-reveal-on-scroll is-visible">
        {subhead}
      </p>

      <div class="hero__ctas motion-reveal-on-scroll is-visible">
        <a class="cta cta--primary" href={contactHref}>
          {t('cta.contact')}
        </a>
        <a class="cta cta--secondary" href={workHref}>
          {t('cta.viewWork')}
        </a>
      </div>

      <ul class="hero__proof" aria-label={lang === 'es' ? 'Pruebas de confianza' : 'Trust signals'}>
        {
          proofPoints.map((point) => (
            <li class="hero__proof-item">
              <strong>{point.value}</strong>
              <span>{point.label}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <aside class="hero__panel motion-reveal-on-scroll is-visible" aria-label={diagnosis.label}>
      <div class="hero__panel-top">
        <span class="hero__panel-kicker">{diagnosis.label}</span>
        <span class="hero__panel-dot" aria-hidden="true"></span>
      </div>

      <div class="hero__panel-body">
        <h2 class="hero__panel-title font-display">{diagnosis.title}</h2>
        <p class="hero__panel-description">{diagnosis.description}</p>
      </div>

      <ul class="hero__panel-list" role="list">
        {
          diagnosis.items.map((item) => (
            <li>
              <span aria-hidden="true">✓</span>
              {item}
            </li>
          ))
        }
      </ul>

      <a class="hero__panel-cta" href={contactHref}>{diagnosis.cta}</a>
    </aside>
  </div>
</section>

<style>
  /* --------------------------------------------------------------------------
   * Section wrapper. Generous vertical rhythm per DESIGN.md §5 (96-128px
   * desktop, 48-64px mobile). `position: relative` is required so the
   * absolutely-positioned ambient gradient is contained.
   * ------------------------------------------------------------------------ */
  .hero {
    position: relative;
    max-width: 1080px;
    margin-inline: auto;
    padding-block: clamp(64px, 10vw, 118px) clamp(64px, 8vw, 88px);
    padding-inline: clamp(20px, 5vw, 48px);
    z-index: 1;
    isolation: isolate;
  }

  /* --------------------------------------------------------------------------
   * Ambient gradient. Radial, painted at the top, fades to transparent. The
   * `--gradient-hero-ambient` token (DESIGN.md §3) is `radial-gradient(
   * ellipse at top, --accent-700 0%, transparent 60%)`. We dampen with
   * opacity to keep it sutil (the design principle is "discipline, not neón").
   * `pointer-events: none` so it never blocks underlying interactive nodes.
   * ------------------------------------------------------------------------ */
  .hero__ambient {
    position: absolute;
    inset: -80px -10vw auto -10vw;
    height: 680px;
    background: var(--gradient-hero-ambient);
    opacity: 0.78;
    pointer-events: none;
    z-index: -1;
  }

  /* --------------------------------------------------------------------------
   * Star pattern — destellos sutiles inspirados en la tarjeta de visita.
   * 8 radial-gradients micro (1-1.5px) repartidos asimétricamente, con
   * opacidad global muy baja para que el efecto sea apenas perceptible al
   * primer vistazo. Sólo en el hero, no en toda la web.
   * `pointer-events: none` para no bloquear interacciones; z-index 0 deja
   * el contenido (z-index 1 implícito en .hero__content via .hero stacking
   * context) por encima.
   * ------------------------------------------------------------------------ */
  .hero__stars {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.4;
    background-image:
      radial-gradient(1.5px 1.5px at 20% 30%, white, transparent),
      radial-gradient(1px 1px at 60% 20%, white, transparent),
      radial-gradient(1.5px 1.5px at 80% 50%, white, transparent),
      radial-gradient(1px 1px at 30% 70%, white, transparent),
      radial-gradient(1.5px 1.5px at 70% 80%, white, transparent),
      radial-gradient(1px 1px at 15% 85%, white, transparent),
      radial-gradient(1.5px 1.5px at 90% 15%, white, transparent),
      radial-gradient(1px 1px at 50% 60%, white, transparent);
    z-index: 0;
  }

  /* --------------------------------------------------------------------------
   * Content stack. Holds HeroIntro (which renders its own h1) + tagline +
   * CTAs. We keep it as a flex column so the cascade flows naturally and
   * the CTAs sit on a horizontal row at the bottom.
   *
   * `position: relative; z-index: 1` keeps the content above .hero__stars
   * (z-index 0) and .hero__ambient (z-index -1).
   * ------------------------------------------------------------------------ */
  .hero__content {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(44px, 5vw, 64px);
    align-items: center;
  }

  @media (min-width: 920px) {
    .hero__content {
      grid-template-columns: minmax(0, 1fr) minmax(300px, 350px);
    }
  }

  .hero__copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .hero__copy :global(.hero__title) {
    font-size: clamp(3rem, 7vw, 5.25rem);
  }

  /* --------------------------------------------------------------------------
   * Tagline / subhead. DESIGN.md §8 dictates Inter 18-20px, --text-2. We use
   * --text-lg (20px) and the relaxed leading from global.css.
   *
   * Reveal: pre-applied `.is-visible` (above-the-fold), but with a
   * `transition-delay` so it lands AFTER the HeroIntro cascade finishes
   * (~580ms for 4 lines + 100ms baseline). 700ms keeps a gentle gap.
   * ------------------------------------------------------------------------ */
  .hero__tagline {
    max-width: 640px;
    margin-top: 32px;
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--text-2);
    text-wrap: pretty;
    transition-delay: 700ms;
  }

  /* --------------------------------------------------------------------------
   * CTA row. DESIGN.md §8: primary uses gradient + glow on focus; secondary
   * is outline-only. Gap follows the 12px spacing token (`--spacing` × 3).
   *
   * Reveal: same pattern as tagline, with a slightly larger delay so the
   * CTAs land last in the choreography.
   * ------------------------------------------------------------------------ */
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
    transition-delay: 900ms;
  }

  .hero__proof {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    max-width: 680px;
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
  }

  .hero__proof-item {
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    background: color-mix(in oklch, var(--color-bg-1) 58%, transparent);
    border: 1px solid color-mix(in oklch, var(--border) 78%, transparent);
    border-radius: var(--radius-lg);
  }

  .hero__proof-item strong {
    color: var(--text-0);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1;
  }

  .hero__proof-item span {
    color: var(--text-3);
    font-size: var(--text-xs);
    line-height: 1.35;
  }

  /* --------------------------------------------------------------------------
   * CTA — shared base. Two variants follow:
   *   .cta--primary   → gradient + glow (DESIGN.md §3 + §8 "CTA primario")
   *   .cta--secondary → outline + accent on hover
   *
   * Inline-flex for vertical alignment of any future icon. JetBrains Mono is
   * reserved for tech metadata (DESIGN.md §4); CTAs use Inter 500 for the
   * cleaner, action-y feel.
   * ------------------------------------------------------------------------ */
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 24px;
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.005em;
    text-decoration: none;
    border-radius: var(--radius-md);
    transition:
      background var(--motion-duration-fast) var(--motion-ease-out),
      border-color var(--motion-duration-fast) var(--motion-ease-out),
      color var(--motion-duration-fast) var(--motion-ease-out),
      box-shadow var(--motion-duration-fast) var(--motion-ease-out),
      transform var(--motion-duration-fast) var(--motion-ease-out);
    will-change: transform;
  }

  /* --- Primary --------------------------------------------------------- */
  .cta--primary {
    color: var(--text-0);
    background: var(--gradient-cta);
    border: 1px solid transparent;
    background-size: 200% 200%;
    background-position: 0% 50%;
  }

  .cta--primary:hover {
    background: var(--gradient-cta-hover);
    background-size: 200% 200%;
    background-position: 100% 50%;
    transform: translateY(-1px);
  }

  .cta--primary:focus-visible {
    outline: none;
    box-shadow: var(--shadow-glow);
  }

  /* --- Secondary ------------------------------------------------------- */
  .cta--secondary {
    color: var(--text-1);
    background: transparent;
    border: 1px solid var(--border);
  }

  .cta--secondary:hover {
    color: var(--text-0);
    border-color: var(--accent-400);
    transform: translateY(-1px);
  }

  .cta--secondary:focus-visible {
    outline: none;
    border-color: var(--accent-400);
    box-shadow: var(--shadow-glow);
  }

  .hero__panel {
    position: relative;
    display: grid;
    gap: 22px;
    padding: clamp(22px, 3vw, 28px);
    background: color-mix(in oklch, var(--color-bg-1) 88%, transparent);
    border: 1px solid color-mix(in oklch, var(--accent-400) 20%, var(--border));
    border-radius: var(--radius-2xl);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.36);
    transition-delay: 760ms;
  }

  .hero__panel::before {
    content: '';
    position: absolute;
    inset: 14px 14px auto;
    height: 1px;
    background: color-mix(in oklch, var(--accent-400) 34%, transparent);
    opacity: 0.7;
  }

  .hero__panel-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .hero__panel-kicker {
    color: var(--accent-300);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__panel-dot {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
    background: var(--accent-400);
    box-shadow: 0 0 0 6px var(--accent-glow);
  }

  .hero__panel-body {
    display: grid;
    gap: 12px;
  }

  .hero__panel-title {
    margin: 0;
    color: var(--text-0);
    font-size: clamp(1.75rem, 3vw, 2.4375rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: var(--tracking-tighter);
  }

  .hero__panel-description {
    margin: 0;
    color: var(--text-2);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .hero__panel-list {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__panel-list li {
    display: flex;
    gap: 10px;
    align-items: center;
    color: var(--text-1);
    font-size: var(--text-sm);
  }

  .hero__panel-list span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    flex: 0 0 auto;
    border-radius: var(--radius-full);
    background: color-mix(in oklch, var(--accent-400) 14%, transparent);
    color: var(--accent-300);
    font-size: var(--text-xs);
  }

  .hero__panel-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 16px;
    color: var(--text-0);
    background: color-mix(in oklch, var(--accent-500) 28%, var(--bg-2));
    border: 1px solid color-mix(in oklch, var(--accent-400) 30%, transparent);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition:
      border-color var(--motion-fast) var(--motion-ease-out),
      background var(--motion-fast) var(--motion-ease-out),
      transform var(--motion-fast) var(--motion-ease-out);
  }

  .hero__panel-cta:hover,
  .hero__panel-cta:focus-visible {
    background: color-mix(in oklch, var(--accent-500) 36%, var(--bg-2));
    border-color: var(--accent-400);
    transform: translateY(-1px);
  }

  /* --------------------------------------------------------------------------
   * Mobile tightens the rhythm: tagline gets less margin, CTAs stack a bit
   * more aggressively while staying inline if there is room.
   * ------------------------------------------------------------------------ */
  @media (max-width: 640px) {
    .hero__content {
      gap: 40px;
    }
    .hero__tagline {
      margin-top: 24px;
      font-size: var(--text-base);
    }
    .hero__ctas {
      margin-top: 32px;
    }
    .cta {
      flex: 1 1 auto;
    }
    .hero__proof {
      grid-template-columns: 1fr;
      margin-top: 28px;
    }
  }
</style>
