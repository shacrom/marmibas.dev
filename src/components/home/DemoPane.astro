---
/**
 * DemoPane.astro — Home "interactive demo" pane (T5 terminal redesign).
 *
 * Renders the THIRD home `TerminalPane` (`~/demo`, `[3/7]`), replacing the
 * pre-terminal `ShowcaseSection.astro`. Three bordered sub-panes matching
 * `DemoTerminal.dc.html` (desktop 1440) / `DemoTerminalMovil.dc.html`
 * (mobile 390) — the read-only visual + behaviour spec under the design
 * scratchpad (inline styles AND the embedded `<script type="text/x-dc">`
 * logic are both authoritative):
 *   1. Planta — machine monitor: start/stop toggle, live per-second
 *      counters, production/stops summary.
 *   2. Documentos — quote lines with checkboxes, an eased total tween, and
 *      a fake "Generar PDF" busy → done → idle button.
 *   3. Excel → App — segmented toggle between a decorative broken
 *      spreadsheet mock and a real filterable table.
 *
 * Copy is reused VERBATIM from the pre-terminal `ShowcaseSection.astro`
 * (`eyebrow`/`heading`/`sub`, `panels[].title/desc`, `machines.*`,
 * `management.*`, `data.*` minus the sort control below) — nothing
 * invented except decorative terminal framing strings (the `./demo …`
 * prompt, each sub-pane's `path/` bar label + status text, the `Vista`
 * toggle group label, and `buscar>`), all consts local to this component
 * (same convention as `HeroPane`/`ServicesPane`).
 *
 * DROPPED vs `ShowcaseSection.astro`: the "sort by amount" `<select>`. It
 * has no equivalent anywhere in the approved mockup's table (search + date
 * filter only) — keeping it would be inventing a control the design never
 * asked for. `sortLabel`/`sortHighToLow`/`sortLowToHigh` in the old copy
 * object are therefore unused by this component (the underlying i18n keys
 * live in `ShowcaseSection.astro`'s own local copy object, not `ui.ts`, so
 * nothing needs deleting there — see T5's task report for the full note).
 *
 * All pure calculation used by the client script below lives in
 * `src/lib/showcase-demo.ts` (TDD, no DOM) — this component only wires
 * that logic to real markup/events. `formatThousands` there is
 * deliberately locale-INVARIANT (always dot-grouped, "es-ES style" per its
 * own contract) — a direct port of the mockup's own hardcoded `fmt()`.
 * English was removed (site is Spanish-only — see
 * `odd/tasks/site-cleanup.md` C2); `lang` stays typed for a future locale.
 *
 * Architecture note vs the mockup's own re-render approach: the mockup's
 * `<script type="text/x-dc">` re-templates the ENTIRE row/line list on
 * every state change (hence its `interacted` flag, which suppresses the
 * entrance-cascade delay on re-renders so already-shown rows don't replay
 * their slide-in). This component instead renders every row ONCE
 * server-side and only ever toggles `hidden`/text on the SAME existing
 * DOM nodes — so the entrance animation naturally never replays (it
 * already finished), and no `interacted`-style flag is needed at all.
 *
 * Progressive enhancement: the server-rendered HTML already shows the
 * complete initial state (2 running + 1 stopped machine with correct
 * meters, all 3 quote lines checked with the correct total, the "App"
 * view with the full unfiltered table). The client `<script>` only adds
 * the choreography (toggles, live counters, tweened total, PDF sequence,
 * view switch, search/date filtering) on top; without JS every control is
 * a real, visible, static element and the demo remains fully readable.
 */

import TerminalPane from '../terminal/TerminalPane.astro';
import Prompt from '../terminal/Prompt.astro';
import { docTotal, formatThousands, productionTotal, stopsCount } from '../../lib/showcase-demo';
import type { Language } from '../../i18n/ui';

export interface Props {
  /** Active language. Drives heading + copy + framing strings. */
  lang: Language;
}

const { lang } = Astro.props as Props;

const fmtMeters = (n: number): string => `${formatThousands(n)} m`;
const fmtCurrency = (n: number): string => `${formatThousands(n)} €`;

// --- Decorative terminal framing (new copy, local to this component — see
// docblock above for why not ui.ts). ---------------------------------------
const promptCommand: Record<Language, string> = {
  es: './demo --datos-ficticios',
};

const subPanePaths: Record<Language, { machines: string; doc: string; data: string }> = {
  es: { machines: 'planta/', doc: 'documentos/', data: 'excel-a-app/' },
};

const realtimeLabel: Record<Language, string> = { es: 'tiempo real' };
const viewGroupLabel: Record<Language, string> = { es: 'Vista' };
const searchPromptGlyph: Record<Language, string> = { es: 'buscar>' };
const docNumber = '#2026-041';

// --- Real copy, reused verbatim from the pre-terminal ShowcaseSection.astro
// (sort-related keys dropped — see docblock). ------------------------------
const copy = {
  es: {
    eyebrow: 'Demostración interactiva',
    heading: 'Así se ven las pantallas de una aplicación',
    sub: 'Paneles de demostración con datos ficticios: esto es lo que tu equipo vería en pantalla.',
    panels: [
      {
        title: 'Planta industrial en tiempo real',
        desc: 'Monitoriza máquinas y producción en tiempo real, sin pasear con la libreta.',
      },
      {
        title: 'Gestión documental',
        desc: 'Presupuestos, facturas y contratos que se calculan solos y salen con tu marca.',
      },
      {
        title: 'Del Excel a la aplicación',
        desc: 'Sustituye hojas de cálculo frágiles por una aplicación que cualquiera puede usar.',
      },
    ],
    machines: {
      names: ['Telar V1', 'Telar V2', 'Madejera M1'],
      stop: 'Parar',
      start: 'Arrancar',
      summaryProduction: 'Producción hoy',
      summaryStops: 'Paradas',
    },
    management: {
      docTitle: 'Presupuesto #2026-041',
      status: 'Aceptado',
      includeLine: 'Incluir partida',
      lines: [
        { label: 'Diseño e implementación', amount: 3200 },
        { label: 'Integración con TPV', amount: 950 },
        { label: 'Soporte primer mes', amount: 700 },
      ],
      totalLabel: 'Total',
      pdfIdle: 'Generar PDF',
      pdfDone: 'PDF listo ✓',
    },
    data: {
      viewBefore: 'Antes · Excel',
      viewAfter: 'Ahora · App',
      searchLabel: 'Buscar cliente o producto',
      searchPlaceholder: 'Cliente · Producto…',
      dateFilterLabel: 'Filtrar por fecha',
      dateFilterAll: 'Todas las fechas',
      noResults: 'Sin resultados',
      statsLabel: 'Resumen del tablero',
      stats: [
        { label: 'Ventas mes', value: '8.240 €' },
        { label: 'Pedidos abiertos', value: '14' },
        { label: 'Errores evitados', value: '7' },
      ],
      chartTitle: 'Ventas por semana',
      headers: ['Cliente', 'Producto', 'Fecha', 'Total', 'Estado'],
      dateOptions: [
        { value: 'Hoy', label: 'Hoy' },
        { value: 'Ayer', label: 'Ayer' },
        { value: 'Semana', label: 'Semana' },
      ],
      rows: [
        { client: 'Ferretería Solá', product: 'Tornillería M6', date: 'Hoy', amount: 1240, status: 'Listo' },
        { client: 'Grupo Ánfora', product: 'Tornillería M8', date: 'Semana', amount: 1180, status: 'Listo' },
        {
          client: 'Mueblex S.L.',
          product: 'Bisagra reforzada',
          date: 'Hoy',
          amount: 860,
          status: 'Pendiente',
        },
        {
          client: 'Distribuciones Rus',
          product: 'Perfil aluminio',
          date: 'Ayer',
          amount: 650,
          status: 'Listo',
        },
        {
          client: 'Talleres Camps',
          product: 'Chapa galvanizada',
          date: 'Ayer',
          amount: 420,
          status: 'Revisar',
        },
      ],
      chart: [42, 66, 54, 86],
      // Deliberately simple spreadsheet with obvious problems — 5 columns × 5
      // rows, flat list. Cells starting with '#' render as broken-formula
      // error cells; cells equal to 'Duplicado' render as duplicate-warning
      // cells (see `isErrorCell`/`isDuplicateCell` below).
      excel: [
        'Cliente', 'Producto', 'Cant.', 'Precio', 'Estado',
        'Ferretería Solá', 'Tornillos', '120', '54 €', 'Pendiente',
        'Mueblex', 'Bisagras', '80', '#ERROR', 'Revisar',
        'Talleres Camps', 'Chapa', '25', '310 €', 'OK',
        'Grupo Ánfora', 'Tornillos', '140', 'Duplicado', 'Duplicado',
      ],
    },
  },
} as const;

const content = copy[lang];
const duplicateCellText = 'Duplicado';
const isErrorCell = (cell: string): boolean => cell.startsWith('#');
const isDuplicateCell = (cell: string): boolean => cell === duplicateCellText;

/**
 * Panel 1 initial state. Matches the spec's own default machine
 * state/counts exactly (`running: [true, true, false]`,
 * `counts: [1240, 980, 0]`, `base production 1262`, `base stops 1`).
 */
const MACHINE_RUNNING = [true, true, false] as const;
const MACHINE_METERS = [1240, 980, 0] as const;
const BASE_PRODUCTION = 1262;
const BASE_STOPS = 1;

const initialProduction = productionTotal(MACHINE_METERS, BASE_PRODUCTION);
const initialStops = stopsCount(MACHINE_RUNNING, BASE_STOPS);

// Panel 2 initial state: all 3 lines checked (matches `lines: [true, true, true]`).
const LINE_CHECKED = [true, true, true] as const;
const lineAmounts = content.management.lines.map((line) => line.amount);
const initialTotal = docTotal(lineAmounts, LINE_CHECKED);

const machinesTitleId = 'demo-machines-title';
const docTitleId = 'demo-doc-title';
const dataTitleId = 'demo-data-title';
---

<TerminalPane path="demo" index="3/7" labelledby="demo-heading" class="t-pane-gutter">
  <div class="demo-pane" data-demo data-base-production={String(BASE_PRODUCTION)} data-base-stops={String(BASE_STOPS)}>
    <Prompt command={promptCommand[lang]} delay={200} duration={600} />

    <div class="demo-pane__heading-block t-show" style="--t-delay: 850ms;">
      <div class="demo-pane__heading-col">
        <p class="t-comment demo-pane__eyebrow"># {content.eyebrow}</p>
        <h2 id="demo-heading" class="demo-pane__heading">{content.heading}</h2>
      </div>
      <p class="demo-pane__sub">{content.sub}</p>
    </div>

    <div class="demo-pane__panels t-fade" style="--t-delay: 950ms;">
      {/* --------------------------------------------------------------
       * Sub-pane 1 — Planta / shop floor
       * ------------------------------------------------------------ */}
      <article class="demo-panel" aria-labelledby={machinesTitleId}>
        <div class="demo-panel__bar">
          <span>{subPanePaths[lang].machines}</span>
          <span class="demo-panel__bar-status">
            <span class="t-led" aria-hidden="true"></span>
            {realtimeLabel[lang]}
          </span>
        </div>

        <div class="demo-panel__body">
          <h3 id={machinesTitleId} class="demo-panel__title">{content.panels[0].title}</h3>

          <ul class="demo-machines" role="list">
            {
              content.machines.names.map((name, i) => {
                const running = MACHINE_RUNNING[i] ?? false;
                const meters = MACHINE_METERS[i] ?? 0;
                const labelStop = `[ ${content.machines.stop} ]`;
                const labelStart = `[ ${content.machines.start} ]`;
                return (
                  <li
                    class="demo-machine t-slide"
                    style={`--t-delay: ${1000 + i * 80}ms;`}
                    data-machine
                    data-state={running ? 'running' : 'stopped'}
                    data-meters={String(meters)}
                  >
                    <span
                      class:list={['demo-machine__led', { 't-led': running }]}
                      aria-hidden="true"
                    />
                    <span class="demo-machine__name">{name}</span>
                    <span class="demo-machine__bar" aria-hidden="true"
                      >[<span
                        class:list={['demo-machine__bar-fill', { 't-stripes': running }]}
                        data-machine-bar-fill
                      />]</span
                    >
                    <span class="demo-machine__meters" data-machine-meters>{fmtMeters(meters)}</span>
                    <button
                      type="button"
                      class="demo-machine__toggle"
                      data-machine-toggle
                      aria-pressed={running ? 'true' : 'false'}
                      data-label-stop={labelStop}
                      data-label-start={labelStart}
                    >
                      {running ? labelStop : labelStart}
                    </button>
                  </li>
                );
              })
            }
          </ul>

          <!-- No aria-live: these figures tick every second while visible and
               would flood screen readers; they are read on demand instead. -->
          <div class="demo-machines__summary">
            <div class="demo-machines__stat">
              <span class="demo-machines__stat-label">{content.machines.summaryProduction}</span>
              <span class="demo-machines__stat-value" data-production>{fmtMeters(initialProduction)}</span>
            </div>
            <div class="demo-machines__stat">
              <span class="demo-machines__stat-label">{content.machines.summaryStops}</span>
              <span class="demo-machines__stat-value" data-stops>{String(initialStops)}</span>
            </div>
          </div>
        </div>

        <p class="t-comment demo-panel__footer"># {content.panels[0].desc}</p>
      </article>

      {/* --------------------------------------------------------------
       * Sub-pane 2 — Documentos / quote
       * ------------------------------------------------------------ */}
      <article class="demo-panel" aria-labelledby={docTitleId}>
        <div class="demo-panel__bar">
          <span>{subPanePaths[lang].doc}</span>
          <span class="demo-panel__bar-status demo-panel__bar-status--accent">{docNumber}</span>
        </div>

        <div class="demo-panel__body">
          <h3 id={docTitleId} class="demo-panel__title">{content.panels[1].title}</h3>

          <div class="demo-doc__head">
            <span class="demo-doc__name">{content.management.docTitle}</span>
            <span class="demo-doc__status">[ {content.management.status} ]</span>
          </div>

          <div class="demo-doc__lines" role="group" aria-label={content.management.includeLine}>
            {
              content.management.lines.map((line, i) => (
                <label
                  class:list={['demo-doc__line', 't-slide']}
                  style={`--t-delay: ${1000 + i * 80}ms;`}
                  data-doc-line
                  data-amount={String(line.amount)}
                >
                  <input type="checkbox" checked data-doc-checkbox />
                  <span class="demo-doc__label">{line.label}</span>
                  <span class="demo-doc__leader" aria-hidden="true" />
                  <span class="demo-doc__amount">{fmtCurrency(line.amount)}</span>
                </label>
              ))
            }
          </div>

          <div class="demo-doc__total">
            <span class="demo-doc__total-label">{content.management.totalLabel}</span>
            <span class="demo-doc__total-value" aria-live="polite" data-doc-total
              >{fmtCurrency(initialTotal)}</span
            >
          </div>

          <button
            type="button"
            class="demo-doc__pdf"
            data-pdf-button
            data-label-idle={`[ ${content.management.pdfIdle} ]`}
            data-label-done={content.management.pdfDone}
          >
            [ {content.management.pdfIdle} ]
          </button>
        </div>

        <p class="t-comment demo-panel__footer"># {content.panels[1].desc}</p>
      </article>

      {/* --------------------------------------------------------------
       * Sub-pane 3 — Excel → App (spans both columns on desktop)
       * ------------------------------------------------------------ */}
      <article class="demo-panel demo-panel--wide" aria-labelledby={dataTitleId}>
        <div class="demo-panel__bar">
          <span>{subPanePaths[lang].data}</span>
          <span class="demo-panel__bar-status">{content.data.statsLabel}</span>
        </div>

        <div class="demo-panel__body">
          <div class="demo-data__head">
            <h3 id={dataTitleId} class="demo-panel__title">{content.panels[2].title}</h3>

            <div class="demo-segment" role="group" aria-label={viewGroupLabel[lang]}>
              <span class="demo-segment__indicator" aria-hidden="true" data-view-indicator />
              <button type="button" data-view-toggle="excel" aria-pressed="false">
                {content.data.viewBefore}
              </button>
              <button type="button" data-view-toggle="app" aria-pressed="true">
                {content.data.viewAfter}
              </button>
            </div>
          </div>

          {/* "App" view — the real, filterable table. Default/visible. */}
          <div class="demo-view" data-view="app">
            <div class="demo-app">
              <div class="demo-app__stats" role="list" aria-label={content.data.statsLabel}>
                {
                  content.data.stats.map((stat) => (
                    <div class="demo-app__stat" role="listitem">
                      <span class="demo-app__stat-label">{stat.label}</span>
                      <span class="demo-app__stat-leader" aria-hidden="true" />
                      <span class="demo-app__stat-value">{stat.value}</span>
                    </div>
                  ))
                }
              </div>

              <div class="demo-app__chart">
                <span class="demo-app__chart-title">{content.data.chartTitle}</span>
                <div class="demo-app__bars" aria-hidden="true">
                  {
                    content.data.chart.map((value, i) => (
                      <span
                        class="demo-app__bar t-grow"
                        style={`--bar-value: ${value}%; --t-delay: ${1200 + i * 80}ms;`}
                      />
                    ))
                  }
                </div>
              </div>

              <div class="demo-app__controls">
                <label class="demo-app__search">
                  <span class="demo-app__search-glyph" aria-hidden="true">{searchPromptGlyph[lang]}</span>
                  <span class="demo-pane__sr-only">{content.data.searchLabel}</span>
                  <input
                    type="search"
                    data-search-input
                    placeholder={content.data.searchPlaceholder}
                  />
                </label>
                <label class="demo-app__date">
                  <span class="demo-pane__sr-only">{content.data.dateFilterLabel}</span>
                  <select data-date-select>
                    <option value="all">{content.data.dateFilterAll}</option>
                    {
                      content.data.dateOptions.map((option) => (
                        <option value={option.value}>{option.label}</option>
                      ))
                    }
                  </select>
                </label>
              </div>

              <table class="demo-table" data-demo-table>
                <colgroup>
                  <col style="width: 27%;" />
                  <col style="width: 25%;" />
                  <col style="width: 14%;" />
                  <col style="width: 16%;" />
                  <col style="width: 18%;" />
                </colgroup>
                <thead>
                  <tr>
                    {content.data.headers.map((header) => <th scope="col">{header}</th>)}
                  </tr>
                </thead>
                <tbody data-table-body>
                  {
                    content.data.rows.map((row, i) => (
                      <tr
                        class="t-slide"
                        style={`--t-delay: ${1150 + i * 70}ms;`}
                        data-table-row
                        data-client={row.client}
                        data-product={row.product}
                        data-date={row.date}
                        data-amount={String(row.amount)}
                        data-status={row.status}
                      >
                        <td>{row.client}</td>
                        <td>{row.product}</td>
                        <td>{row.date}</td>
                        <td>{fmtCurrency(row.amount)}</td>
                        <td>[{row.status}]</td>
                      </tr>
                    ))
                  }
                  <tr data-table-empty hidden>
                    <td colspan="5">{content.data.noResults}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          {/* "Excel" view — decorative broken-spreadsheet mock. Never
              exposed to assistive tech (the App table above already
              carries the same data accessibly); its markup is only
              cloned from `<template>` the FIRST time a visitor selects
              it, matching the brief's "only rendered … when selected"
              and, as a side effect, letting the glitch flicker replay
              fresh whenever this view is first opened rather than firing
              once at page load while still hidden. */}
          <div class="demo-view" data-view="excel" hidden aria-hidden="true">
            <template data-excel-template>
              <div class="demo-excel">
                {
                  content.data.excel.map((cell, i) => (
                    <span
                      class:list={[
                        'demo-excel__cell',
                        { 'demo-excel__cell--header': i < 5 },
                        { 'demo-excel__cell--error': isErrorCell(cell) },
                        { 'demo-excel__cell--duplicate': isDuplicateCell(cell) },
                      ]}
                    >
                      {isErrorCell(cell) || isDuplicateCell(cell) ? (
                        <span class="t-glitch" style={isDuplicateCell(cell) ? '--t-delay: 700ms;' : undefined}>
                          {cell}
                        </span>
                      ) : (
                        cell
                      )}
                    </span>
                  ))
                }
              </div>
            </template>
          </div>
        </div>

        <p class="t-comment demo-panel__footer"># {content.panels[2].desc}</p>
      </article>
    </div>
  </div>
</TerminalPane>

<script>
  import {
    docTotal,
    filterRows,
    formatThousands,
    pdfProgressLabel,
    productionTotal,
    stopsCount,
    tickCounts,
    tweenValue,
    type DemoTableRow,
  } from '../../lib/showcase-demo';

  /**
   * Interactive demo pane driver. Progressive enhancement over a complete
   * server-rendered initial state (see the component docblock). Re-runs on
   * `astro:page-load` (View Transitions) with a per-pane init guard, and
   * clears every interval/timeout/rAF on `astro:before-swap` — same
   * lifecycle pattern as `TerminalPane.astro`/`Reveal.astro`, extended with
   * explicit teardown since this pane, unlike those, owns timers.
   */

  const RATES = [3, 2, 1];
  const TICK_MS = 1000;
  const PDF_STEP_MS = 110;
  const PDF_STEP_PCT = 10;
  const PDF_DONE_HOLD_MS = 1600;
  const TWEEN_MS = 450;

  const activeCleanups: Array<() => void> = [];

  function prefersReducedMotion(): boolean {
    return (
      typeof window !== 'undefined' && window.matchMedia('(prefers-reduced-motion: reduce)').matches
    );
  }

  function isRoughlyInViewport(el: HTMLElement): boolean {
    const rect = el.getBoundingClientRect();
    const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
    return rect.top < viewportHeight && rect.bottom > 0;
  }

  function setupDemoPane(root: HTMLElement): void {
    if (root.dataset.demoInit) return;
    root.dataset.demoInit = '1';

    // Spanish is the only locale (see `odd/tasks/site-cleanup.md` C2), so
    // currency/meter formatting no longer branches by language.
    const fmtCurrency = (n: number) => `${formatThousands(n)} €`;
    const fmtMeters = (n: number) => `${formatThousands(n)} m`;

    /* ---------------------------------------------------------------- */
    /* Panel 1 — machines: toggle, live per-second counters, summary.     */
    /* ---------------------------------------------------------------- */
    const baseProduction = Number(root.dataset.baseProduction) || 0;
    const baseStops = Number(root.dataset.baseStops) || 0;
    const machineEls = Array.from(root.querySelectorAll<HTMLElement>('[data-machine]'));
    const running = machineEls.map((el) => el.dataset.state === 'running');
    const counts = machineEls.map((el) => Number(el.dataset.meters) || 0);
    const productionEl = root.querySelector<HTMLElement>('[data-production]');
    const stopsEl = root.querySelector<HTMLElement>('[data-stops]');

    function paintMachines(): void {
      machineEls.forEach((el, i) => {
        const metersEl = el.querySelector<HTMLElement>('[data-machine-meters]');
        if (metersEl) metersEl.textContent = fmtMeters(counts[i] ?? 0);
      });
      if (productionEl) productionEl.textContent = fmtMeters(productionTotal(counts, baseProduction));
      if (stopsEl) stopsEl.textContent = String(stopsCount(running, baseStops));
    }

    machineEls.forEach((el, i) => {
      const toggle = el.querySelector<HTMLButtonElement>('[data-machine-toggle]');
      const barFill = el.querySelector<HTMLElement>('[data-machine-bar-fill]');
      const ledEl = el.querySelector<HTMLElement>('.demo-machine__led');
      toggle?.addEventListener('click', () => {
        running[i] = !running[i];
        el.dataset.state = running[i] ? 'running' : 'stopped';
        toggle.setAttribute('aria-pressed', String(running[i]));
        toggle.textContent = running[i]
          ? (toggle.dataset.labelStop ?? '')
          : (toggle.dataset.labelStart ?? '');
        barFill?.classList.toggle('t-stripes', running[i]);
        ledEl?.classList.toggle('t-led', running[i]);
        paintMachines();
      });
    });

    let tickTimer: number | undefined;
    function startTicking(): void {
      if (tickTimer !== undefined) return;
      tickTimer = window.setInterval(() => {
        const next = tickCounts(counts, running, RATES);
        for (let i = 0; i < counts.length; i += 1) {
          const value = next[i];
          if (value !== undefined) counts[i] = value;
        }
        paintMachines();
      }, TICK_MS);
    }
    function stopTicking(): void {
      if (tickTimer === undefined) return;
      window.clearInterval(tickTimer);
      tickTimer = undefined;
    }

    let paneInViewport = isRoughlyInViewport(root);
    function refreshTicking(): void {
      if (paneInViewport && !document.hidden) startTicking();
      else stopTicking();
    }

    if (typeof IntersectionObserver !== 'undefined') {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) paneInViewport = entry.isIntersecting;
          refreshTicking();
        },
        { threshold: 0.1 }
      );
      io.observe(root);
      activeCleanups.push(() => io.disconnect());
    }
    const onVisibilityChange = () => refreshTicking();
    document.addEventListener('visibilitychange', onVisibilityChange);
    activeCleanups.push(() => document.removeEventListener('visibilitychange', onVisibilityChange));
    refreshTicking();
    activeCleanups.push(stopTicking);

    /* ---------------------------------------------------------------- */
    /* Panel 2 — quote lines: checkbox -> eased total tween, PDF button.  */
    /* ---------------------------------------------------------------- */
    const docLines = Array.from(root.querySelectorAll<HTMLElement>('[data-doc-line]'));
    const totalEl = root.querySelector<HTMLElement>('[data-doc-total]');
    let shownTotal = docLines.reduce(
      (sum, line) => sum + (line.querySelector<HTMLInputElement>('input')?.checked ? Number(line.dataset.amount) || 0 : 0),
      0
    );
    let tweenRaf: number | undefined;

    function currentAmounts(): number[] {
      return docLines.map((line) => Number(line.dataset.amount) || 0);
    }
    function currentChecked(): boolean[] {
      return docLines.map((line) => line.querySelector<HTMLInputElement>('input')?.checked ?? false);
    }

    function tweenTotalTo(target: number): void {
      if (tweenRaf !== undefined) {
        window.cancelAnimationFrame(tweenRaf);
        tweenRaf = undefined;
      }
      if (prefersReducedMotion()) {
        shownTotal = target;
        if (totalEl) totalEl.textContent = fmtCurrency(shownTotal);
        return;
      }
      const from = shownTotal;
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / TWEEN_MS);
        shownTotal = tweenValue(from, target, t);
        if (totalEl) totalEl.textContent = fmtCurrency(shownTotal);
        tweenRaf = t < 1 ? window.requestAnimationFrame(step) : undefined;
      };
      tweenRaf = window.requestAnimationFrame(step);
    }

    docLines.forEach((line) => {
      const checkbox = line.querySelector<HTMLInputElement>('input[type="checkbox"]');
      checkbox?.addEventListener('change', () => {
        line.classList.toggle('is-excluded', !checkbox.checked);
        tweenTotalTo(docTotal(currentAmounts(), currentChecked()));
      });
    });
    activeCleanups.push(() => {
      if (tweenRaf !== undefined) window.cancelAnimationFrame(tweenRaf);
    });

    const pdfButton = root.querySelector<HTMLButtonElement>('[data-pdf-button]');
    let pdfTimer: number | undefined;
    let pdfHoldTimer: number | undefined;
    pdfButton?.addEventListener('click', () => {
      if (pdfButton.disabled) return;
      pdfButton.disabled = true;
      let pct = 0;
      pdfButton.textContent = pdfProgressLabel(pct);
      pdfTimer = window.setInterval(() => {
        pct += PDF_STEP_PCT;
        if (pct >= 100) {
          window.clearInterval(pdfTimer);
          pdfTimer = undefined;
          pdfButton.textContent = pdfButton.dataset.labelDone ?? '';
          pdfHoldTimer = window.setTimeout(() => {
            pdfButton.textContent = pdfButton.dataset.labelIdle ?? '';
            pdfButton.disabled = false;
            pdfHoldTimer = undefined;
          }, PDF_DONE_HOLD_MS);
        } else {
          pdfButton.textContent = pdfProgressLabel(pct);
        }
      }, PDF_STEP_MS);
    });
    activeCleanups.push(() => {
      if (pdfTimer !== undefined) window.clearInterval(pdfTimer);
      if (pdfHoldTimer !== undefined) window.clearTimeout(pdfHoldTimer);
    });

    /* ---------------------------------------------------------------- */
    /* Panel 3 — Excel/App segmented toggle + table search/date filter.   */
    /* ---------------------------------------------------------------- */
    const segmentButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-view-toggle]')
    );
    const indicator = root.querySelector<HTMLElement>('[data-view-indicator]');
    const appViewEl = root.querySelector<HTMLElement>('[data-view="app"]');
    const excelViewEl = root.querySelector<HTMLElement>('[data-view="excel"]');
    const excelTemplate = excelViewEl?.querySelector<HTMLTemplateElement>('[data-excel-template]');

    function setView(target: string): void {
      for (const button of segmentButtons) {
        button.setAttribute('aria-pressed', String(button.dataset.viewToggle === target));
      }
      if (indicator) indicator.style.transform = target === 'app' ? 'translateX(100%)' : 'translateX(0%)';
      if (appViewEl) appViewEl.hidden = target !== 'app';
      if (excelViewEl) {
        excelViewEl.hidden = target !== 'excel';
        if (target === 'excel' && excelTemplate && !excelViewEl.dataset.populated) {
          excelViewEl.appendChild(excelTemplate.content.cloneNode(true));
          excelViewEl.dataset.populated = '1';
        }
      }
    }

    for (const button of segmentButtons) {
      button.addEventListener('click', () => setView(button.dataset.viewToggle ?? 'app'));
    }

    const searchInput = root.querySelector<HTMLInputElement>('[data-search-input]');
    const dateSelect = root.querySelector<HTMLSelectElement>('[data-date-select]');
    const tableRows = Array.from(root.querySelectorAll<HTMLElement>('[data-table-row]'));
    const emptyRow = root.querySelector<HTMLElement>('[data-table-empty]');
    const allRows: DemoTableRow[] = tableRows.map((row) => ({
      client: row.dataset.client ?? '',
      product: row.dataset.product ?? '',
      date: row.dataset.date ?? '',
      amount: Number(row.dataset.amount) || 0,
      status: row.dataset.status ?? '',
    }));

    function applyTableFilter(): void {
      const query = searchInput?.value ?? '';
      const date = dateSelect?.value ?? 'all';
      const visible = filterRows(allRows, query, date);
      tableRows.forEach((row, i) => {
        row.hidden = !visible.includes(allRows[i] as DemoTableRow);
      });
      if (emptyRow) emptyRow.hidden = visible.length > 0;
    }

    searchInput?.addEventListener('input', applyTableFilter);
    dateSelect?.addEventListener('change', applyTableFilter);
  }

  function initAllDemoPanes(): void {
    document.querySelectorAll<HTMLElement>('[data-demo]').forEach(setupDemoPane);
  }

  initAllDemoPanes();
  document.addEventListener('astro:page-load', initAllDemoPanes);
  document.addEventListener('astro:before-swap', () => {
    activeCleanups.forEach((cleanup) => cleanup());
    activeCleanups.length = 0;
  });
</script>

