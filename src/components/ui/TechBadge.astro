---
/**
 * TechBadge.astro — chip de stack técnico (T-25).
 *
 * Pequeño badge inline con tipografía mono (JetBrains Mono 12px / 500),
 * pensado para listar tecnologías (Astro, Angular, Supabase, ...) en cards,
 * heroes de case study y bloques de skills.
 *
 * Variantes (DESIGN.md §8 — anclas visuales del featured project card y
 * project card normal):
 *
 * - `default` (firma morada): superficie tintada con `--color-accent-100`
 *   muy diluido, texto `--color-accent-300`, borde sutil `--color-accent-400`.
 *   Es el badge que aparece en featured cards / case study heroes.
 *
 * - `subtle` (neutro): sin tinte de marca, solo borde y texto secundarios.
 *   Para listas de stack en cards normales o lugares donde el morado
 *   competiría con elementos vecinos (status pills, CTAs).
 *
 * Pure server-rendered: sin script, sin estado, sin JS cliente. El componente
 * solo emite un `<span>` con clases scoped.
 *
 * Spec: TASKS.md T-25 + DESIGN.md §4 (tipografía mono) + §8 (chips de stack).
 */

type Variant = 'default' | 'subtle';

export interface Props {
  /** Texto del badge (ej. "Astro", "Supabase"). */
  label: string;
  /** Variante visual. `default` (morado tinted) o `subtle` (neutro). */
  variant?: Variant;
  /** Clases extra a mergear con el wrapper. */
  class?: string;
}

const { label, variant = 'default', class: className } = Astro.props;

const classes = ['tech-badge', `tech-badge--${variant}`, className]
  .filter(Boolean)
  .join(' ');
---

<span class={classes}>{label}</span>

<style>
  .tech-badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .tech-badge--default {
    background: color-mix(in oklch, var(--color-accent-100) 8%, transparent);
    color: var(--color-accent-300);
    border: 1px solid color-mix(in oklch, var(--color-accent-400) 20%, transparent);
  }

  .tech-badge--subtle {
    background: transparent;
    color: var(--color-text-3);
    border: 1px solid var(--color-border);
  }
</style>
