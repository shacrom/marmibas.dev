---
/**
 * Footer — terminal "contact pane" (T3 terminal redesign, rebuild).
 *
 * Visual spec: `FooterTerminal.dc.html` (desktop) / `FooterTerminalMovil.dc.html`
 * (mobile) under the design scratchpad. DESIGN.md §8 pane contract.
 *
 * Structure: a `<footer>` landmark containing one `TerminalPane` (`as="div"`,
 * no index, no scan band — this pane is the last thing on the page, not
 * one of the home's numbered sections) with the shared `.t-pane-gutter`
 * spacing (T2/T3 convention — see `src/styles/terminal.css`):
 *   1. Capture band: violet eyebrow comment, `.t-print` heading (with the
 *      same violet glow as the hero `h1` — C4, `odd/tasks/site-cleanup.md`),
 *      sub copy, and a prompt line ending in a primary `TerminalButton` +
 *      `.t-cursor`. Copy is reused verbatim from the pre-terminal
 *      `Footer.astro`'s `ctaSection`/tagline — nothing invented.
 *   2. `<Prompt command="tree marmibas.dev" />` (T2 component).
 *   3. 3 tree columns (`site`/`social`/`more`) from `getFooterTree(lang)`
 *      (T3, `src/lib/footer.ts`) — `├── `/`└── ` connectors, real links,
 *      `external` items keep `target="_blank" rel="noopener"`. Rows enter
 *      staggered via `.t-show` (C4): base delay = the `tree` prompt's own
 *      typing end + 150ms, +40ms per row, counting across columns in
 *      reading order (site rows, then social rows, then more rows — the
 *      DOM order the 3 `<nav>` columns already render in). The pane is a
 *      `TerminalPane`, so `terminal.css`'s run-on-view pause already
 *      applies to `.t-show` — no extra wiring needed.
 *   4. A violet status bar rendered through `TerminalPane`'s `after` slot
 *      (extended in T3): `© {year} marmibas` + tagline, stacked on mobile.
 *
 * Only `h2`/`.t-print`, the trailing `.t-cursor` and the tree rows
 * (`.t-show`, C4) carry animation classes — the eyebrow/sub are plain
 * server-rendered text (no invented extra motion beyond what the task
 * briefs asked for).
 */
import TerminalPane from '../terminal/TerminalPane.astro';
import Prompt from '../terminal/Prompt.astro';
import TerminalButton from '../terminal/TerminalButton.astro';
import { getRoutePath, useTranslations } from '../../i18n/helpers';
import { getFooterTree } from '../../lib/footer';
import type { Language } from '../../i18n/ui';

interface Props {
  lang: Language;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang);

const year = new Date().getFullYear();
const contactHref = getRoutePath('contact', lang);
const panePath = 'contacto';
const footerLabel = 'Pie de página';

// Capture band copy — reused verbatim from the pre-terminal Footer.astro's
// `ctaSection` (eyebrow/heading/sub) and `tagline`. Only the CTA button
// label changes source: it now reads `cta.contact` (the shared i18n key
// the Header CTA also uses) instead of a footer-local `ctaSection.cta`
// string, since both said the exact same thing ("Hablemos").
const capture = {
  eyebrow: '# ¿Empezamos?',
  heading: 'Cuéntame qué necesitas',
  sub: 'La primera llamada es gratis y sin compromiso.',
};

const tagline = 'Construyo software que tu negocio necesita.';

const tree = getFooterTree(lang);

// Staggered tree-row entrance (C4, odd/tasks/site-cleanup.md): rows start
// after the "tree marmibas.dev" prompt finishes typing (its own typing
// duration mirrors `Prompt.astro`'s default: `max(220, command.length * 38)`
// at `--t-delay: 0`, since this call passes neither `delay` nor `duration`),
// plus a fixed pause, then +40ms per row counting across columns in
// reading order (site rows, then social rows, then more rows).
const TREE_PROMPT_COMMAND = 'tree marmibas.dev';
const TREE_PROMPT_DURATION = Math.max(220, TREE_PROMPT_COMMAND.length * 38);
const TREE_ROW_BASE_DELAY = TREE_PROMPT_DURATION + 150;
const TREE_ROW_STEP = 40;

// Running row-count offset per group, so row delays count continuously
// across all 3 columns instead of restarting at 0 in each one.
const treeGroupStartIndex: number[] = [];
{
  let running = 0;
  for (const group of tree) {
    treeGroupStartIndex.push(running);
    running += group.items.length;
  }
}
---

<footer aria-label={footerLabel}>
  <TerminalPane as="div" path={panePath} scan={false} class="t-pane-gutter">
    <div class="footer-body">
      <div class="footer-capture">
        <span class="footer-capture__eyebrow">{capture.eyebrow}</span>
        <h2 class="footer-capture__heading font-display t-print">{capture.heading}</h2>
        <p class="footer-capture__sub">{capture.sub}</p>
        <div class="footer-capture__prompt">
          <span class="footer-capture__prompt-line"
            ><span class="footer-capture__user">marcos@marmibas</span><span
              class="footer-capture__sep"
              >:~$
            </span><span class="t-cursor" aria-hidden="true"></span></span
          >
          <TerminalButton href={contactHref} primary class="footer-capture__cta">
            [ {t('cta.contact')} ↵ ]
          </TerminalButton>
        </div>
      </div>

      <Prompt command="tree marmibas.dev" />

      <div class="footer-tree">
        {
          tree.map((group, groupIndex) => (
            <nav aria-label={group.ariaLabel} class="footer-tree__group">
              <span class="footer-tree__heading">{group.heading}</span>
              {group.items.map((item, index) => {
                const rowDelay =
                  TREE_ROW_BASE_DELAY +
                  TREE_ROW_STEP * ((treeGroupStartIndex[groupIndex] ?? 0) + index);
                return (
                  <span class="footer-tree__row t-show" style={`--t-delay: ${rowDelay}ms;`}>
                    <span aria-hidden="true" class="footer-tree__connector">
                      {index === group.items.length - 1 ? '└── ' : '├── '}
                    </span>
                    <a
                      class="footer-tree__link"
                      href={item.href}
                      target={item.external ? '_blank' : undefined}
                      rel={item.external ? 'noopener' : undefined}
                      aria-label={item.ariaLabel}
                    >
                      {item.label}
                    </a>
                  </span>
                );
              })}
            </nav>
          ))
        }
      </div>
    </div>

    <Fragment slot="after">
      <div class="footer-status">
        <span>© {year} marmibas</span>
        <span>{tagline}</span>
      </div>
    </Fragment>
  </TerminalPane>
</footer>

<style>
  .footer-body {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  @media (max-width: 640px) {
    .footer-body {
      gap: 18px;
    }
  }

  /* --- Capture band ------------------------------------------------------ */
  .footer-capture {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-bottom: 32px;
    border-bottom: 1px dashed var(--border);
  }

  @media (max-width: 640px) {
    .footer-capture {
      padding-bottom: 24px;
    }
  }

  .footer-capture__eyebrow {
    color: var(--accent-400);
    font-size: var(--text-sm);
  }

  .footer-capture__heading {
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    color: var(--text-0);
    /* Same violet glow as the hero h1 (HeroPane.astro .hero-pane__title). */
    text-shadow: 0 0 24px rgba(167, 139, 250, 0.25);
  }

  @media (min-width: 641px) {
    .footer-capture__heading {
      font-size: var(--text-4xl);
    }
  }

  .footer-capture__sub {
    margin: 0;
    color: var(--text-2);
    font-size: var(--text-sm);
  }

  .footer-capture__prompt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-top: 8px;
    font-size: var(--text-sm);
  }

  @media (max-width: 640px) {
    .footer-capture__prompt {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }

  .footer-capture__user {
    color: var(--accent-400);
  }

  .footer-capture__sep {
    color: var(--text-2);
    white-space: pre;
  }

  .footer-capture__cta {
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .footer-capture__cta {
      width: 100%;
      justify-content: center;
    }
  }

  /* --- Tree columns ------------------------------------------------------ */
  .footer-tree {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    font-size: var(--text-sm);
  }

  @media (min-width: 641px) {
    .footer-tree {
      grid-template-columns: repeat(3, max-content);
      gap: 80px;
      line-height: 1.9;
    }
  }

  .footer-tree__group {
    display: flex;
    flex-direction: column;
  }

  .footer-tree__heading {
    font-weight: 600;
    color: var(--accent-400);
  }

  .footer-tree__row {
    display: flex;
    align-items: center;
  }

  @media (max-width: 640px) {
    .footer-tree__row {
      /* DESIGN.md §12: touch targets ≥ 44px on mobile — the mockup's own
         32px row is under that floor, so this uses the top of the task
         brief's given 32–44px range instead of the mockup's exact value. */
      min-height: 44px;
    }
  }

  .footer-tree__connector {
    flex-shrink: 0;
    font-family: var(--font-glyphs);
    color: var(--border-strong);
    white-space: pre;
  }

  .footer-tree__link {
    color: var(--text-1);
    text-decoration: none;
    transition: color var(--motion-fast) var(--motion-ease-out);
  }

  .footer-tree__link:hover,
  .footer-tree__link:focus-visible {
    color: var(--accent-400);
  }

  /* --- Status bar (TerminalPane `after` slot) ---------------------------- */
  .footer-status {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 36px;
    padding-inline: 20px;
    background: var(--accent-400);
    color: var(--bg-0);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .footer-status {
      height: auto;
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
      padding: 10px 16px;
    }
  }
</style>
