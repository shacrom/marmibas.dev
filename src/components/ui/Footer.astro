---
/**
 * Footer.astro — T-18
 *
 * Footer global, server-rendered (sin JS cliente).
 *
 * Estructura (DESIGN.md §3 — color sólido, sin gradient):
 *   - Top: tagline corto bilingüe (hardcoded; ver `tagline` más abajo).
 *   - Middle: 3 columnas (Navegación, Social, Legal/RSS).
 *   - Bottom: separador + copyright dinámico + "made with Astro".
 *
 * Tokens DESIGN.md:
 *   - Background: `--bg-0` (sólido, sin gradient en footer §3).
 *   - Border-top: `--border` sutil.
 *   - Texto base: `--text-2` con `--text-sm`.
 *   - Hover en links: color → `--accent-400`, 150ms con `--motion-ease-out`.
 *   - Padding vertical: 64-96px (clamp responsivo).
 *
 * SVGs:
 *   - Lucide-style inline, stroke 1.5px, currentColor (DESIGN.md §10).
 *   - GitHub, LinkedIn, X (Twitter).
 *   - target=_blank + rel=noopener (sin tracker `noreferrer` para no romper
 *     analytics de los destinos; el bloqueo de referer no es un requisito
 *     declarado en DESIGN/TASKS, sí lo es no abrir vulnerabilidades a
 *     `window.opener` que cubre `noopener`).
 *
 * i18n:
 *   - Lee diccionario `ui.ts` con `useTranslations(lang)` para `footer.*`,
 *     `footer.social.*` y rutas via `getRoutePath`.
 *   - Tagline hardcoded bilingüe (no existe `footer.tagline` en `ui.ts` y
 *     evitamos tocar el diccionario fuera de scope de T-18).
 */

import { getRoutePath, localePath, useTranslations } from '../../i18n/helpers';
import type { Language } from '../../i18n/ui';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const year = new Date().getFullYear();

// Rutas localizadas (resolved at build-time vía routes.ts).
const homeHref = getRoutePath('home', lang);
const workHref = getRoutePath('work', lang);
const blogHref = getRoutePath('blog', lang);
const experienceHref = getRoutePath('experience', lang);
const contactHref = getRoutePath('contact', lang);
const rssHref = localePath('/rss.xml', lang);

// Tagline hardcoded bilingüe — no añadimos clave a ui.ts en T-18.
const tagline =
  lang === 'es'
    ? 'Construyo software que tu negocio necesita.'
    : 'I build the software your business needs.';

// Email + social URLs. Email del usuario y repo declarados en TASKS.md / prompt.
const EMAIL = 'marmibas.dev@gmail.com';
const GITHUB_URL = 'https://github.com/shacrom';
const LINKEDIN_URL = 'https://www.linkedin.com/in/marmibas';
const TWITTER_URL = 'https://x.com/marmibas';

// Aria label localizado para el aside del footer.
const footerLabel = lang === 'es' ? 'Pie de página' : 'Footer';
---

<footer class="site-footer" aria-label={footerLabel}>
  <div class="site-footer__inner">
    {/* --- Top: tagline -------------------------------------------------- */}
    <p class="site-footer__tagline font-display">{tagline}</p>

    {/* --- Middle: 3 columnas ------------------------------------------- */}
    <div class="site-footer__columns">
      {/* Col 1 — Navegación principal del sitio en idioma activo. */}
      <nav class="site-footer__col" aria-label={lang === 'es' ? 'Navegación del sitio' : 'Site navigation'}>
        <h2 class="site-footer__heading">{lang === 'es' ? 'Sitio' : 'Site'}</h2>
        <ul class="site-footer__list">
          <li><a class="site-footer__link" href={homeHref}>{t('nav.home')}</a></li>
          <li><a class="site-footer__link" href={workHref}>{t('nav.work')}</a></li>
          <li><a class="site-footer__link" href={blogHref}>{t('nav.blog')}</a></li>
          <li><a class="site-footer__link" href={experienceHref}>{t('nav.experience')}</a></li>
          <li><a class="site-footer__link" href={contactHref}>{t('nav.contact')}</a></li>
        </ul>
      </nav>

      {/* Col 2 — Social. Sin tracker (rel=noopener), abre en pestaña nueva. */}
      <div class="site-footer__col">
        <h2 class="site-footer__heading">{lang === 'es' ? 'Social' : 'Social'}</h2>
        <ul class="site-footer__list">
          <li>
            <a
              class="site-footer__link site-footer__link--icon"
              href={GITHUB_URL}
              target="_blank"
              rel="noopener"
              aria-label={t('footer.social.github')}
            >
              {/* GitHub — Lucide-style stroke 1.5 */}
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                <path d="M9 18c-4.51 2-5-2-7-2" />
              </svg>
              <span>{t('footer.social.github')}</span>
            </a>
          </li>
          <li>
            <a
              class="site-footer__link site-footer__link--icon"
              href={LINKEDIN_URL}
              target="_blank"
              rel="noopener"
              aria-label={t('footer.social.linkedin')}
            >
              {/* LinkedIn — Lucide-style stroke 1.5 */}
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" />
                <rect width="4" height="12" x="2" y="9" />
                <circle cx="4" cy="4" r="2" />
              </svg>
              <span>{t('footer.social.linkedin')}</span>
            </a>
          </li>
          <li>
            <a
              class="site-footer__link site-footer__link--icon"
              href={TWITTER_URL}
              target="_blank"
              rel="noopener"
              aria-label={t('footer.social.twitter')}
            >
              {/* X / Twitter — Lucide-style stroke 1.5 */}
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 4l11.733 16h4.267l-11.733 -16z" />
                <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" />
              </svg>
              <span>{t('footer.social.twitter')}</span>
            </a>
          </li>
          <li>
            <a
              class="site-footer__link site-footer__link--icon"
              href={`mailto:${EMAIL}`}
              aria-label={t('footer.social.email')}
            >
              {/* Mail — Lucide-style stroke 1.5 */}
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect width="20" height="16" x="2" y="4" rx="2" />
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
              </svg>
              <span>{EMAIL}</span>
            </a>
          </li>
        </ul>
      </div>

      {/* Col 3 — Legal / RSS. */}
      <div class="site-footer__col">
        <h2 class="site-footer__heading">{lang === 'es' ? 'Más' : 'More'}</h2>
        <ul class="site-footer__list">
          <li>
            <a
              class="site-footer__link site-footer__link--icon"
              href={rssHref}
              aria-label={t('footer.rss')}
            >
              {/* RSS — Lucide-style stroke 1.5 */}
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 11a9 9 0 0 1 9 9" />
                <path d="M4 4a16 16 0 0 1 16 16" />
                <circle cx="5" cy="19" r="1" />
              </svg>
              <span>{t('footer.rss')}</span>
            </a>
          </li>
          <li class="site-footer__meta">
            <span>{t('footer.builtWith')}</span>
          </li>
        </ul>
      </div>
    </div>

    {/* --- Bottom: separador + copyright --------------------------------- */}
    <div class="site-footer__bottom">
      <p class="site-footer__copy">
        <span aria-hidden="true">©</span> {year} {t('footer.copyright')}
      </p>
      <p class="site-footer__made">
        {t('footer.madeWith')} <span class="font-mono">Astro</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    /* DESIGN.md §3: footer = color sólido, sin gradient. */
    background: var(--bg-0);
    border-top: 1px solid var(--border);
    color: var(--text-2);
    font-size: var(--text-sm);
    /* Padding vertical generoso (64-96px) — DESIGN.md §5 ritmo vertical. */
    padding-block: clamp(4rem, 6vw, 6rem);
    padding-inline: clamp(1.5rem, 4vw, 3rem);
    margin-top: auto;
  }

  .site-footer__inner {
    max-width: 1080px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
  }

  /* Top: tagline. Fraunces (display) más pequeño que un H1 — peso 600. */
  .site-footer__tagline {
    color: var(--text-1);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: var(--leading-snug);
    text-wrap: balance;
    max-width: 32ch;
    margin: 0;
  }

  /* Middle: grid responsive. 1 col mobile, 3 col ≥768px. */
  .site-footer__columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .site-footer__columns {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }

  .site-footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .site-footer__heading {
    /* Eyebrow style: JetBrains Mono uppercase (DESIGN.md §8 anclas). */
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--text-3);
    margin: 0;
  }

  .site-footer__list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .site-footer__link {
    display: inline-flex;
    align-items: center;
    color: var(--text-2);
    text-decoration: none;
    /* Hover transition 150ms con ease-out de motion.css. */
    transition: color var(--motion-fast) var(--motion-ease-out);
  }

  .site-footer__link:hover,
  .site-footer__link:focus-visible {
    color: var(--accent-400);
  }

  .site-footer__link--icon {
    gap: 0.5rem;
  }

  .site-footer__link--icon svg {
    flex-shrink: 0;
    /* SVG hereda currentColor; transición incluida en `color` del padre. */
  }

  .site-footer__meta {
    color: var(--text-3);
    font-size: var(--text-xs);
  }

  /* Bottom: separador implícito vía border-top + spacing. */
  .site-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-3);
    font-size: var(--text-xs);
  }

  @media (min-width: 768px) {
    .site-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .site-footer__copy,
  .site-footer__made {
    margin: 0;
  }

  .site-footer__made .font-mono {
    color: var(--text-2);
  }
</style>
