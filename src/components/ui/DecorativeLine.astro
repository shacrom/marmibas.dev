---
/**
 * DecorativeLine.astro — separador decorativo horizontal.
 *
 * Línea fina (1px) con gradient pink → magenta → violet y fade en los
 * extremos. Replica el detalle del reverso de la tarjeta de visita y se
 * usa como pausa visual en transiciones clave del home (Hero → Featured,
 * About → FAQ, etc.). NO debe sustituir a los `<hr>` semánticos del
 * contenido editorial; este componente es puramente decorativo.
 *
 * Diseño:
 *   - Estático en idle (sin animación, sin JS) — coherente con la card.
 *   - Glow muy sutil debajo (box-shadow) para que la línea "respire" sin
 *     llegar a parecer un borde.
 *   - Width controlable por variant (`sm` = 240, `md` = 480, `lg` = 720,
 *     `full` = 100%). Default `md`.
 *
 * Accesibilidad:
 *   - `role="presentation"` + `aria-hidden="true"` — es decoración pura.
 *
 * Tokens consumidos:
 *   --gradient-decorative (definido en global.css §:root).
 */

type Width = 'sm' | 'md' | 'lg' | 'full';

export interface Props {
  /** Ancho máximo de la línea. Default `md` (480px). */
  width?: Width;
  /** Clases extra a mergear con el wrapper. */
  class?: string;
}

const { width = 'md', class: className } = Astro.props;

const classes = ['decorative-line', `decorative-line--${width}`, className]
  .filter(Boolean)
  .join(' ');
---

<div class={classes} role="presentation" aria-hidden="true">
  <div class="decorative-line__inner"></div>
</div>

<style>
  .decorative-line {
    display: flex;
    justify-content: center;
    /* Padding vertical generoso: la línea es una pausa, necesita aire a
     * ambos lados para no pegarse a la sección anterior/siguiente. */
    padding-block: 40px;
  }

  .decorative-line__inner {
    height: 1px;
    width: 100%;
    background: var(--gradient-decorative);
    /* Glow muy sutil: replica el sentido de "luz" de la card sin saturar
     * el fondo violet-tinted. Mantenido bajo (4px / 8% alpha) para no
     * competir con CTAs ni con los headings. */
    box-shadow: 0 0 12px 0 color-mix(in oklch, var(--color-accent-magenta) 18%, transparent);
  }

  /* --- Width variants ----------------------------------------------------
   * Aplicamos el cap como max-width sobre el inner — el wrapper ocupa el
   * ancho completo (centrado por flex). Esto evita que la línea "salte" de
   * posición horizontal cuando cambia la variant. */

  .decorative-line--sm .decorative-line__inner {
    max-width: 240px;
  }

  .decorative-line--md .decorative-line__inner {
    max-width: 480px;
  }

  .decorative-line--lg .decorative-line__inner {
    max-width: 720px;
  }

  .decorative-line--full .decorative-line__inner {
    max-width: none;
  }

  /* En pantallas estrechas la línea consume el ancho disponible — el padding
   * lateral del layout ya garantiza margen frente al borde de viewport. */
  @media (max-width: 480px) {
    .decorative-line {
      padding-block: 32px;
    }
  }
</style>
