---
/**
 * CaseStudyHero.astro — hero de página de case study individual (T-23).
 *
 * Bloque superior de un case study (Voxye, Recetas Novatex, …) renderizado
 * por `CaseStudyLayout.astro` (T-27). Reúne en un único componente:
 *
 *   1. Eyebrow: `<Pill status="success">` + `client · year` en JetBrains Mono.
 *   2. Título h1 — Fraunces 600 con `--gradient-text-display` aplicado vía
 *      `background-clip: text`.
 *   3. Tagline (lead paragraph) — Inter, `--text-xl`, `--text-1`,
 *      `max-inline-size: 720px` (límite de prose).
 *   4. Meta grid (role + stack chips con `<TechBadge variant="default">`).
 *   5. Hero image opcional 16/9 con `--radius-lg` separado 48px del bloque
 *      anterior (Astro `<Image>` para AVIF/WebP).
 *
 * Layout (DESIGN.md §5 + §9):
 *   - Padding vertical: clamp 48-64px mobile → 96-128px desktop.
 *   - Background ambient: `--gradient-hero-ambient` posicionado detrás del
 *     título (DESIGN.md §3 lo permite explícitamente en heroes).
 *   - Container: max-inline-size del wrapper a 1080px (DESIGN.md §9 grid).
 *
 * Motion (DESIGN.md §7 #2 — cascada escalonada):
 *   Cada sección del hero entra en cascada con `animation-delay` derivado de
 *   `--line-index`. Reusamos los keyframes `hero-reveal` declarados en
 *   `motion.css`. Total ≤480ms (4 líneas × 120ms). `prefers-reduced-motion`
 *   queda neutralizado por el bloque global de `motion.css` (single source).
 *
 * Diferencia respecto a `home/Hero.astro` (T-29) y `HeroIntro.astro` (T-28):
 *   - El Hero del home anima palabras/líneas individuales y compone CTAs.
 *   - Este hero anima BLOQUES completos del case study (eyebrow → título →
 *     tagline → meta → imagen) sin partir el título por palabras.
 *
 * Spec: TASKS.md T-23 + DESIGN.md §3, §4, §5, §7, §8.
 */

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import TechBadge from './TechBadge.astro';
import { useTranslations } from '../../i18n/helpers';
import type { Language } from '../../i18n/ui';

export interface Props {
  /** Título del case study (h1 del documento). */
  title: string;
  /** Tagline / lead paragraph corto, ≤2-3 líneas. */
  tagline: string;
  /** Cliente o sector. Aparece en el eyebrow. */
  client: string;
  /** Año del entregable (ej. 2025). */
  year: number;
  /** Rol desempeñado. Opcional — algunos case studies lo omiten. */
  role?: string;
  /** Stack técnico — se renderizan todos como TechBadges. */
  stack: string[];
  /** Idioma activo (resuelve el label de la pill y el rótulo "Rol"). */
  lang: Language;
  /** Imagen hero opcional (Astro Image, AVIF/WebP automáticos). */
  heroImage?: ImageMetadata;
  /** Clases extra a mergear con el wrapper. */
  class?: string;
}

const {
  title,
  tagline,
  client,
  year,
  role,
  stack,
  lang,
  heroImage,
  class: className,
} = Astro.props;

const t = useTranslations(lang);

// Rótulo "Rol" — sin key dedicada en `ui.ts`, fallback bilingüe inline.
// Es razonable: es la única palabra que el componente necesita resolver
// fuera del diccionario, no merece un diccionario aparte.
const roleLabel = lang === 'en' ? 'Role' : 'Rol';
const stackLabel = lang === 'en' ? 'Stack' : 'Stack';

const classes = ['case-study-hero', className].filter(Boolean).join(' ');
---

<header class={classes}>
  <div class="case-study-hero__ambient" aria-hidden="true"></div>

  <div class="case-study-hero__inner">
    <div class="case-study-hero__eyebrow" style="--line-index: 0">
      <span class="case-study-hero__meta">{client} · {year}</span>
    </div>

    <h1 class="case-study-hero__title font-display" style="--line-index: 1">
      {title}
    </h1>

    <p class="case-study-hero__tagline" style="--line-index: 2">
      {tagline}
    </p>

    {
      (role || stack.length > 0) && (
        <dl class="case-study-hero__grid" style="--line-index: 3">
          {role && (
            <div class="case-study-hero__grid-item">
              <dt class="case-study-hero__grid-label">{roleLabel}</dt>
              <dd class="case-study-hero__grid-value">{role}</dd>
            </div>
          )}

          {stack.length > 0 && (
            <div class="case-study-hero__grid-item case-study-hero__grid-item--stack">
              <dt class="case-study-hero__grid-label">{stackLabel}</dt>
              <dd class="case-study-hero__grid-value">
                <ul class="case-study-hero__stack" aria-label={stackLabel}>
                  {stack.map((tech) => (
                    <li>
                      <TechBadge label={tech} variant="default" />
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
        </dl>
      )
    }

    {
      heroImage && (
        <figure class="case-study-hero__figure" style="--line-index: 4">
          <Image
            src={heroImage}
            alt=""
            loading="eager"
            decoding="async"
            widths={[720, 1080, 1440]}
            sizes="(min-width: 1024px) 1080px, 100vw"
          />
        </figure>
      )
    }
  </div>

  <p class="sr-only" aria-live="polite">{t('status.success')}</p>
</header>

<style>
  /* ---------------------------------------------------------------------- */
  /* Wrapper                                                                */
  /* ---------------------------------------------------------------------- */

  .case-study-hero {
    position: relative;
    isolation: isolate; /* contiene el ambient gradient en su stacking context */
    /* Padding vertical clamp 48-64 mobile → 96-128 desktop (DESIGN.md §5). */
    padding-block: clamp(3rem, 6vw + 1.5rem, 8rem);
    padding-inline: clamp(1rem, 4vw, 2rem);
    overflow: hidden;
  }

  /* Background ambient — radial gradient detrás del título.
     `pointer-events: none` para no bloquear interacciones. */
  .case-study-hero__ambient {
    position: absolute;
    inset: 0;
    background: var(--gradient-hero-ambient);
    opacity: 0.4;
    pointer-events: none;
    z-index: -1;
  }

  .case-study-hero__inner {
    position: relative;
    margin-inline: auto;
    max-inline-size: 1080px; /* DESIGN.md §9 — container home/grid */
    display: flex;
    flex-direction: column;
    /* Espaciado vertical entre bloques: 4-6 escalones (16-24px) cuando
       comparten contexto, 32-48px alrededor del título. */
    gap: 1.5rem;
  }

  /* ---------------------------------------------------------------------- */
  /* Eyebrow (Pill + meta)                                                  */
  /* ---------------------------------------------------------------------- */

  .case-study-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }

  .case-study-hero__meta {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ---------------------------------------------------------------------- */
  /* Título h1                                                               */
  /* ---------------------------------------------------------------------- */

  /*
   * Tarea: clamp 40-72px (TASKS.md T-23 + DESIGN.md §4 — display).
   * 40px = 2.5rem, 72px = 4.5rem. Crecimiento ~6vw + 1rem aterriza el clamp
   * en ~640px viewport para escalar suave hasta 1280px+.
   */
  .case-study-hero__title {
    margin: 0;
    font-size: clamp(2.5rem, 6vw + 1rem, 4.5rem);
    font-weight: 600;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tighter);

    /* Gradient text — DESIGN.md §3 lista `--gradient-text-display` como uno
       de los 5 sitios autorizados (heroes seleccionados).
       background-clip:text + transparent fill = el gradient pinta el texto. */
    background: var(--gradient-text-display);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    /* Margin-top de 16px respecto al eyebrow (gap del flex ya aporta 24px;
       compensamos con un negativo pequeño para acercar la pill al título). */
    margin-block-start: -0.25rem;
  }

  /* Fallback de accesibilidad: si el UA no soporta `background-clip: text`
     (muy raro, pero `@supports not` es barato), pintamos `--text-0` sólido.
     Tailwind Preflight no resetea `color: transparent`, así que en navegadores
     viejos veríamos un texto invisible sin este guard. */
  @supports not (background-clip: text) {
    .case-study-hero__title {
      color: var(--text-0);
      -webkit-text-fill-color: var(--text-0);
      background: none;
    }
  }

  /* ---------------------------------------------------------------------- */
  /* Tagline (lead)                                                          */
  /* ---------------------------------------------------------------------- */

  .case-study-hero__tagline {
    margin: 0;
    max-inline-size: 720px; /* DESIGN.md §9 — prose container */
    color: var(--text-1);
    font-family: var(--font-sans);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    text-wrap: pretty;
  }

  /* ---------------------------------------------------------------------- */
  /* Meta grid (role + stack)                                                */
  /* ---------------------------------------------------------------------- */

  .case-study-hero__grid {
    margin: 0;
    margin-block-start: 0.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem 2rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--border);
  }

  /* En ≥640px desplegamos a 2 columnas; el bloque de stack pesa más visual
     (badges) así que le damos más fr. */
  @media (min-width: 640px) {
    .case-study-hero__grid {
      grid-template-columns: minmax(140px, 1fr) minmax(0, 3fr);
    }
  }

  .case-study-hero__grid-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-inline-size: 0; /* permite que el contenido haga wrap correctamente */
  }

  .case-study-hero__grid-label {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .case-study-hero__grid-value {
    margin: 0;
    color: var(--text-1);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    line-height: var(--leading-snug);
  }

  .case-study-hero__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ---------------------------------------------------------------------- */
  /* Hero image                                                              */
  /* ---------------------------------------------------------------------- */

  /*
   * TASKS.md T-23 pide margin-top 48px y aspect-ratio 16/9 con `--radius-lg`.
   * Anulamos el `gap: 1.5rem` (24px) del flex parent con un margin-top de
   * 24px adicional → 48px efectivos.
   */
  .case-study-hero__figure {
    margin: 0;
    margin-block-start: 1.5rem; /* +24 del gap = 48px desde el bloque previo */
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--bg-1);
  }

  .case-study-hero__figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ---------------------------------------------------------------------- */
  /* Cascade reveal (DESIGN.md §7 #2)                                        */
  /* ---------------------------------------------------------------------- */

  /*
   * Cada bloque del hero (eyebrow, título, tagline, grid, figure) entra en
   * cascada con un delay derivado de `--line-index`.
   *
   * - 120ms de step entre líneas.
   * - 250ms de duración base por línea.
   * - Total: 4 × 120ms + 250ms = ~730ms con figura, ~610ms sin figura.
   *
   * `motion.css` declara los keyframes `hero-reveal` y colapsa la duración
   * a 0.01ms cuando `prefers-reduced-motion: reduce`, así que aquí no
   * duplicamos ese guard.
   *
   * `animation-fill-mode: both` mantiene el estado inicial (opacity 0 +
   * translateY 8px) hasta que arranque la animación, evitando el flash
   * inicial visible.
   */
  .case-study-hero__eyebrow,
  .case-study-hero__title,
  .case-study-hero__tagline,
  .case-study-hero__grid,
  .case-study-hero__figure {
    animation: hero-reveal var(--motion-base) var(--motion-ease-out) both;
    animation-delay: calc(var(--line-index, 0) * 120ms);
  }

  /* ---------------------------------------------------------------------- */
  /* Accesibilidad — visualmente oculto pero leído por screen readers       */
  /* ---------------------------------------------------------------------- */

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
