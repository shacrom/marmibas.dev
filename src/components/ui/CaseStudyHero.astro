---
/**
 * CaseStudyHero.astro — case study hero as a terminal pane (W2 terminal
 * redesign — `odd/tasks/work-terminal.md`).
 *
 * Rewritten to match the owner-approved mockup's `~/trabajos/<slug>` hero
 * (`CasoVoxye.dc.html`, drawn for Voxye but built to work for all three
 * case studies): one `TerminalPane` (`index="1/2"` — this hero + the single
 * body pane in `CaseStudyLayout.astro` make up the page's two numbered
 * panes) with a two-column body —
 *   left:  `Prompt` `cat <slug>/README.md`, a lock-up (logo tile + LED
 *          status + h1, no gradient text), tagline, `#tags`.
 *   right: a `stat <slug>` aside — cliente/año/autoría/rol `<dl>` and an
 *          external link button when the case has one.
 *
 * The two-column grid breaks out of `TerminalPane`'s own `.t-pane__body`
 * padding via negative margins, same documented technique as
 * `HeroPane.astro` (home, T4) — see that component's own docblock for the
 * full rationale. Stacking breakpoint (900px) also mirrors `HeroPane`;
 * the breakout-cancelling breakpoint (640px) mirrors `TerminalPane`'s own
 * fixed mobile padding switch.
 *
 * DROPPED vs the previous hero: the `--gradient-text-display` h1 (task
 * brief: "no gradient text"), the `heroImage` figure (the approved mockup
 * has no hero image slot and none of the three real case studies set one),
 * and the sr-only `status.success` live region — the LED + "en producción"
 * line is now real, visible text, so the accessible status announcement is
 * no longer a separate hidden node.
 *
 * Logo tile fit (`contain`/`cover`) and the external link's bare-domain
 * label come from `src/lib/work-case-display.ts` (TDD, shared with the
 * `/trabajos` index, W1) — same helpers, same per-slug decision.
 * `#tags` reuse `toTags` (`src/lib/case-tags.ts`, already tested for
 * `CasesPane.astro`).
 */
import TerminalPane from '../terminal/TerminalPane.astro';
import Prompt from '../terminal/Prompt.astro';
import TerminalButton from '../terminal/TerminalButton.astro';
import { toTags } from '../../lib/case-tags';
import { getLogoFit, hostnameLabel } from '../../lib/work-case-display';
import type { Language } from '../../i18n/ui';

export interface Props {
  /** File-basename slug (`voxye`), drives the pane path/prompt/aside command. */
  slug: string;
  /** Título del case study (h1 del documento). */
  title: string;
  /** Tagline / lead paragraph corto. */
  tagline: string;
  /** Cliente o sector. */
  client: string;
  /** Año del entregable. */
  year: number;
  /** Rol desempeñado. Opcional — algunos case studies lo omiten. */
  role?: string;
  /** Atribución corta ("Producto propio", "Con Plazasys"). */
  attribution?: string;
  /** Ruta pública del logo del producto. */
  logo?: string;
  /** URL pública del producto — habilita el botón externo del aside. */
  externalUrl?: string;
  /** Stack técnico — se renderiza como `#tags`. */
  stack: string[];
  /** Reservado para un futuro idioma — sin copy traducido en este componente hoy. */
  lang: Language;
  /** Clases extra a mergear con el wrapper. */
  class?: string;
}

const {
  slug,
  title,
  tagline,
  client,
  year,
  role,
  attribution,
  logo,
  externalUrl,
  stack,
  class: className,
} = Astro.props as Props;

const logoFit = getLogoFit(slug);
const externalLabel = externalUrl ? hostnameLabel(externalUrl) : null;
const statusLabel = 'en producción';
const statLabels = { client: 'cliente', year: 'año', by: 'autoría', role: 'rol' };
const headingId = 'case-title';
---

<TerminalPane path={`trabajos/${slug}`} index="1/2" labelledby={headingId} class={className}>
  <div class="case-hero">
    <div class="case-hero__main">
      <Prompt command={`cat ${slug}/README.md`} />

      <div class="case-hero__lockup">
        {
          logo && (
            <span class="case-hero__logo-tile">
              <img
                class:list={['case-hero__logo', logoFit === 'cover' && 'case-hero__logo--cover']}
                src={logo}
                alt={`Logo de ${title}`}
                width="60"
                height="60"
                loading="eager"
              />
            </span>
          )
        }

        <div class="case-hero__title-block">
          <span class="case-hero__status">
            <span class="t-led" aria-hidden="true"></span>
            {attribution ? `${statusLabel} · ${attribution}` : statusLabel}
          </span>
          <h1 id={headingId} class="case-hero__title font-display">{title}</h1>
        </div>
      </div>

      <p class="case-hero__tagline">{tagline}</p>

      {stack.length > 0 && <p class="case-hero__tags">{toTags(stack)}</p>}
    </div>

    <aside class="case-hero__aside" aria-label="Ficha del proyecto">
      <p class="case-hero__aside-prompt">{`stat ${slug}`}</p>

      <dl class="case-hero__stat">
        <dt>{statLabels.client}</dt>
        <dd>{client}</dd>
        <dt>{statLabels.year}</dt>
        <dd>{year}</dd>
        {
          attribution && (
            <>
              <dt>{statLabels.by}</dt>
              <dd>{attribution}</dd>
            </>
          )
        }
        {
          role && (
            <>
              <dt>{statLabels.role}</dt>
              <dd>{role}</dd>
            </>
          )
        }
      </dl>

      {
        externalLabel && (
          <div class="case-hero__aside-cta">
            <TerminalButton
              href={externalUrl}
              target="_blank"
              rel="noreferrer"
              class="case-hero__external-btn"
            >
              [ Ver {externalLabel} ↗ ]
            </TerminalButton>
          </div>
        )
      }
    </aside>
  </div>
</TerminalPane>

<style>
  /* ---------------------------------------------------------------------- */
  /* Breakout grid — see docblock (same technique as HeroPane.astro).        */
  /* ---------------------------------------------------------------------- */

  .case-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 400px;
    margin: -36px -48px -40px;
  }

  @media (max-width: 900px) {
    .case-hero {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .case-hero {
      margin: -20px -16px -28px;
    }
  }

  /* --- Main (left) --------------------------------------------------------- */
  .case-hero__main {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 40px 48px 48px;
  }

  @media (max-width: 900px) {
    .case-hero__main {
      padding: 24px 16px 28px;
    }
  }

  .case-hero__lockup {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  /* Light tile — logos are designed for light backgrounds; matches the
     established sitewide convention (CaseStudyCard/ProjectCard/LockupPane
     all use `--text-0`), unlike the /trabajos index's own DARK tile. */
  .case-hero__logo-tile {
    flex-shrink: 0;
    width: 88px;
    height: 88px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--text-0);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  .case-hero__logo {
    width: 60px;
    height: 60px;
    object-fit: contain;
    display: block;
  }

  .case-hero__logo--cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .case-hero__title-block {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .case-hero__status {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--accent-300);
    font-size: var(--text-sm);
  }

  .case-hero__title {
    margin: 0;
    color: var(--text-0);
    font-size: clamp(2.5rem, 5vw + 1rem, 4.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .case-hero__tagline {
    margin: 0;
    max-width: 680px;
    color: var(--text-1);
    font-size: var(--text-xl);
    line-height: 1.5;
  }

  .case-hero__tags {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    color: var(--text-3);
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }

  /* --- Aside (right) --------------------------------------------------------- */
  .case-hero__aside {
    display: flex;
    flex-direction: column;
    background: var(--bg-2);
    border-left: 1px solid var(--border);
  }

  @media (max-width: 900px) {
    .case-hero__aside {
      border-left: none;
      border-top: 1px solid var(--border);
    }
  }

  .case-hero__aside-prompt {
    margin: 0;
    padding: 14px 24px;
    border-bottom: 1px solid var(--border);
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .case-hero__stat {
    margin: 0;
    padding: 24px;
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: 14px 12px;
    font-size: var(--text-sm);
  }

  .case-hero__stat dt {
    color: var(--text-3);
  }

  .case-hero__stat dd {
    margin: 0;
    color: var(--text-0);
    overflow-wrap: anywhere;
  }

  .case-hero__aside-cta {
    margin-top: auto;
    padding: 0 24px 24px;
  }

  .case-hero__external-btn {
    width: 100%;
    justify-content: center;
    border-color: var(--accent-400);
    color: var(--accent-300);
  }
</style>
