---
/**
 * BeforeAfter.astro — case study results as a `diff antes.txt despues.txt`
 * block (W2 terminal redesign — `odd/tasks/work-terminal.md`).
 *
 * Rewritten to match the owner-approved mockup's "Resultados" section
 * (`CasoVoxye.dc.html`, `~/trabajos/voxye/resultados` pane): per row, a
 * label, then two lines — a muted `- <before>` line with a grey bar at
 * FULL width (the fixed reference/baseline), and an accent `+ <after>`
 * line with a bar scaled to `afterValue / beforeValue` (a floor keeps a
 * tiny ratio visible instead of vanishing). `afterValue === 0` renders a
 * `✓` instead of a bar/percentage — matches Voxye's own "Presupuestos con
 * errores de cálculo" row (`beforeValue: 10, afterValue: 0`).
 *
 * DROPPED vs the previous version: the boxed/padded panel background, the
 * `Antes`/`Ahora` word tags, and the before-bar's own proportional width
 * (it used to shrink when `after > before`, which never happens in this
 * component's real usage and isn't what a bullet-chart reference bar is
 * for). The `-`/`+` sign now carries the same "never color-alone" identity
 * job the word tags used to — each line also keeps a screen-reader-only
 * "Antes: " / "Ahora: " prefix so the meaning survives without the visual
 * sign glyph.
 *
 * Bars grow on entrance via `.t-grow-x` (terminal.css, added for this
 * task — a horizontal counterpart to the existing vertical `.t-grow`);
 * reduced-motion final state lives in the single source of truth,
 * `motion.css`, per that file's own contract.
 *
 * Accessibility: identity is never color-alone (sign glyph + sr-only word +
 * plain-text value, not just bar color), and every value is real,
 * selectable text.
 *
 * Props:
 *   - rows: comparison rows. `beforeValue`/`afterValue` share a unit within
 *     the row (any unit — only their ratio matters for the after-bar's
 *     width).
 */
export interface Row {
  /** Dimension being compared ("Hacer y enviar un presupuesto"). */
  label: string;
  /** Human value for the before line ("~2 horas"). */
  before: string;
  /** Human value for the after line ("~30 min"). */
  after: string;
  /** Numeric magnitude behind `before`, same unit as `afterValue`. */
  beforeValue: number;
  /** Numeric magnitude behind `after`, same unit as `beforeValue`; `0` renders a ✓. */
  afterValue: number;
}

export interface Props {
  rows: Row[];
}

const { rows } = Astro.props;

/** After-bar width as a % of the before value; a floor keeps tiny ratios visible. */
const afterWidth = (row: Row): number => {
  if (row.beforeValue <= 0) return 100;
  return Math.max(2, Math.round((row.afterValue / row.beforeValue) * 100));
};
---

<div class="before-after">
  {
    rows.map((row, i) => (
      <div class="before-after__row">
        <strong class="before-after__label">{row.label}</strong>
        <div class="before-after__lines">
          <div class="before-after__line">
            <span class="before-after__text before-after__text--before">
              <span aria-hidden="true">- </span>
              <span class="sr-only">Antes: </span>
              {row.before}
            </span>
            <span class="before-after__bar-track" aria-hidden="true">
              <span
                class="before-after__bar before-after__bar--before t-grow-x"
                style={`width: 100%; --t-delay: ${i * 120}ms;`}
              />
            </span>
          </div>

          <div class="before-after__line">
            <span class="before-after__text before-after__text--after">
              <span aria-hidden="true">+ </span>
              <span class="sr-only">Ahora: </span>
              {row.after}
            </span>
            {row.afterValue === 0 ? (
              <span class="before-after__check" aria-hidden="true">
                ✓
              </span>
            ) : (
              <span class="before-after__bar-track" aria-hidden="true">
                <span
                  class="before-after__bar before-after__bar--after t-grow-x"
                  style={`width: ${afterWidth(row)}%; --t-delay: ${i * 120 + 150}ms;`}
                />
              </span>
            )}
          </div>
        </div>
      </div>
    ))
  }
</div>

<style>
  .before-after {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
    margin-block: 1.5rem;
  }

  .before-after__row {
    display: grid;
    grid-template-columns: minmax(200px, 320px) minmax(0, 1fr);
    align-items: center;
    gap: 24px 32px;
    padding-block: 20px;
    border-bottom: 1px solid var(--border);
  }

  @media (max-width: 640px) {
    .before-after__row {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }

  .before-after__label {
    color: var(--text-0);
    font-size: var(--text-base);
    font-weight: 600;
  }

  .before-after__lines {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .before-after__line {
    display: grid;
    grid-template-columns: minmax(120px, 160px) minmax(0, 1fr);
    align-items: center;
    gap: 16px;
  }

  .before-after__text {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .before-after__text--before {
    color: var(--text-3);
  }

  .before-after__text--after {
    color: var(--accent-300);
    font-weight: 600;
  }

  .before-after__bar-track {
    display: block;
    min-width: 0;
  }

  .before-after__bar {
    display: block;
    height: 10px;
    border-radius: 1px;
  }

  .before-after__bar--before {
    background: var(--border-strong);
  }

  .before-after__bar--after {
    background: var(--accent-400);
  }

  .before-after__check {
    color: var(--accent-300);
    font-size: var(--text-sm);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
