---
/**
 * LangSwitcher — chips ES / EN para alternar idioma.
 *
 * Comportamiento:
 * - Recibe `currentLang` y `currentUrl` (Astro.url) y construye el href al
 *   alterno con `getAlternateUrl(currentUrl, targetLang)`. Si no hay
 *   equivalente declarada, el helper cae a la home del idioma destino.
 * - Renderiza dos chips inline separados por `·`. El chip activo es un
 *   `<span aria-current="true">`; el inactivo es un `<a hreflang=…>` al
 *   path alterno.
 * - Tipografía JetBrains Mono 12px uppercase tracking 0.1em
 *   (DESIGN.md §4 + §8 — anclas visuales del LangSwitcher).
 * - Sin JS cliente: navegación nativa por enlace, focus-visible accesible.
 *
 * Spec: TASKS.md T-19 + DESIGN.md §8 ("Lang switcher").
 */
import { getAlternateUrl, useTranslations } from '../../i18n/helpers';
import type { Language } from '../../i18n/ui';

interface Props {
  currentLang: Language;
  currentUrl: URL;
}

const { currentLang, currentUrl } = Astro.props;

const t = useTranslations(currentLang);
const ariaLabel = t('meta.langSwitcherLabel');

// Idioma alterno = el otro. Hardcoded porque solo hay dos.
const alternateLang: Language = currentLang === 'es' ? 'en' : 'es';
const alternateHref = getAlternateUrl(currentUrl, alternateLang);

// Chips ordenados ES, EN siempre (estable independiente del idioma activo).
const chips: { lang: Language; label: string }[] = [
  { lang: 'es', label: 'ES' },
  { lang: 'en', label: 'EN' },
];
---

<nav class="lang-switcher" aria-label={ariaLabel}>
  {
    chips.map((chip, index) => (
      <>
        {chip.lang === currentLang ? (
          <span class="lang-switcher__chip lang-switcher__chip--active" aria-current="true">
            {chip.label}
          </span>
        ) : (
          <a
            class="lang-switcher__chip lang-switcher__chip--inactive"
            href={alternateHref}
            hreflang={chip.lang}
            lang={chip.lang}
          >
            {chip.label}
          </a>
        )}
        {index === 0 && <span class="lang-switcher__sep" aria-hidden="true">·</span>}
      </>
    ))
  }
</nav>

<style>
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.5ch;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    line-height: 1;
  }

  .lang-switcher__chip {
    display: inline-block;
    padding: 0.125rem 0.125rem;
    text-decoration: none;
    transition:
      color var(--motion-duration-fast, 150ms) var(--motion-ease-out, ease-out),
      text-decoration-color var(--motion-duration-fast, 150ms) var(--motion-ease-out, ease-out);
  }

  .lang-switcher__chip--active {
    color: var(--color-accent-400);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    text-decoration-color: var(--color-accent-400);
    cursor: default;
  }

  .lang-switcher__chip--inactive {
    color: var(--color-text-3);
  }

  .lang-switcher__chip--inactive:hover,
  .lang-switcher__chip--inactive:focus-visible {
    color: var(--color-text-1);
  }

  .lang-switcher__chip--inactive:focus-visible {
    outline: 2px solid var(--color-accent-400);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .lang-switcher__sep {
    color: var(--color-text-3);
    user-select: none;
  }
</style>
