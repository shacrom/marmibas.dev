---
/**
 * Header — terminal tab-bar chrome (T3 terminal redesign, rebuild).
 *
 * Visual spec: `Terminal.dc.html` (desktop tab bar) / `TerminalMovil.dc.html`
 * (mobile bar + dropdown menu) under the design scratchpad. DESIGN.md §1/§7/§8.
 *
 * Structure:
 * - Full-bleed sticky bar (`--bg-inset`, bottom border), inner row capped at
 *   1440px and centered. Desktop (>900px): brand cell → primary-nav tabs
 *   (from `getPrimaryNav`, T2) → flexible spacer → clock cell → CTA cell.
 *   Mobile (≤900px): brand → spacer → compact clock → 44×44 menu button;
 *   tabs + CTA move into a dropdown `<nav>` under the bar.
 * - `view-transition-name: header` is kept so the bar itself doesn't
 *   visually "jump" during a page transition, but there is NO
 *   `transition:persist` — the DOM (and therefore the active/current tab)
 *   is rebuilt fresh on every navigation, as it must be for the current
 *   route's tab to update.
 * - Clock: server-rendered `--:--:--` placeholder in a `<time data-clock>`;
 *   the client script imports `formatClockTime` (`src/lib/clock.ts`) and
 *   ticks every second. Two `[data-clock]` nodes exist in the DOM (desktop
 *   cell + mobile compact cell) — only one is visible at a time via CSS,
 *   both get updated by the same interval.
 * - Mobile menu: a real `<button>` toggles a dropdown `<nav>` with a
 *   terminal "print" reveal (`.t-print`, clip-path steps — replays every
 *   open because the panel goes through `display: none` between closes,
 *   which resets the animation for free, no JS reflow trick needed).
 *   Closes on Escape (returns focus to the button), on any link click, on
 *   `astro:before-swap` (before a View Transitions navigation swaps the
 *   DOM), and when the viewport grows past the 900px breakpoint. Progressive
 *   enhancement: a `<noscript>` override forces the panel visible as a
 *   static list and hides the (otherwise non-functional) toggle button.
 *
 * i18n: Spanish is the only locale (no language switcher — the English
 * version was removed, see `odd/tasks/site-cleanup.md` C2).
 */
import BrandLogo from './BrandLogo.astro';
import { useTranslations, getRoutePath } from '../../i18n/helpers';
import { getPrimaryNav } from '../../lib/navigation';
import type { Language } from '../../i18n/ui';

interface Props {
  currentLang: Language;
  currentUrl: URL;
}

const { currentLang, currentUrl } = Astro.props as Props;

const t = useTranslations(currentLang);

const homeHref = getRoutePath('home', currentLang);
const contactHref = getRoutePath('contact', currentLang);
const navAriaLabel = 'Navegación principal';
const brandLabel = 'marmibas — inicio';

const navItems = getPrimaryNav(currentLang, currentUrl.pathname);

const menuLabelOpen = t('header.menu.open');
const menuLabelClose = t('header.menu.close');
---

<header class="t-header" data-terminal-header>
  <div class="t-header__bar">
    <div class="t-header__inner">
      <a class="t-header__brand" href={homeHref} aria-label={brandLabel}>
        <BrandLogo src="/marmibas-logo.png" width="132px" height="22px" />
      </a>

      <nav class="t-header__tabs" aria-label={navAriaLabel}>
        {
          navItems.map((item) => (
            <a
              class:list={['t-header__tab', { 't-header__tab--current': item.current }]}
              href={item.href}
              aria-current={item.current ? 'page' : undefined}
            >
              {item.tab}
            </a>
          ))
        }
      </nav>

      <div class="t-header__spacer"></div>

      <div class="t-header__clock t-header__clock--desktop">
        <span class="t-header__clock-label">{t('header.clock')}</span>
        <time class="t-header__clock-value" data-clock>--:--:--</time>
      </div>

      <a class="btn-term btn-term--primary t-header__cta" href={contactHref}>
        <span>{t('cta.contact')}</span><span aria-hidden="true">↵</span>
      </a>

      <div class="t-header__clock t-header__mobile-clock">
        <span class="t-header__clock-label">{t('header.clock')}</span>
        <time class="t-header__clock-value" data-clock>--:--:--</time>
      </div>

      <button
        type="button"
        class="t-header__menu-btn"
        aria-expanded="false"
        aria-controls="t-header-menu"
        aria-label={menuLabelOpen}
        data-menu-toggle
        data-label-open={menuLabelOpen}
        data-label-close={menuLabelClose}
      >
        <span aria-hidden="true" data-menu-icon>≡</span>
      </button>
    </div>
  </div>

  <nav
    id="t-header-menu"
    class="t-header__menu t-print"
    aria-label={navAriaLabel}
    data-menu-panel
    style="--t-dur: 220ms; --t-steps: 6;"
  >
    {
      navItems.map((item) => (
        <a
          class="t-header__menu-link"
          href={item.href}
          aria-current={item.current ? 'page' : undefined}
        >
          <span
            aria-hidden="true"
            class:list={[
              't-header__menu-marker',
              { 't-header__menu-marker--current': item.current },
            ]}
          >
            {item.current ? '▸' : '·'}
          </span>
          {item.tab}
        </a>
      ))
    }
    <div class="t-header__menu-cta-wrap">
      <a class="btn-term btn-term--primary t-header__menu-cta" href={contactHref}>
        <span>{t('cta.contact')}</span><span aria-hidden="true">↵</span>
      </a>
    </div>
  </nav>
</header>

<noscript>
  <style>
    /* No JS: nothing can toggle the dropdown, so show it as a plain static
       list instead of leaving mobile navigation unreachable, and hide the
       now-nonfunctional toggle button. */
    .t-header__menu {
      display: flex !important;
      position: static !important;
      box-shadow: none !important;
      animation: none !important;
      clip-path: none !important;
    }

    .t-header__menu-btn {
      display: none !important;
    }
  </style>
</noscript>

<style>
  .t-header {
    position: sticky;
    top: 0;
    z-index: 50;
    view-transition-name: header;
  }

  .t-header__bar {
    height: 48px;
    background: var(--bg-inset);
    border-bottom: 1px solid var(--border);
  }

  .t-header__inner {
    display: flex;
    align-items: stretch;
    height: 100%;
    max-width: 1440px;
    margin-inline: auto;
    font-size: var(--text-xs);
  }

  .t-header__brand {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    padding-inline: 20px;
    border-right: 1px solid var(--border);
  }

  .t-header__brand:focus-visible {
    outline: 2px solid var(--accent-400);
    outline-offset: 2px;
  }

  .t-header__tabs {
    display: flex;
    align-items: stretch;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .t-header__tabs::-webkit-scrollbar {
    display: none;
  }

  .t-header__tab {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    padding-inline: 18px;
    border-right: 1px solid var(--border);
    color: var(--text-2);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--motion-fast) var(--motion-ease-out),
      background-color var(--motion-fast) var(--motion-ease-out);
  }

  .t-header__tab:hover,
  .t-header__tab:focus-visible {
    color: var(--text-0);
    background: var(--bg-2);
  }

  .t-header__tab--current {
    color: var(--text-0);
    background: var(--bg-2);
    box-shadow: inset 0 2px 0 var(--accent-400);
  }

  .t-header__spacer {
    flex: 1 1 auto;
  }

  .t-header__clock-label {
    color: var(--text-2);
  }

  .t-header__clock-value {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--text-0);
  }

  .t-header__clock--desktop {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: 10px;
    padding-inline: 20px;
    border-left: 1px solid var(--border);
  }

  .t-header__clock--desktop .t-header__clock-label {
    font-size: var(--text-xs);
  }

  .t-header__clock--desktop .t-header__clock-value {
    font-size: var(--text-sm);
  }

  .t-header__cta {
    flex-shrink: 0;
    align-self: stretch;
    height: auto;
    gap: 8px;
    padding-inline: 22px;
    border-radius: 0;
    border: none;
    font-weight: 600;
  }

  .t-header__mobile-clock {
    display: none;
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
    line-height: 1.25;
  }

  .t-header__mobile-clock .t-header__clock-label {
    font-size: 10px;
  }

  .t-header__mobile-clock .t-header__clock-value {
    font-size: 13px;
  }

  .t-header__menu-btn {
    display: none;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: var(--text-0);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    transition:
      background-color var(--motion-fast) var(--motion-ease-out),
      color var(--motion-fast) var(--motion-ease-out);
  }

  .t-header__menu-btn:hover {
    background: var(--accent-400);
    color: var(--bg-0);
  }

  .t-header__menu-btn:focus-visible {
    outline: 2px solid var(--accent-400);
    outline-offset: 2px;
  }

  /* Dropdown — always in the DOM, always hidden on desktop; only shown on
     mobile when `[data-open]` is set (see the max-width query below). */
  .t-header__menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 40;
    flex-direction: column;
    background: var(--bg-inset);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.55);
  }

  .t-header__menu-link {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding-inline: 16px;
    border-bottom: 1px solid var(--border);
    font-size: var(--text-sm);
    color: var(--text-1);
    text-decoration: none;
    transition:
      background-color var(--motion-fast) var(--motion-ease-out),
      color var(--motion-fast) var(--motion-ease-out);
  }

  .t-header__menu-link:hover,
  .t-header__menu-link:focus-visible {
    background: color-mix(in srgb, var(--accent-400) 12%, transparent);
    color: var(--text-0);
  }

  .t-header__menu-marker {
    color: var(--border-strong);
  }

  .t-header__menu-marker--current {
    color: var(--accent-400);
  }

  .t-header__menu-cta-wrap {
    padding: 14px 16px 16px;
  }

  .t-header__menu-cta {
    display: flex;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .t-header__bar {
      height: 56px;
    }

    .t-header__inner {
      padding-inline: 16px 8px;
      gap: 14px;
    }

    /* The mobile bar has no cell dividers: dropping the brand cell's padding
       and border keeps logo + clock + menu button within 320px viewports. */
    .t-header__brand {
      padding-inline: 0;
      border-right: 0;
    }

    .t-header__tabs,
    .t-header__clock--desktop,
    .t-header__cta {
      display: none;
    }

    .t-header__mobile-clock {
      display: flex;
      /* `.t-header__inner` stretches this item to the full 56px bar height;
         without this the label/time stack (an auto-height column) sits at
         the top of that box instead of centred in it. */
      justify-content: center;
    }

    .t-header__menu-btn {
      display: inline-flex;
      /* Fixed 44×44 size means `align-items: stretch` on `.t-header__inner`
         falls back to flex-start (top) for this item's cross-axis position
         — centre it explicitly so it sits mid-bar with equal space above
         and below, matching the clock block. */
      align-self: center;
    }

    .t-header__menu[data-open] {
      display: flex;
    }
  }
</style>

<script>
  /**
   * Header clock + mobile menu driver. Progressive enhancement: the clock
   * placeholder and the (hidden-by-default) dropdown already render
   * server-side, so a no-JS visitor gets a static, correct header (with the
   * dropdown always reachable — see the `<noscript>` override above).
   *
   * Both the clock interval and the menu's event listeners are torn down on
   * `astro:before-swap` and re-created on `astro:page-load`, because the
   * Header's DOM is fully rebuilt on every View Transitions navigation
   * (there is no `transition:persist` here on purpose — the active tab must
   * reflect the new page). Re-running init on a fresh DOM without tearing
   * down the previous run's interval/listeners would leak both.
   */
  import { formatClockTime } from '../../lib/clock';

  const HEADER_SELECTOR = '[data-terminal-header]';
  const MENU_MEDIA_QUERY = '(max-width: 900px)';

  let clockIntervalId: number | undefined;
  let menuAbortController: AbortController | undefined;

  function updateClocks(): void {
    const now = formatClockTime(new Date());
    document.querySelectorAll<HTMLElement>('[data-clock]').forEach((el) => {
      el.textContent = now;
    });
  }

  function setupClock(): void {
    const header = document.querySelector<HTMLElement>(HEADER_SELECTOR);
    if (!header || header.dataset.clockInit === 'true') return;
    header.dataset.clockInit = 'true';

    updateClocks();
    clockIntervalId = window.setInterval(updateClocks, 1000);
  }

  function teardownClock(): void {
    if (clockIntervalId !== undefined) {
      window.clearInterval(clockIntervalId);
      clockIntervalId = undefined;
    }
  }

  function closeMenu(header: HTMLElement, focusButton: boolean): void {
    const button = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const panel = header.querySelector<HTMLElement>('[data-menu-panel]');
    const icon = header.querySelector<HTMLElement>('[data-menu-icon]');
    if (!button || !panel) return;

    panel.removeAttribute('data-open');
    button.setAttribute('aria-expanded', 'false');
    button.setAttribute('aria-label', button.dataset.labelOpen ?? '');
    if (icon) icon.textContent = '≡';
    if (focusButton) button.focus();
  }

  function openMenu(header: HTMLElement): void {
    const button = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const panel = header.querySelector<HTMLElement>('[data-menu-panel]');
    const icon = header.querySelector<HTMLElement>('[data-menu-icon]');
    if (!button || !panel) return;

    panel.setAttribute('data-open', 'true');
    button.setAttribute('aria-expanded', 'true');
    button.setAttribute('aria-label', button.dataset.labelClose ?? '');
    if (icon) icon.textContent = '×';
  }

  function setupMenu(): void {
    const header = document.querySelector<HTMLElement>(HEADER_SELECTOR);
    if (!header || header.dataset.menuInit === 'true') return;
    header.dataset.menuInit = 'true';

    const button = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const panel = header.querySelector<HTMLElement>('[data-menu-panel]');
    if (!button || !panel) return;

    menuAbortController = new AbortController();
    const { signal } = menuAbortController;

    button.addEventListener(
      'click',
      () => {
        if (panel.hasAttribute('data-open')) {
          closeMenu(header, false);
        } else {
          openMenu(header);
        }
      },
      { signal }
    );

    panel.addEventListener(
      'click',
      (event) => {
        if ((event.target as HTMLElement).closest('a')) closeMenu(header, false);
      },
      { signal }
    );

    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape' && panel.hasAttribute('data-open')) {
          closeMenu(header, true);
        }
      },
      { signal }
    );

    window.matchMedia(MENU_MEDIA_QUERY).addEventListener(
      'change',
      (event) => {
        if (!event.matches) closeMenu(header, false);
      },
      { signal }
    );
  }

  function teardownMenu(): void {
    const header = document.querySelector<HTMLElement>(HEADER_SELECTOR);
    if (header) closeMenu(header, false);
    if (menuAbortController) {
      menuAbortController.abort();
      menuAbortController = undefined;
    }
  }

  function setupHeader(): void {
    setupClock();
    setupMenu();
  }

  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
  document.addEventListener('astro:before-swap', () => {
    teardownClock();
    teardownMenu();
  });
</script>
