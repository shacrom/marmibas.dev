---
/**
 * Header — barra superior con brand "marmibas", nav primario y LangSwitcher.
 *
 * Comportamiento:
 * - Brand es link a la home del idioma activo (`/` en ES, `/en/` en EN).
 *   Tipografía display Fraunces (var(--font-display)), peso 600, color
 *   `--color-text-0` para máxima jerarquía.
 * - Nav muestra los 5 ítems primarios (home, work, experience, blog,
 *   contact) traducidos vía `t('nav.*')`. El link activo se resuelve con
 *   `isCurrentRoute(currentPath, key, lang)` y recibe `aria-current="page"`
 *   + un dot indicator morado (--color-accent-400) bajo el label.
 * - LangSwitcher (T-19) montado al extremo derecho, recibe `currentLang`
 *   y `currentUrl` para construir el href alterno.
 * - Sticky top con backdrop-filter blur sutil sobre `--color-bg-0`
 *   transparente (DESIGN.md §6 "tech minimal" — el fondo del header se
 *   "funde" con el contenido al hacer scroll, manteniendo legibilidad).
 * - Mobile (<640px): nav se mantiene visible con horizontal scroll
 *   (decisión: no introducir hamburger interactivo en T-17 porque eso
 *   exigiría JS cliente y T-17 NO pide hamburger explícitamente — la
 *   `Done` checklist de T-17 menciona hamburger pero el usuario priorizó
 *   "sin JS cliente salvo si TASKS.md pide hamburger interactivo". Se
 *   marca como deviation reportable y se deja el horizontal scroll
 *   accesible y sin layout shift). Ver reporte final.
 *   Brand siempre visible; nav es scrolleable horizontalmente con
 *   `scrollbar-width: none` y los chips no se truncan.
 * - View Transitions: `view-transition-name: header` para que persista
 *   visualmente entre navegaciones (sin re-mount visual).
 *
 * Spec: TASKS.md T-17 + DESIGN.md §1 (tech minimal oscuro), §4
 * (tipografías), §6 (motion tokens), §8 ("Lang switcher").
 */
import MetallicLogo from './MetallicLogo.astro';
import { useTranslations, getRoutePath, isCurrentRoute } from '../../i18n/helpers';
import type { Language } from '../../i18n/ui';
import type { RouteKey } from '../../i18n/routes';

interface Props {
  currentLang: Language;
  currentUrl: URL;
}

const { currentLang, currentUrl } = Astro.props as Props;

const t = useTranslations(currentLang);

const homeHref = getRoutePath('home', currentLang);
const contactHref = getRoutePath('contact', currentLang);
const navAriaLabel = currentLang === 'es' ? 'Navegación principal' : 'Main navigation';
const themeSwitcherLabel = currentLang === 'es' ? 'Tema' : 'Theme';

/**
 * Selector de tema (temporal, A/B — ver src/styles/themes.css). Las opciones
 * son nombres propios (no requieren traducción); el value coincide con el
 * `data-theme` que consume themes.css.
 */
const themeOptions = [
  { value: 'violeta', label: 'Violeta' },
  { value: 'grafito', label: 'Grafito' },
  { value: 'medianoche', label: 'Medianoche' },
  { value: 'calido', label: 'Cálido' },
  { value: 'constelacion', label: 'Constelación' },
  { value: 'circuito', label: 'Circuito' },
  { value: 'pulsos', label: 'Pulsos' },
];

interface NavItem {
  key: RouteKey;
  label: string;
  href: string;
  active: boolean;
}

const navKeys: {
  key: RouteKey;
  labelKey: 'nav.home' | 'nav.work' | 'nav.experience' | 'nav.blog' | 'nav.contact';
}[] = [
  { key: 'home', labelKey: 'nav.home' },
  { key: 'work', labelKey: 'nav.work' },
  { key: 'experience', labelKey: 'nav.experience' },
  { key: 'blog', labelKey: 'nav.blog' },
  { key: 'contact', labelKey: 'nav.contact' },
];

const navItems: NavItem[] = navKeys.map(({ key, labelKey }) => ({
  key,
  label: t(labelKey),
  href: getRoutePath(key, currentLang),
  active: isCurrentRoute(currentUrl.pathname, key, currentLang),
}));
---

<header class="site-header" data-current-lang={currentLang}>
  <div class="site-header__inner">
    {/* Brand: logo metalizado (paquete externo) en vez del wordmark de texto.
        El aria-label y el focus ring viven en el link; el span del logo
        aporta su propio role="img" con label por defecto. */}
    <a class="site-header__brand" href={homeHref} aria-label="Marmibas — home">
      <MetallicLogo src="/marmibas-logo.png" width="165px" height="27px" />
    </a>

    <nav class="site-header__nav" aria-label={navAriaLabel}>
      <ul class="site-header__list" role="list">
        {
          navItems.map((item) => (
            <li class="site-header__item">
              <a
                class:list={['site-header__link', { 'site-header__link--active': item.active }]}
                href={item.href}
                aria-current={item.active ? 'page' : undefined}
              >
                <span class="site-header__link-label">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <label class="site-header__theme-switcher">
      <span class="sr-only">{themeSwitcherLabel}</span>
      <select
        id="theme-switcher"
        class="site-header__theme-select"
        aria-label={themeSwitcherLabel}
      >
        {themeOptions.map((option) => (
          <option value={option.value}>{option.label}</option>
        ))}
      </select>
    </label>

    <a class="site-header__cta" href={contactHref}>
      {t('cta.contact')}
    </a>
  </div>
</header>

<script>
  /**
   * Theme switcher (temporal A/B — see src/styles/themes.css). Syncs the
   * select with the active `data-theme`, persists when storage is available,
   * and re-runs after Astro View Transition page loads. Storage calls are
   * guarded because restricted browser contexts can throw on localStorage.
   */
  const STORAGE_KEY = 'theme';
  const VALID_THEMES = [
    'grafito',
    'medianoche',
    'calido',
    'constelacion',
    'circuito',
    'pulsos',
  ];

  type ThemeSwitcherWindow = Window & {
    __marmibasThemeSwitcherBound?: boolean;
  };

  function safeSetTheme(value: string) {
    try {
      window.localStorage.setItem(STORAGE_KEY, value);
    } catch {
      // Theme still applies for the current page when persistence is blocked.
    }
  }

  function safeRemoveTheme() {
    try {
      window.localStorage.removeItem(STORAGE_KEY);
    } catch {
      // No-op: storage may be unavailable in restricted contexts.
    }
  }

  function syncSelectValue(select: HTMLSelectElement) {
    const active = document.documentElement.dataset.theme;
    select.value = active && VALID_THEMES.includes(active) ? active : 'violeta';
  }

  function handleChange(event: Event) {
    const select = event.currentTarget as HTMLSelectElement;
    const value = select.value;

    if (value === 'violeta' || !VALID_THEMES.includes(value)) {
      delete document.documentElement.dataset.theme;
      safeRemoveTheme();
    } else {
      document.documentElement.dataset.theme = value;
      safeSetTheme(value);
    }

    // Notificar el cambio a quien lo necesite (p.ej. el loader lazy de los
    // fondos canvas en ThemeBackground) sin acoplar componentes entre sí.
    document.dispatchEvent(
      new CustomEvent('theme-change', { detail: { theme: value } })
    );
  }

  function initThemeSwitcher() {
    const select = document.getElementById('theme-switcher') as HTMLSelectElement | null;
    if (!select) return;

    syncSelectValue(select);
    if (select.dataset.themeSwitcherBound === 'true') return;

    select.dataset.themeSwitcherBound = 'true';
    select.addEventListener('change', handleChange);
  }

  initThemeSwitcher();
  if (!(window as ThemeSwitcherWindow).__marmibasThemeSwitcherBound) {
    (window as ThemeSwitcherWindow).__marmibasThemeSwitcherBound = true;
    document.addEventListener('astro:page-load', initThemeSwitcher);
  }
</script>

<style>
  /* --------------------------------------------------------------------- */
  /* Wrapper sticky con backdrop blur sutil. View Transitions preservadas. */
  /* --------------------------------------------------------------------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    background-color: color-mix(in srgb, var(--color-bg-0) 72%, transparent);
    /* Fallback para navegadores sin color-mix: bg-0 sólido, baja opacidad
       a través del header, layout no rompe si backdrop-filter no aplica. */
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    border-bottom: 1px solid var(--color-border);
    view-transition-name: header;
  }

  /* Si el navegador soporta backdrop-filter, podemos bajar más la opacidad. */
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .site-header {
      background-color: color-mix(in srgb, var(--color-bg-0) 60%, transparent);
    }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    max-width: 1080px;
    margin-inline: auto;
    padding-block: 1rem;
    padding-inline: clamp(1rem, 4vw, 2rem);
  }

  /* --------------------------------------------------------------------- */
  /* Brand wordmark — Geist Sans display (var(--font-display)), peso 600    */
  /* para destacar como logo. Letter-spacing ligeramente cerrado (-0.01em). */
  /* "Marmibas" con M mayúscula, alineado con la card de visita.            */
  /* --------------------------------------------------------------------- */
  .site-header__brand {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-xl, 1.25rem);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--color-text-0);
    text-decoration: none;
    transition: color var(--motion-duration-fast, 150ms)
      var(--motion-ease-out, cubic-bezier(0.16, 1, 0.3, 1));
  }

  .site-header__brand:hover,
  .site-header__brand:focus-visible {
    color: var(--color-accent-300);
  }

  .site-header__brand:focus-visible {
    outline: 2px solid var(--color-accent-400);
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* --------------------------------------------------------------------- */
  /* Nav central — flexible, ocupa el espacio disponible.                  */
  /* --------------------------------------------------------------------- */
  .site-header__nav {
    flex: 1 1 auto;
    min-width: 0; /* permite que .__list se contraiga sin overflow del flex */
  }

  .site-header__list {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
    /* Mobile: scroll horizontal sin scrollbar visible si los chips no caben. */
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
  }

  .site-header__list::-webkit-scrollbar {
    display: none;
  }

  .site-header__item {
    flex-shrink: 0;
  }

  /* --------------------------------------------------------------------- */
  /* Links del nav — idle text-2, hover/active text-0, transición fast.    */
  /* Dot indicator bajo el link activo con accent-400.                     */
  /* --------------------------------------------------------------------- */
  .site-header__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding-block: 0.375rem;
    padding-inline: 0.125rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm, 0.875rem);
    font-weight: 500;
    line-height: 1;
    color: var(--color-text-2);
    text-decoration: none;
    transition: color var(--motion-fast, 150ms)
      var(--motion-ease-out, cubic-bezier(0.16, 1, 0.3, 1));
  }

  .site-header__link:hover,
  .site-header__link:focus-visible {
    color: var(--color-text-0);
  }

  .site-header__link:focus-visible {
    outline: 2px solid var(--color-accent-400);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .site-header__link--active {
    color: var(--color-text-0);
  }

  /* Dot indicator bajo el link activo. Posicionado absoluto para no
     desplazar el layout y evitar layout shift en hover/idle.            */
  .site-header__link--active::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -0.375rem;
    width: 4px;
    height: 4px;
    border-radius: 9999px;
    background-color: var(--color-accent-400);
    transform: translateX(-50%);
  }

  /* --------------------------------------------------------------------- */
  /* Selector de tema (temporal, A/B — ver src/styles/themes.css). Select   */
  /* nativo minimalista que se funde con el header usando los tokens        */
  /* existentes (bg-1, border, text-2). Visible también en mobile, a       */
  /* diferencia de la CTA que se oculta ahí.                                */
  /* --------------------------------------------------------------------- */
  .site-header__theme-switcher {
    flex-shrink: 0;
    display: inline-flex;
  }

  .site-header__theme-select {
    appearance: none;
    padding: 0.375rem 1.75rem 0.375rem 0.625rem;
    background-color: var(--bg-1);
    background-image: linear-gradient(45deg, transparent 50%, var(--text-2) 50%),
      linear-gradient(135deg, var(--text-2) 50%, transparent 50%);
    background-position:
      calc(100% - 0.9rem) center,
      calc(100% - 0.65rem) center;
    background-size: 5px 5px;
    background-repeat: no-repeat;
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 8px);
    color: var(--text-2);
    font-size: var(--text-xs, 0.75rem);
    line-height: 1;
    cursor: pointer;
    transition: border-color var(--motion-fast, 150ms)
      var(--motion-ease-out, cubic-bezier(0.16, 1, 0.3, 1));
  }

  .site-header__theme-select:hover {
    border-color: var(--accent-400);
    color: var(--text-1);
  }

  .site-header__theme-select:focus-visible {
    outline: 2px solid var(--accent-400);
    outline-offset: 2px;
  }

  /* Accesibilidad — visualmente oculto pero leído por screen readers. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .site-header__cta {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.625rem 0.875rem;
    color: var(--color-text-0);
    background: color-mix(in oklch, var(--color-accent-500) 24%, transparent);
    border: 1px solid color-mix(in oklch, var(--color-accent-400) 36%, transparent);
    border-radius: var(--radius-full);
    font-size: var(--text-sm, 0.875rem);
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    transition:
      background var(--motion-fast, 150ms) var(--motion-ease-out, cubic-bezier(0.16, 1, 0.3, 1)),
      border-color var(--motion-fast, 150ms) var(--motion-ease-out, cubic-bezier(0.16, 1, 0.3, 1)),
      transform var(--motion-fast, 150ms) var(--motion-ease-out, cubic-bezier(0.16, 1, 0.3, 1));
  }

  .site-header__cta:hover,
  .site-header__cta:focus-visible {
    background: color-mix(in oklch, var(--color-accent-500) 34%, transparent);
    border-color: var(--color-accent-400);
    transform: translateY(-1px);
  }

  /* --------------------------------------------------------------------- */
  /* Mobile fine-tuning: padding compacto, gaps menores.                    */
  /* --------------------------------------------------------------------- */
  @media (max-width: 640px) {
    .site-header__inner {
      gap: 0.75rem;
      padding-block: 0.75rem;
    }

    .site-header__brand {
      font-size: var(--text-lg, 1.125rem);
    }

    /* El logo metalizado lleva width/height inline (API del componente
       externo), así que el escalado mobile necesita !important para
       ganar al estilo inline — equivale al ajuste tipográfico anterior. */
    .site-header__brand :global(.metallic-logo) {
      width: 135px !important;
      height: 22px !important;
    }

    .site-header__list {
      justify-content: flex-start;
    }

    .site-header__link {
      font-size: var(--text-sm, 0.875rem);
    }

    .site-header__cta {
      display: none;
    }
  }
</style>
