---
/**
 * CaseStudyCard.astro — card destacado para case studies (T-22).
 *
 * Card de mayor jerarquía visual que `ProjectCard.astro`:
 * - Background `--bg-1`, radius `--radius-lg`, border 1px sólido `--border` idle.
 * - Cuando `featured`, un borde gradient conic (`--gradient-border-featured`)
 *   se materializa SOLO al hover/focus mediante un `::before` con CSS mask
 *   composite (`mask-composite: exclude`). Ese mask "vacía" el centro del
 *   pseudo-elemento dejando solo un anillo de 1px que pinta el conic.
 * - El conic además rota MUY despacio al hover (DESIGN.md §8: "border conic
 *   gradient sutil que rota muy lento al hover (no idle)"). Idle estático
 *   por contrato (DESIGN.md §3: prohibidos los gradients animados en idle).
 * - Reduced-motion neutralizado por `motion.css` (single source of truth).
 *
 * Estructura: `<a>` envuelve toda la card → toda el área es clickable.
 * Contenido compacto: meta (cliente · año), logo + título h3 con
 * `font-display`, tagline, stack (top 3 TechBadges) y CTA en JetBrains Mono.
 * Sin visual placeholder ni status pill — la card confía en el contenido.
 *
 * Props:
 *   - title: título del case study.
 *   - tagline: lead-paragraph corto del case study.
 *   - client, year: meta línea bajo el header.
 *   - stack: array de tecnologías (slice top 5 para no romper el ritmo).
 *   - lang: idioma activo (reservado; la card ya no traduce ningún texto propio).
 *   - href: ruta destino (`/trabajos/<slug>` o `/en/work/<slug>`).
 *   - heroImage: opcional, ImageMetadata de Astro (usa `<Image>` para AVIF/WebP).
 *   - featured: si true, activa el borde conic gradient.
 *
 * Spec: TASKS.md T-22 + DESIGN.md §3 (gradients) + §8 (featured project card).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import TechBadge from './TechBadge.astro';
import type { Language } from '../../i18n/ui';

export interface Props {
  /** Título del case study (h3 dentro de la card). */
  title: string;
  /** Lead paragraph corto, debe caber en 2-3 líneas. */
  tagline: string;
  /** Cliente o sector ("Cliente confidencial · sector reformas"). */
  client: string;
  /** Atribución corta añadida a la meta línea ("Con Plazasys", "Producto propio"). */
  attribution?: string;
  /** Ruta pública del logo del producto (tile claro junto al título). */
  logo?: string;
  /** Ruta pública del logo del cliente (chip pequeño junto al meta). */
  clientLogo?: string;
  /** Año del entregable (ej. 2025). */
  year: number;
  /** Stack técnico — se renderizan los primeros 5. */
  stack: string[];
  /** Idioma activo, para traducir el CTA. */
  lang: Language;
  /** Ruta del detalle del case study. */
  href: string;
  /** Imagen hero opcional (Astro Image, AVIF/WebP automáticos). */
  heroImage?: ImageMetadata;
  /** Si true, activa el borde conic gradient sutil al hover. */
  featured?: boolean;
  /** Clases extra a mergear con el wrapper. */
  class?: string;
}

const {
  title,
  tagline,
  client,
  attribution,
  logo,
  clientLogo,
  year,
  stack,
  href,
  heroImage,
  featured = false,
  class: className,
} = Astro.props;

const classes = ['case-study-card', featured && 'is-featured', className].filter(Boolean).join(' ');

// Top 3 del stack — suficiente para situar el proyecto sin inflar la card.
const visibleStack = stack.slice(0, 3);
---

<a class={classes} href={href}>
  {
    heroImage && (
      <figure class="case-study-card__figure">
        <Image
          src={heroImage}
          alt=""
          loading="lazy"
          decoding="async"
          widths={[480, 720, 960]}
          sizes="(min-width: 1024px) 480px, (min-width: 640px) 50vw, 100vw"
        />
      </figure>
    )
  }

  <div class="case-study-card__body">
    <header class="case-study-card__top">
      <span class="case-study-card__meta">
        {clientLogo && (
          <img
            class="case-study-card__client-logo"
            src={clientLogo}
            alt={`Logo de ${client}`}
            width="20"
            height="20"
            loading="lazy"
          />
        )}
        {client} · {year}
      </span>
      {attribution && <span class="case-study-card__attribution">{attribution}</span>}
    </header>

    <div class="case-study-card__title-row">
      {logo && (
        <img
          class="case-study-card__logo"
          src={logo}
          alt={`Logo de ${title}`}
          width="44"
          height="44"
          loading="lazy"
        />
      )}
      <h3 class="case-study-card__title font-display">{title}</h3>
    </div>
    <p class="case-study-card__tagline">{tagline}</p>

    {
      visibleStack.length > 0 && (
        <ul class="case-study-card__stack" aria-label="Stack">
          {visibleStack.map((tech) => (
            <li>
              <TechBadge label={tech} variant="default" />
            </li>
          ))}
        </ul>
      )
    }

  </div>
</a>

<style>
  /* ---------------------------------------------------------------------- */
  /* Wrapper                                                                 */
  /* ---------------------------------------------------------------------- */

  .case-study-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--bg-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: var(--text-1);
    text-decoration: none;
    transition:
      transform var(--motion-base) var(--motion-ease-out),
      border-color var(--motion-fast) var(--motion-ease-out),
      box-shadow var(--motion-base) var(--motion-ease-out);
  }

  /* Hover/focus básico — aplica a featured y no-featured. El borde sólido
     pasa a `--accent-400` solo cuando NO es featured (en featured el
     gradient toma protagonismo y un border accent extra competiría). */
  .case-study-card:hover,
  .case-study-card:focus-visible {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
  }

  .case-study-card:not(.is-featured):hover,
  .case-study-card:not(.is-featured):focus-visible {
    border-color: var(--accent-400);
  }

  /* ---------------------------------------------------------------------- */
  /* Conic gradient border (solo si .is-featured) — DESIGN.md §3 + §8        */
  /*                                                                         */
  /* Técnica:                                                                */
  /*   1. `::before` posicionado absoluto con `inset: 0`, mismo radius.      */
  /*   2. Pinta el conic gradient como background.                           */
  /*   3. Doble mask (gradiente sólido vs gradiente con padding) + `mask-   */
  /*      composite: exclude` recorta el centro y deja solo un anillo de    */
  /*      1px (el `padding`).                                                */
  /*   4. Idle: opacity 0 → invisible. Hover/focus: opacity 0.6 → emerge.    */
  /*   5. Rotación: variable `--conic-angle` en `from <angle>` animada solo  */
  /*      en hover/focus. `motion.css` neutraliza la duración cuando         */
  /*      `prefers-reduced-motion: reduce`.                                  */
  /* ---------------------------------------------------------------------- */

  /* `--conic-angle` registrado vía @property para que sea interpolable.
     Sin @property, el `from <angle>` de un conic-gradient no anima
     suavemente porque la spec lo trata como un valor discreto. */
  @property --case-study-conic-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 180deg;
  }

  .case-study-card.is-featured::before {
    content: '';
    position: absolute;
    inset: 0;
    padding: 1px;
    border-radius: inherit;
    --case-study-conic-angle: 180deg;
    /* Conic gradient inline para poder animar `--case-study-conic-angle`.
       Replica `--gradient-border-featured` de DESIGN.md §3 con el ángulo
       parametrizable. */
    background: conic-gradient(
      from var(--case-study-conic-angle) at 50% 50%,
      var(--accent-600),
      var(--accent-400),
      var(--accent-600)
    );
    /* Doble mask: la capa "content-box" recorta el centro; el `exclude`
       deja visible solo el padding (1px de borde gradient). */
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    opacity: 0;
    transition:
      opacity var(--motion-base) var(--motion-ease-out),
      --case-study-conic-angle var(--motion-base) var(--motion-ease-out);
    z-index: 1;
  }

  .case-study-card.is-featured:hover::before,
  .case-study-card.is-featured:focus-visible::before {
    opacity: 0.6;
    /* Rotación lenta del `from` del conic — no del ::before completo, así
       el rectángulo permanece anclado a `inset: 0` y el mask no falla en
       las esquinas. DESIGN.md §3 prohíbe animar gradients en idle: la
       animación arranca solo en hover/focus. */
    animation: case-study-card-conic-rotate 6s linear infinite;
  }

  /* En featured no aplicamos border-color: --accent-400 para que el conic
     sea el único indicador visual del estado focus/hover. El borde sólido
     permanece en `--border` (visible bajo el gradient cuando opacity < 1). */

  /* ---------------------------------------------------------------------- */
  /* Hero image                                                              */
  /* ---------------------------------------------------------------------- */

  .case-study-card__figure {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-2);
  }

  .case-study-card__figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--motion-base) var(--motion-ease-out);
  }

  .case-study-card:hover .case-study-card__figure :global(img),
  .case-study-card:focus-visible .case-study-card__figure :global(img) {
    transform: scale(1.02);
  }

  /* ---------------------------------------------------------------------- */
  /* Body                                                                    */
  /* ---------------------------------------------------------------------- */

  .case-study-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    /* z-index: 2 para quedar encima del ::before sin perderse el borde. */
    position: relative;
    z-index: 2;
  }

  /* Fila superior estable: meta a la izquierda, atribución a la derecha. */
  .case-study-card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .case-study-card__meta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    line-height: 1.6;
  }

  .case-study-card__attribution {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    padding: 3px 9px;
    color: var(--accent-300);
    background: color-mix(in oklch, var(--accent-400) 10%, transparent);
    border: 1px solid color-mix(in oklch, var(--accent-400) 26%, transparent);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.4;
    white-space: nowrap;
  }

  .case-study-card__client-logo {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  .case-study-card__title-row {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  /* Tile claro para el logo del producto: los logos de marca están pensados
     para fondos claros; el tile preserva sus colores sobre el tema oscuro
     (misma convención que /experiencia y ProjectCard). */
  .case-study-card__logo {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    object-fit: contain;
    padding: 6px;
    border-radius: var(--radius-sm);
    background: var(--text-0);
    border: 1px solid var(--border);
  }

  .case-study-card__title {
    margin: 0;
    color: var(--text-0);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  .case-study-card__tagline {
    margin: 0;
    color: var(--text-1);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  /* ---------------------------------------------------------------------- */
  /* Stack list                                                              */
  /* ---------------------------------------------------------------------- */

  .case-study-card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    /* margin-top auto ancla badges + CTA al fondo → las tres cards alinean. */
    margin: auto 0 0;
    padding: 0;
  }

  /* ---------------------------------------------------------------------- */
  /* Animations                                                              */
  /* ---------------------------------------------------------------------- */

  @keyframes case-study-card-conic-rotate {
    /* Anima el `from` del conic vía @property registrada arriba.
       Velocidad lenta (6s) + opacity baja (0.6) → "sutil" (DESIGN.md §8).
       motion.css colapsa la duración a ~0 cuando reduced-motion. */
    from {
      --case-study-conic-angle: 180deg;
    }
    to {
      --case-study-conic-angle: 540deg;
    }
  }
</style>
