---
/**
 * TableOfContents.astro — sticky TOC for case studies and posts (T-24).
 *
 * Renders a navigable table of contents from a flat list of headings (the
 * shape produced by Astro's `getHeadings()` helper on MDX entries) and
 * powers two client behaviours:
 *
 * 1. **Scroll-spy** via `IntersectionObserver` on the actual `<h2>`/`<h3>`
 *    elements inside `<main>`. The link whose target is the heading closest
 *    to the top of the viewport gets `aria-current="true"` (consumed by CSS
 *    to highlight in `--accent-400`).
 * 2. **Smooth anchor scroll** on click, honouring `prefers-reduced-motion`
 *    (which falls back to `behavior: "auto"`).
 *
 * Layout strategy:
 * - Desktop (≥lg, 1024px): rendered as `<aside>` with `position: sticky;
 *   top: 96px;` so the TOC stays in view as the article scrolls. Hidden
 *   below `lg` to avoid cramping the prose column on tablet/mobile.
 * - Mobile (<lg): rendered as a collapsible `<details>` element so the
 *   reader can opt-in to the outline without losing vertical space. Native
 *   `<details>` is keyboard-accessible out of the box.
 *
 * Visual / type spec (DESIGN.md §2 + §4):
 * - Inter, `--text-sm` (14px).
 * - Idle: `--text-3` (#6a6a78). Hover: `--text-1`. Active (`aria-current`):
 *   `--accent-400`. Border-left 1px on the list as a vertical rail.
 * - Indent per heading depth: `margin-left: calc((depth - minDepth) * 16px)`
 *   so an `h3` sits 16px deeper than its parent `h2` (matches T-24 Done).
 *
 * Filtering:
 * - Headings are kept only when `minDepth ≤ depth ≤ maxDepth`.
 * - Defaults: `minDepth=2` (h2), `maxDepth=3` (h3) — case studies and posts
 *   rarely benefit from h4+ in the TOC and h1 is the page title.
 * - Component renders nothing if no heading falls in range (avoids an empty
 *   sticky aside on short articles).
 *
 * Spec: TASKS.md T-24 + DESIGN.md §1, §2, §4, §6.
 */
import { useTranslations } from '../../i18n/helpers';
import type { Language } from '../../i18n/ui';

export interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  lang: Language;
  /** Inclusive lower bound on heading depth (default 2 = h2). */
  minDepth?: number;
  /** Inclusive upper bound on heading depth (default 3 = h3). */
  maxDepth?: number;
}

const { headings, lang, minDepth = 2, maxDepth = 3 } = Astro.props;

const t = useTranslations(lang);
const label = t('toc.label');

// Filter the flat list to the configured depth window. We keep the order as
// received from `getHeadings()` since it already reflects document order.
const visible: Heading[] = headings.filter(
  (h: Heading) => h.depth >= minDepth && h.depth <= maxDepth,
);

// `aria-label` for the <nav> region. Translated copy keeps the screen reader
// announcement tight ("Contenido" / "Contents" — same as visible label).
const navAriaLabel = label;
---

{
  visible.length > 0 && (
    <aside
      class="toc"
      data-toc
      data-min-depth={String(minDepth)}
      data-max-depth={String(maxDepth)}
    >
      {/* Desktop: visible heading + sticky list. Mobile: collapsible details. */}
      <details class="toc__details" open>
        <summary class="toc__label">{label}</summary>
        <nav class="toc__nav" aria-label={navAriaLabel}>
          <ul class="toc__list" role="list">
            {visible.map((heading: Heading) => (
              <li
                class="toc__item"
                style={`--depth: ${heading.depth - minDepth};`}
              >
                <a class="toc__link" href={`#${heading.slug}`} data-toc-link>
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </aside>
  )
}

<style>
  .toc {
    /* Typography baseline (DESIGN.md §4 — UI is Inter, never serif). */
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--color-text-3);
  }

  /* ------------------------------------------------------------------ */
  /* Desktop (≥lg): sticky aside, label visible inline above the list.  */
  /* ------------------------------------------------------------------ */
  @media (min-width: 1024px) {
    .toc {
      position: sticky;
      top: 96px;
      align-self: start;
      max-height: calc(100vh - 96px - 1.5rem);
      overflow-y: auto;
    }

    /* Neutralise the native <details> chrome on desktop — the disclosure
       UX only makes sense on narrow viewports. */
    .toc__details {
      /* Remove the default marker arrow. */
    }

    .toc__details > .toc__label {
      cursor: default;
      list-style: none;
    }

    .toc__details > .toc__label::-webkit-details-marker {
      display: none;
    }

    .toc__details > .toc__label::marker {
      content: '';
    }
  }

  /* ------------------------------------------------------------------ */
  /* Mobile (<lg): collapsible <details>. Summary is the affordance.    */
  /* ------------------------------------------------------------------ */
  @media (max-width: 1023.98px) {
    .toc__details > .toc__label {
      cursor: pointer;
      list-style: none;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0;
    }

    .toc__details > .toc__label::-webkit-details-marker {
      display: none;
    }

    .toc__details > .toc__label::marker {
      content: '';
    }

    /* Custom disclosure indicator — rotates when open. */
    .toc__details > .toc__label::after {
      content: '';
      width: 0.5rem;
      height: 0.5rem;
      margin-inline-start: auto;
      border-right: 1px solid currentColor;
      border-bottom: 1px solid currentColor;
      transform: rotate(45deg) translate(-2px, -2px);
      transition: transform var(--motion-duration-fast, 150ms) var(--motion-ease-out, ease-out);
    }

    .toc__details[open] > .toc__label::after {
      transform: rotate(-135deg) translate(-2px, -2px);
    }
  }

  .toc__label {
    /* Eyebrow-style label — matches DESIGN.md §8 anchor for small caps cues. */
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-2);
    margin-block-end: 0.75rem;
  }

  .toc__nav {
    /* Container for the indented list. */
  }

  .toc__list {
    /* Border-left as a vertical rail — DESIGN.md visual signal request. */
    border-left: 1px solid var(--color-border);
    padding-inline-start: 0;
    list-style: none;
  }

  .toc__item {
    /* Indent visual according to depth. `--depth` is set inline per <li>. */
    margin-inline-start: calc(var(--depth, 0) * 16px);
  }

  .toc__link {
    display: block;
    padding: 0.25rem 0.75rem;
    color: var(--color-text-3);
    text-decoration: none;
    border-left: 2px solid transparent;
    margin-inline-start: -1px; /* overlap parent border for active accent */
    transition:
      color var(--motion-duration-fast, 150ms) var(--motion-ease-out, ease-out),
      border-color var(--motion-duration-fast, 150ms) var(--motion-ease-out, ease-out);
  }

  .toc__link:hover {
    color: var(--color-text-1);
  }

  .toc__link:focus-visible {
    outline: 2px solid var(--color-accent-400);
    outline-offset: 2px;
    border-radius: var(--radius-xs);
  }

  .toc__link[aria-current='true'] {
    color: var(--color-accent-400);
    border-left-color: var(--color-accent-400);
  }
</style>

<script>
  /**
   * TOC client behaviour:
   * 1. Scroll-spy via IntersectionObserver over `main h2, main h3`.
   * 2. Smooth click-to-scroll honouring `prefers-reduced-motion`.
   *
   * Re-runs on `astro:page-load` so View Transitions navigations rebind.
   */
  type SpiedTOC = HTMLElement & { __tocCleanup?: () => void };

  function setupTOC() {
    const tocs = document.querySelectorAll<SpiedTOC>('[data-toc]');
    if (tocs.length === 0) return;

    const main = document.querySelector('main');
    if (!main) return;

    const reduceMotion =
      typeof window !== 'undefined' &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    tocs.forEach((toc) => {
      // Avoid double-binding on re-runs (astro:page-load).
      toc.__tocCleanup?.();

      const minDepth = Number(toc.dataset.minDepth) || 2;
      const maxDepth = Number(toc.dataset.maxDepth) || 3;
      const selector = Array.from({ length: maxDepth - minDepth + 1 }, (_, i) => `h${minDepth + i}`)
        .map((tag) => `${tag}[id]`)
        .join(', ');

      const headings = Array.from(main.querySelectorAll<HTMLElement>(selector));
      const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
      if (headings.length === 0 || links.length === 0) return;

      function setActive(slug: string | null) {
        for (const link of links) {
          const id = link.getAttribute('href')?.slice(1);
          if (id && id === slug) {
            link.setAttribute('aria-current', 'true');
          } else {
            link.removeAttribute('aria-current');
          }
        }
      }

      // Track which headings are currently intersecting; pick the one closest
      // to the top of the viewport as the "current" section.
      const visible = new Set<HTMLElement>();
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) visible.add(entry.target as HTMLElement);
            else visible.delete(entry.target as HTMLElement);
          }
          // Sort visible headings by document order and pick the first.
          const ordered = Array.from(visible).sort(
            (a, b) => headings.indexOf(a) - headings.indexOf(b),
          );
          setActive(ordered[0]?.id ?? null);
        },
        { rootMargin: '-96px 0px -60% 0px', threshold: [0, 1] },
      );
      headings.forEach((h) => observer.observe(h));

      // Smooth scroll on click (skip when prefers-reduced-motion).
      const onClick = (event: MouseEvent) => {
        const target = event.target as HTMLElement | null;
        const link = target?.closest<HTMLAnchorElement>('[data-toc-link]');
        if (!link) return;
        const id = link.getAttribute('href')?.slice(1);
        if (!id) return;
        const heading = document.getElementById(id);
        if (!heading) return;
        event.preventDefault();
        heading.scrollIntoView({
          behavior: reduceMotion ? 'auto' : 'smooth',
          block: 'start',
        });
        // Update hash without a jump — `scrollIntoView` already moved.
        if (typeof history.replaceState === 'function') {
          history.replaceState(null, '', `#${id}`);
        }
        setActive(id);
      };
      toc.addEventListener('click', onClick);

      toc.__tocCleanup = () => {
        observer.disconnect();
        toc.removeEventListener('click', onClick);
        delete toc.__tocCleanup;
      };
    });
  }

  setupTOC();
  document.addEventListener('astro:page-load', setupTOC);
</script>