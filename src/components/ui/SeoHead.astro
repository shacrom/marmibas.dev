---
/**
 * SeoHead — head metadata for every page (T-16 + T-50).
 *
 * Inyects:
 *   - Document basics: charset, viewport, title, description, theme-color.
 *   - Robots directive (index/noindex).
 *   - Canonical URL (built from `currentUrl` against `PUBLIC_SITE_URL`).
 *   - hreflang alternates: `es`, `x-default` → ES (the only published locale).
 *   - Open Graph: og:title, og:description, og:type, og:url, og:image, og:locale.
 *   - Twitter Card: summary_large_image with title/description/image.
 *   - Critical font preloads (Space Mono 700 + IBM Plex Mono 400) from `lib/fonts.ts`.
 *   - JSON-LD structured data (T-50, extended for the services mosaic S2):
 *       · `Person` schema on the home (auto-detected via pathname).
 *       · `Article` schema when `type === 'article'` (case studies).
 *       · `ItemList` of `Service` items on `/servicios` (the mosaic index) —
 *         replaces the `Service` schema the 7 per-service detail pages used
 *         to emit individually before they were folded into the mosaic.
 *
 * Title strategy:
 *   - `title` is the page-specific title.
 *   - We prefix with `marmibas — ` if the title does not already contain
 *     "marmibas" (case-insensitive). This keeps the home title intact
 *     ("marmibas — Ingeniero …") while wrapping pages like "Trabajos"
 *     into "marmibas — Trabajos".
 *
 * JSON-LD strategy (T-50):
 *   - Home: emit `Person` with name, jobTitle, url, sameAs, knowsAbout. The
 *     home is detected from the canonical pathname (`/`, the only public
 *     locale). This avoids leaking the schema on subpaths.
 *   - `/servicios`: emit an `ItemList` of `Service` `ListItem`s, one per
 *     `spanishServices` entry, each `item.url` pointing at that service's
 *     drawer hash (`<canonical>#<slug>`) — the mosaic's own deep-link
 *     target. Detected from the normalized pathname (trailing slash
 *     stripped) so it fires regardless of how the route resolves.
 *   - Article: emit `Article` when the caller passes `type='article'`. Caller
 *     supplies optional `publishedAt` / `updatedAt` / `tags` / `author`; the
 *     component derives sensible defaults (author = "marmibas") and falls
 *     back to omitting individual fields when no data is available.
 *   - The script is rendered as
 *       `<script type="application/ld+json" set:html={JSON.stringify(data)}>`
 *     only when `structuredData` is truthy — pages without an explicit schema
 *     do not add an empty tag.
 */

import { CRITICAL_FONT_PRELOADS } from '../../lib/fonts';
import { getCanonicalUrl } from '../../i18n/helpers';
import { absoluteUrl } from '../../lib/seo';
import { isSpanishServicePath, spanishServices } from '../../lib/services';
import type { Language } from '../../i18n/ui';

interface Props {
  /** Page-specific title; will be prefixed with "marmibas — " when missing. */
  title: string;
  /** Meta description (~155 chars). Used for SEO snippet + og:description. */
  description: string;
  /** Active language of the page. Drives og:locale + hreflang current. */
  lang: Language;
  /** Astro.url of the current request (for canonical + alternates). */
  currentUrl: URL;
  /**
   * Absolute URL to the OG image (1200x630). Defaults to the site-wide
   * fallback `/og/default.png` (created in T-51).
   */
  ogImage?: string;
  /** When true, keep the page out of search results. */
  noindex?: boolean;
  /** Prevent link crawling only for error or genuinely private pages. */
  nofollow?: boolean;
  /** OpenGraph type. `website` for index pages, `article` for posts. */
  type?: 'website' | 'article';
  /**
   * ISO date or Date for `Article.datePublished`. Optional — when absent we
   * skip the field rather than emitting a fake date.
   */
  publishedAt?: string | Date;
  /** ISO date or Date for `Article.dateModified`. Optional. */
  updatedAt?: string | Date;
  /** Author name override. Defaults to "marmibas". */
  author?: string;
  /** Free-form tags emitted as `Article.keywords`. Optional. */
  tags?: string[];
  /**
   * FAQ entries to emit as a Schema.org `FAQPage` JSON-LD block.
   *
   * When present and non-empty, the schema is rendered as a SECOND
   * `<script type="application/ld+json">` (after Person/Article). Google
   * supports multiple JSON-LD scripts on the same page, and the FAQPage
   * schema is the prerequisite for FAQ-rich-result featured snippets and
   * "People Also Ask" appearances on SERP.
   */
  faqs?: { question: string; answer: string }[];
}

const {
  title,
  description,
  lang,
  currentUrl,
  ogImage = '/og/default.png',
  noindex = false,
  nofollow = false,
  type = 'website',
  publishedAt,
  updatedAt,
  author = 'marmibas',
  tags,
  faqs,
} = Astro.props;

// --- Title prefix ---------------------------------------------------------
// Avoid duplicating the brand if a page already includes it.
const fullTitle = /marmibas/i.test(title) ? title : `marmibas — ${title}`;

// --- Canonical + alternates ----------------------------------------------
const canonicalUrl = getCanonicalUrl(currentUrl);

const siteOrigin = new URL(canonicalUrl).origin;

// --- og:image absolutisation ---------------------------------------------
// OG/Twitter image MUST be an absolute URL (Facebook + most crawlers reject
// relative paths). If the prop already starts with http(s), keep it; else
// prefix with the canonical origin.
const ogImageAbsolute = absoluteUrl(ogImage, siteOrigin);

// --- og:locale -----------------------------------------------------------
// OpenGraph expects `xx_XX` (BCP-47 with underscore). ES is the only
// published locale, matching the sitemap config in astro.config.mjs.
const ogLocale = 'es_ES';

// --- JSON-LD structured data (T-50) --------------------------------------
// Detect the home: exactly `/` (the only public locale). Anything else
// (e.g. `/trabajos`, `/case-studies/voxye`) falls through to the Article
// branch (when `type === 'article'`) or to no structured data at all for
// generic landing pages.
const pathname = currentUrl.pathname;
const isHome =
  pathname === '/' ||
  // Tolerate trailing-slash variants of the ES home produced by some adapters.
  pathname === '';

// Normalized pathname (no trailing slash, `/` stays `/`) — used to detect
// the services mosaic index regardless of trailing-slash rendering.
const normalizedPath = pathname.replace(/\/$/, '') || '/';
const isServicesIndex = normalizedPath === '/servicios';

/** Coerce a Date | ISO-string | undefined to an ISO 8601 string (or undefined). */
function toIso(value: string | Date | undefined): string | undefined {
  if (value === undefined) return undefined;
  if (value instanceof Date) return value.toISOString();
  // Pre-formatted ISO strings pass through; anything else returns undefined
  // so we don't emit invalid `datePublished`/`dateModified` values.
  const parsed = new Date(value);
  return Number.isNaN(parsed.getTime()) ? undefined : parsed.toISOString();
}

// Person schema for the home page. Mirrors the brand and the canonical
// "What I work with" set used across the site (DESIGN.md + content). The
// `sameAs` array is the public proof — keep it conservative; placing
// throwaway/personal links here weakens the schema's trust signal.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Marcos Miguel Báscones',
  alternateName: ['marmibas', 'shacrom'],
  jobTitle: 'Software Engineer',
  url: 'https://marmibas.dev',
  sameAs: [
    'https://github.com/shacrom',
    'https://www.linkedin.com/in/marcos-miguel-b%C3%A1scones-91669b205/',
  ],
  knowsAbout: [
    'Astro',
    'Angular',
    'TypeScript',
    'Spring Boot',
    'Java',
    'Supabase',
    'PostgreSQL',
    'Tailwind CSS',
    'Vercel',
    'Web performance',
    'i18n',
    'Accessibility',
  ],
};

// Article schema: emitted whenever the page is an article (case study or
// post). Optional fields are only included when the caller supplies them so
// the rendered JSON stays minimal and accurate.
//
// `mainEntityOfPage` lets crawlers anchor the schema to the canonical URL,
// which is recommended for Article-typed schemas per Google's guidelines.
const datePublishedIso = toIso(publishedAt);
const dateModifiedIso = toIso(updatedAt) ?? datePublishedIso;

interface ArticleSchema {
  '@context': 'https://schema.org';
  '@type': 'Article';
  headline: string;
  description: string;
  inLanguage: string;
  url: string;
  mainEntityOfPage: { '@type': 'WebPage'; '@id': string };
  image: string;
  author: { '@type': 'Person'; name: string; url: string };
  publisher: { '@type': 'Person'; name: string; url: string };
  datePublished?: string;
  dateModified?: string;
  keywords?: string;
}

const articleSchema: ArticleSchema | undefined =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        description,
        inLanguage: 'es-ES',
        url: canonicalUrl,
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
        image: ogImageAbsolute,
        author: { '@type': 'Person', name: author, url: 'https://marmibas.dev' },
        publisher: { '@type': 'Person', name: 'marmibas', url: 'https://marmibas.dev' },
        ...(datePublishedIso ? { datePublished: datePublishedIso } : {}),
        ...(dateModifiedIso ? { dateModified: dateModifiedIso } : {}),
        ...(tags && tags.length > 0 ? { keywords: tags.join(', ') } : {}),
      }
    : undefined;

const serviceSchema = isSpanishServicePath(pathname)
  ? {
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: title.replace(/\s*\|\s*marmibas\.dev$/i, ''),
      description,
      url: canonicalUrl,
      provider: {
        '@type': 'Person',
        name: 'Marcos Miguel Báscones',
        alternateName: 'marmibas',
        url: siteOrigin,
      },
      inLanguage: 'es-ES',
    }
  : undefined;

// ItemList of Service ListItems for the /servicios mosaic — the structured-
// data replacement for the Service schema the 7 detail pages used to emit
// individually (see serviceSchema above; still active for those pages until
// they are removed). Each item's `url` points at the mosaic's own drawer
// deep link (`<canonical>#<slug>`) rather than a page that no longer exists.
const servicesCatalogSchema = isServicesIndex
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: title.replace(/\s*\|\s*marmibas\.dev$/i, ''),
      itemListElement: spanishServices.map((service, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'Service',
          name: service.title,
          description: service.description,
          url: `${canonicalUrl}#${service.slug}`,
          provider: {
            '@type': 'Person',
            name: 'Marcos Miguel Báscones',
            alternateName: 'marmibas',
            url: siteOrigin,
          },
          inLanguage: 'es-ES',
        },
      })),
    }
  : undefined;

// Resolve the actual schema object to inject. Article wins over Person when
// a page is somehow both home and an article (defensive — should not happen
// in practice). We prefer to emit at most ONE primary JSON-LD block per
// page to keep the head light and the structured-data validator unambiguous.
const structuredData: object | undefined =
  articleSchema ?? servicesCatalogSchema ?? serviceSchema ?? (isHome ? personSchema : undefined);

// FAQPage schema: emitted as a SECONDARY JSON-LD block when the page declares
// FAQ entries (today: home only). Google explicitly allows multiple JSON-LD
// scripts on the same page, and the FAQPage schema is the prerequisite for
// FAQ-rich-result snippets / People-Also-Ask SERP enrichment.
const faqSchema =
  faqs && faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((faq) => ({
          '@type': 'Question',
          name: faq.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: faq.answer,
          },
        })),
      }
    : undefined;
---

{/* --- Document basics ----------------------------------------------- */}
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#08070b" />
<meta name="color-scheme" content="dark" />
<meta name="generator" content={Astro.generator} />

{/* --- Indexing ------------------------------------------------------ */}
<meta
  name="robots"
  content={noindex ? `noindex, ${nofollow ? 'nofollow' : 'follow'}` : 'index, follow'}
/>

{/* --- Canonical ----------------------------------------------------- */}
<link rel="canonical" href={canonicalUrl} />

{/* ES is the only published locale — emit its own hreflang + x-default. */}
{
  !noindex && lang === 'es' && (
    <>
      <link rel="alternate" hreflang="es" href={canonicalUrl} />
      <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    </>
  )
}

{/* --- Open Graph ---------------------------------------------------- */}
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageAbsolute} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="marmibas.dev" />
<meta property="og:locale" content={ogLocale} />

{/* --- Twitter Card -------------------------------------------------- */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageAbsolute} />

{/* --- Critical font preloads (Space Mono 700 + IBM Plex Mono 400) --- */}
{
  CRITICAL_FONT_PRELOADS.map((font) => (
    <link rel="preload" href={font.href} as="font" type={font.type} crossorigin="anonymous" />
  ))
}

{/* --- Favicon ------------------------------------------------------- */}
{
  /*
   * favicon.svg is delivered by T-51. We declare the link now so it lights up
   * automatically once that asset lands (Astro will return 404 in dev for the
   * missing path, but the browser silently ignores it — no visual impact).
   */
}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

{/* --- JSON-LD structured data (T-50) ------------------------------- */}
{
  /*
   * Emit at most one schema per page (Person on home, Article elsewhere).
   * Astro's `set:html` writes the JSON literally, bypassing the implicit
   * HTML-entity escaping that would otherwise corrupt the JSON payload
   * (e.g. encoding `"` as `&quot;` and breaking parsers).
   */
}
{
  structuredData && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  )
}

{/* --- JSON-LD FAQPage (optional secondary block) ------------------ */}
{
  /*
   * Emitted as an independent script when `faqs` is provided. Google supports
   * multiple JSON-LD blocks per page (one for the primary entity, additional
   * ones for supplementary structured data such as FAQPage / BreadcrumbList).
   */
}
{faqSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
